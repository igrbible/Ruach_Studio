 tools/console/app.js               |  2 +-
 tools/console/heresy-collection.js |  3 ++-
 tools/console/heresy-i18n-be.js    | 11 +++++++++++
 tools/console/heresy-i18n-el.js    | 11 +++++++++++
 tools/console/heresy-i18n-es.js    | 11 +++++++++++
