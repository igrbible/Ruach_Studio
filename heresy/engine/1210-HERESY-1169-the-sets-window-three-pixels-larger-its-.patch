diff --git a/tools/console/app.css b/tools/console/app.css
index c22def7..9d9cc8e 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -2608,6 +2608,14 @@ body.coll-dragging .coll-peek { display: none; }
 .hi-lora-k { min-width: 74px; font: 12px var(--mono); color: var(--muted); }
 .hi-lora-epoch .hi-ab { display: inline-flex; align-items: center; gap: 6px; }
 .hub-box { width: min(640px, 100%); }
+/* HERESY 1169 (Viktor 07.10.2026: «шрифт в попапе загрузчика, конечно, на 2-4 px крупнее надо было бы. Мы же для пользователей
+   делали эти сеты несколько суток»): the 💎 sets' window reads three pixels larger, and wider for it */
+.hub-box { width: min(720px, 100%); }
+.hub-box .hd-title { font-size: 19px; }
+.hub-box .hd-body { font-size: 16.5px; }
+.hub-box .hub-name { font-size: 17px; }
+.hub-box :is(.hub-facts, .hub-line, .row-hint) { font-size: 15px; }
+.hub-box .hub-row > .btn, .hub-box .hd-acts .btn { font-size: 14px; }
 .hub-list { display: flex; flex-direction: column; gap: 8px; max-height: min(60vh, 520px); overflow: auto; }
 .hub-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 3px 14px; padding: 10px 12px;
   background: var(--sunk); border: 1px solid var(--line-soft); border-radius: var(--r-md); }
diff --git a/tools/console/app.js b/tools/console/app.js
index 0aff6b3..ea77c79 100644
--- a/tools/console/app.js
+++ b/tools/console/app.js
@@ -974,7 +974,7 @@
     var songs = +$("versions").value || 1, sounds = +$("variations").value || 1, takes = songs * sounds;
     $("versionsOut").textContent = songs;
     $("variationsOut").textContent = sounds;
-    $("takesTotal").textContent = "= " + takes + (takes === 1 ? " take" : " takes");
+    $("takesTotal").textContent = takes + (takes === 1 ? " take" : " takes");   // the catalogs know «{0} takes»
   }
   ["versions", "variations"].forEach(function (id) { $(id).addEventListener("input", paintCounts); });
   paintCounts();
diff --git a/tools/console/heresy-collection.js b/tools/console/heresy-collection.js
index d874e51..f18df63 100644
--- a/tools/console/heresy-collection.js
+++ b/tools/console/heresy-collection.js
@@ -693,7 +693,8 @@
       '<div class="hd-body">The studio\'s approved sets, as their author published them. Each comes in as a workspace of its own, ' +
       "locked against deletion: its takes as MP3 with their covers, titles and notes. Only what you ask for is downloaded. " +
       // HERESY 1167 (Viktor: «дисклеймер по картинкам… сгенерированы нейросетью»)
-      "The covers are painted by an image model: some show an instrument not quite as it really is.</div>" +
+      // HERESY 1169: the styles' covers are their own scores (SheetSage2 heard each take), the instruments' still painted
+      "The instruments' covers are painted by an image model: some show an instrument not quite as it really is; the styles' covers are each take's own score.</div>" +
       '<div class="hub-list"><p class="row-hint">Asking Hugging Face…</p></div>' +
       '<div class="hd-acts"><button type="button" class="btn ghost small hub-close">Close</button></div></div>';
     document.body.appendChild(back);
