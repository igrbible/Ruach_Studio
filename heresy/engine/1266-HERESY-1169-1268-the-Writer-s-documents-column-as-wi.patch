diff --git a/tools/console/app.css b/tools/console/app.css
index 5796c76..2f155ea 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -2409,7 +2409,12 @@ body.coll-dragging .coll-peek { display: none; }
 
 /* HERESY 1047: the Writer's notebook */
 .wr-book { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 16px; align-items: start; margin-bottom: 22px; }
-@media (max-width: 1000px) { .wr-book { grid-template-columns: minmax(0, 1fr); } }
+/* HERESY 1268: the documents column as wide as its edge is dragged (the width kept in this browser) */
+.wr-book { grid-template-columns: var(--wr-side-w, 280px) 12px minmax(0, 1fr); column-gap: 4px; }
+.wr-resizer { align-self: stretch; min-height: 160px; display: flex; justify-content: center; cursor: col-resize; touch-action: none; outline: none; }
+.wr-resizer::before { content: ""; width: 2px; height: 100%; border-radius: 1px; background: transparent; transition: background .12s; }
+.wr-resizer:hover::before, .wr-resizer.is-drag::before, .wr-resizer:focus-visible::before { background: var(--line-strong-a); }
+@media (max-width: 1000px) { .wr-book { grid-template-columns: minmax(0, 1fr); } .wr-resizer { display: none; } }
 .wr-side { display: flex; flex-direction: column; gap: 8px; position: sticky; top: 8px; }
 .wr-side-bar { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
 .wr-side-bar .btn { white-space: nowrap; }   /* HERESY 1168: its buttons whole, a row more when they need it */
@@ -4631,7 +4636,7 @@ body:not([data-frame]) .frame-fs { display: none; }
 .hd-check.is-on .hd-item-ico { color: var(--amber); }
 
 /* HERESY 1169 · 1242: a LoRA strength over the pointer while it hovers or drags its slider (16 pt), framed in its zone's colour */
-.lora-vtip { position: fixed; z-index: 130; transform: translate(-50%, calc(-100% - 14px)); padding: 3px 10px; border: 2px solid var(--line-strong); border-radius: 6px; background: var(--panel); color: var(--ink); font: 600 16pt/1.25 var(--mono); white-space: nowrap; pointer-events: none; box-shadow: 0 4px 14px rgba(0, 0, 0, .18); }
+.lora-vtip { position: fixed; z-index: 130; transform: translate(-50%, calc(-100% - 14px)); padding: 3px 10px; border: 2px solid var(--line-strong); border-radius: 6px; background: var(--panel); color: var(--ink); font: 600 14pt/1.25 var(--mono); white-space: nowrap; pointer-events: none; box-shadow: 0 4px 14px rgba(0, 0, 0, .18); }
 .lora-vtip[hidden] { display: none; }
 .lora-vtip.is-green { border-color: #3f9a4a; }
 .lora-vtip.is-amber { border-color: #e0b030; }
@@ -4727,3 +4732,15 @@ body[data-tab="artist"] .col-grip.left { display: none; }
