 .ar-view .ar-vstar { font-size: 18px; }
+/* HERESY 1268 (Viktor 09.10.2026: «В узкой колонке в блоке Score кнопка full screen съезжает на новую строку. Можно уменьшить пустоту
+   между кнопкой ABC и Print»): the tools follow the tabs, the gaps halved: the full screen stays on the row */
+.score-head { gap: 6px; }
+.score-head > .spacer { flex: 0 0 8px; }
+/* HERESY 1268 (Viktor 09.10.2026: «прицепка смотрится ugly. Перенеси её на строку ниже и красиво отформатируй»): the document in
+   hand on a line of its own under the Writer's row, a chip: ✎ its name, ✕ to put it down */
+.wr-hand.is-on::after { content: ""; order: 2; flex-basis: 100%; height: 0; }
+.wr-hand.is-on .wr-hand-doc { order: 3; max-width: 100%; gap: 2px; padding: 1px 3px 1px 8px; border: 1px solid color-mix(in oklab, var(--amber) 35%, transparent);
+  border-radius: var(--r-pill, 999px); background: color-mix(in oklab, var(--amber) 6%, transparent); }
+.wr-hand-doc .wr-hand-name { padding: 2px; font-weight: 500; }
+.wr-hand-doc .wr-hand-x { padding: 2px 6px; border-radius: var(--r-pill, 999px); line-height: 1; }
+.wr-hand-doc .wr-hand-x:hover { color: var(--ink); background: color-mix(in oklab, var(--amber) 14%, transparent); }
