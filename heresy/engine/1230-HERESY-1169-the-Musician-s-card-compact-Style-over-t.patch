--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -4442,3 +4442,41 @@ body[data-frame] :is(#view-compose, #view-take) { scrollbar-gutter: stable; }
 /* HERESY 1169: the lyrics editor's keys: the meter's «Keys» (a press opens the guide there), the Writer's label says them too */
 .lyr-tog.lyr-keys { font-family: var(--mono); }
 .lyr-keys-at { cursor: help; }
+/* HERESY 1169 (Viktor 08.10.2026: «Instrumental… в ту же строку, что и Planning Mode заголовок с подсказкой, - выключка вправо…
+   Planning Mode строку и само название секции - красиво в общем стиле с паддингами»): the planning head a row of its own */
+.plan-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 2px 2px 9px; margin-bottom: 10px;
+  border-bottom: 1px solid var(--line-a); }
+.plan-head > .label { margin: 0; }
+.plan-head .instrumental-check { margin: 0; flex: none; }
+/* «Блок с обеими SEEDs… в блок Sampling and Denoising»: the seeds the drawer's first part */
+.seed-sub { margin-bottom: 16px; }
+/* «Секции кнопок под DOWNLOADS, MAKE AGAIN, REFINER определи в собственные обрамлённые приятные в UIX блоки»: each group framed,
+   its name on top; Make again, the largest, a row of its own under the others */
+.take-tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; align-items: stretch; }
+.take-tools .tool-group { display: flex; flex-direction: column; gap: 8px; min-width: 0; padding: 9px 11px 11px; border: 1px solid var(--line-a);
+  border-radius: var(--r-md); background: color-mix(in srgb, var(--ink) 3%, transparent); }
+.take-tools .tool-group.tg-dl { order: 1; }
+.take-tools .tool-group.tg-refine { order: 2; }
+.take-tools .tool-group.tg-files { order: 3; }
+.take-tools .tool-group.tg-again { order: 4; grid-column: 1 / -1; }
+.take-tools .tool-cap { display: block; margin: 0; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
+.take-tools .tool-row { display: flex; flex-wrap: wrap; gap: 6px; }
+/* «обрезанный параграф объяснений… нахер там не нужен»: the LoRA picker's notes in a tip beside the LoRAs' name */
+.lora-hint { display: none; }
+.lora-notes { display: inline-grid; place-items: center; width: 16px; height: 16px; margin-left: 6px; border: 1px solid var(--line-strong-a);
+  border-radius: 50%; font: 700 10px/1 var(--mono); color: var(--muted); text-transform: none; letter-spacing: 0; cursor: help; vertical-align: middle; }
+.lora-notes.is-warn { color: #d9a441; border-color: #d9a441; }
+.lora-notes[hidden] { display: none; }
+/* «ещё один оверлей поверх оверлея!… поверх всего где-то 60% ширины экрана, и шрифт автоматом на 10% крупнее»: the lyrics over
+   everything (app.js lyricsOver moves the box there and back) */
+.lyr-big { margin-left: 6px; vertical-align: middle; }
+.lyr-over { position: fixed; left: 0; right: 0; top: 0; bottom: var(--playbar-h); z-index: 40; display: flex; align-items: center; justify-content: center;
+  background: color-mix(in srgb, var(--ground) 45%, rgba(0, 0, 0, .55)); backdrop-filter: blur(3px); }
+.lyr-over-box { zoom: 1.1; width: calc(60vw / 1.1); height: calc((100vh - var(--playbar-h)) * .94 / 1.1); display: flex; flex-direction: column; gap: 8px;
+  padding: 12px 16px 14px; border: 1px solid var(--line-strong-a); border-radius: var(--r-lg); background: var(--panel); box-shadow: 0 24px 80px var(--shadow-lg); }
+.lyr-over-head { display: flex; align-items: center; gap: 8px; font: 600 15px/1.3 var(--heading); }
+.lyr-over-body { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 8px; }
+.lyr-over-body > .lyr-wrap { flex: 1; min-height: 0; }
+.lyr-over-body #lyrics { height: 100% !important; max-height: none; resize: none; overflow-y: auto; }
+/* HERESY 1169 (Viktor 08.10.2026: «Хедер Takes имеет дохера паддинга сверху. 5-8px?»): the Creator's takes head 7 px nearer its top (18 → 11) */
+body[data-tab="create"] #library .lib-head { padding-top: 11px; }
