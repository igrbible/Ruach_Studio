 .coll-play.is-playing { color: var(--amber-hi); }
 
+/* HERESY 1159: a card dragged onto a workspace on the left (asked first) */
+.coll-card[draggable="true"] { -webkit-user-drag: element; }
+.coll-place.is-drop { outline: 2px dashed var(--amber); outline-offset: -2px; background: color-mix(in srgb, var(--amber) 14%, transparent); }
+.coll-drag-ghost { position: fixed; left: -1000px; top: -1000px; max-width: 320px; padding: 6px 12px; border-radius: var(--r-pill);
+  background: var(--amber); color: var(--panel); font: 600 13px/1.3 var(--sans); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+body.coll-dragging .coll-peek { display: none; }
+
 /* HERESY 1046: peek and sheet in the Collection */
 .coll-peek { position: fixed; z-index: 50; width: 380px; max-height: 420px; overflow: hidden; padding: 12px 14px; border: 1px solid var(--line-strong-a);
   border-radius: var(--r-md); background: var(--panel); box-shadow: 0 10px 30px var(--shadow-lg); pointer-events: none; font-size: 12.5px; }
