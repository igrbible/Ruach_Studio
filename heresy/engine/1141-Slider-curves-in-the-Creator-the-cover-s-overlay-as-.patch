+  $("sliderActive").addEventListener("pointerdown", function (event) {
+    var pt = event.target.closest(".curve-pt"), svg = pt && pt.ownerSVGElement, choice = svg && choiceOf(svg.dataset.curveGraph);
+    if (!choice || !choice.curve) return;
