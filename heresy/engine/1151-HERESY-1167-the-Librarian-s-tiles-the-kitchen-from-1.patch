 }
+
+/* HERESY 1167 (Viktor 05.10.2026: «У нас наш лимит в 80 символов не вмещается полностью в карточке. Что если заголовок
+   трека полностью, с самого начала строки, а PLAY кнопку опустить на строку ниже?»): in the tiles the title takes the
+   card's first line(s) whole, from its very start, as long as it is (80 characters at most); ▶ goes a line down, beside
+   the time and the badges; the check box stays under it, on the likes' line, and that line keeps to the card's foot */
+.coll-grid:not(.list) .coll-card { display: grid; grid-template-columns: 30px minmax(0, 1fr); grid-template-rows: auto auto 1fr auto;
+  grid-template-areas: "title title" "play meta" "play badges" "check acts"; column-gap: 8px; row-gap: 3px; }
+.coll-grid:not(.list) .coll-body { display: contents; }
+.coll-grid:not(.list) .coll-title { grid-area: title; align-items: flex-start; }
+.coll-grid:not(.list) .coll-title-text { white-space: normal; overflow: visible; text-overflow: clip; overflow-wrap: anywhere; }
+.coll-grid:not(.list) .coll-play { grid-area: play; align-self: start; }
+.coll-grid:not(.list) .coll-meta { grid-area: meta; align-self: center; }
+.coll-grid:not(.list) .coll-badges { grid-area: badges; align-self: start; margin-top: 1px; }
+.coll-grid:not(.list) .coll-check { grid-area: check; }
+.coll-grid:not(.list) .coll-acts { grid-area: acts; }
+.coll-grid:not(.list) .coll-card.has-art .coll-title, .coll-grid:not(.list) .coll-card.has-art .coll-meta,
+.coll-grid:not(.list) .coll-card.has-art .coll-badges { padding-right: 54px; }
+/* HERESY 1167 (Viktor: «в дефолтном разрешении 1080p не 4 колонки, а 3, и при схлопнутой левой колонке в Коллекциях 4. Так
+   больше воздуха для карточек»): from 1401 to 2199 px three tiles a row, four with the workspaces folded; 2K keeps its
+   four and five, and the steps past it stay */
+@media (min-width: 1401px) and (max-width: 2199px) {
+  .coll-grid.tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+  .coll-layout.is-folded .coll-grid.tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
+/* HERESY 1167 (Viktor: «в пометках regen сделай тоньше обводку и радиус углов мелкий 2px»): the regen badge's dashed edge was
+   the browser's medium (3 px: no width was given) on a pill */
+.coll-badge.rg { border: 1px dashed currentColor; border-radius: 2px; padding: 0 6px; }
+
+/* HERESY 1167 (Viktor 05.10.2026: «Когда редженится карточка, можешь добавить ей 60% полупрозрачности и вибрацию до 75%
+   полупрозрачности?»): a take being made again breathes between 60 % and 75 % till the new one lands */
+@keyframes regen-breathe { from { opacity: .6; } to { opacity: .75; } }
+.coll-card.is-regenerating, .take.is-regenerating { opacity: .6; animation: regen-breathe 1.1s ease-in-out infinite alternate; }
+@media (prefers-reduced-motion: reduce) { .coll-card.is-regenerating, .take.is-regenerating { animation: none; } }
