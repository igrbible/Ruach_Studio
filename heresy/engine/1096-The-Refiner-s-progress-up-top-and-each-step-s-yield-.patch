@@ -3165,3 +3165,41 @@ input[type="search"]::-webkit-search-cancel-button { cursor: pointer; }
 /* HERESY 1128: the datasheet's sliders and LoRAs: a long name wraps, its strength stays on the right */
 .ds-kv-long span { min-width: 0; overflow-wrap: anywhere; }
 .ds-kv-long b { flex: none; white-space: nowrap; }
+
+/* ---------------------------------------------------------------- HERESY 1129: the Refiner's progress up top; each step's yield
+   The room's head names what runs (always in sight); the step's own block carries it at its top; its tab beats. */
+.post-live { margin-left: auto; display: flex; flex-direction: column; gap: 4px; min-width: 260px; max-width: 420px; align-self: center; }
+.post-live[hidden], .dv-live[hidden] { display: none; }
+.dv-live { display: flex; flex-direction: column; gap: 6px; margin: 0 0 10px; padding: 8px 10px; border-radius: var(--r-md);
+  background: color-mix(in oklab, var(--amber) 7%, transparent); border: 1px solid var(--amber-a); }
+.dv-live-row .job-bar, .post-live .job-bar { margin-top: 4px; }
+.dv-live-head { display: flex; justify-content: space-between; gap: 10px; font-size: 12.5px; }
+.dv-live-head span { color: var(--muted); font-size: 12px; font-family: var(--mono); }
+.dv-live-row.is-failed .dv-live-head span { color: var(--bad); font-family: inherit; }
+.post-live .dv-live-head { font-size: 12px; }
+#postSteps .ps-step.is-running .ps-mark { position: relative; }
+#postSteps .ps-step.is-running .ps-mark::after { content: ""; position: absolute; top: -3px; right: -3px; width: 8px; height: 8px; border-radius: 50%;
+  background: var(--amber); animation: status-pulse 1.2s ease-in-out infinite; }
+.dv-made { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 0 0 10px; }
+.dv-made:empty { display: none; }
+.dv-made-cap { font: 600 10.5px/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--dim); margin-right: 2px; }
+.dv-made-none { font-size: 12px; color: var(--dim); }
+.dv-chip { padding: 3px 9px; border-radius: 999px; border: 1px solid var(--amber-a); background: color-mix(in oklab, var(--amber) 6%, transparent);
+  color: var(--ink); font-size: 12px; cursor: pointer; }
+.dv-chip:hover { background: color-mix(in oklab, var(--amber) 14%, transparent); }
+/* the tree: the step open lights its branches; a chip under the pointer lights its own; a click flashes it */
+#derivedTree .dv-group { transition: background .2s ease, box-shadow .2s ease; }
+#derivedTree[data-lit="stems"] .dv-group[data-kind="stems"], #derivedTree[data-lit="remaster"] .dv-group[data-kind="remaster"],
+#derivedTree[data-lit="upscale"] .dv-group[data-kind="upscale"], #derivedTree[data-lit="debuzz"] .dv-group[data-kind="debuzz"],
+#derivedTree .dv-group.is-lit { background: color-mix(in oklab, var(--amber) 6%, transparent); box-shadow: inset 3px 0 0 var(--amber-a); border-radius: var(--r-sm); }
+#derivedTree .dv-group.is-flash { animation: dv-flash 1.6s ease-out; }
+@keyframes dv-flash { 0%, 30% { background: color-mix(in oklab, var(--amber) 22%, transparent); } 100% { background: transparent; } }
+
+/* HERESY 1132: the Refiner's own toggle in the Takes column (Refined / every take), shown in the Refiner only */
+.lib-refined { display: none; }
+body[data-tab="post"] .lib-refined { display: inline-flex; }
+
+/* HERESY 1131: the datasheet's score, open */
+.ds-staff:empty { display: none; }
+.ds-score-say { font-style: normal; text-transform: none; letter-spacing: 0; color: var(--dim); margin-left: 6px; }
+.ds-noscore { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 2px 0 6px; }
