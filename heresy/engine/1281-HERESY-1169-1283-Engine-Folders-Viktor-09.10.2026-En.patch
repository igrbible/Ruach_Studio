+.pl-row { display: grid; grid-template-columns: minmax(150px, 1.1fr) minmax(0, 3fr) minmax(120px, auto) auto; gap: 6px 16px; align-items: center;
+  padding: 8px 0; border-top: 1px solid var(--line-soft); }
+.pl-row:first-child { border-top: 0; }
+.pl-name, .pl-where { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
+.pl-name span, .pl-note { font-size: 12px; color: var(--muted); }
+.pl-path { font: 12.5px var(--mono); overflow-wrap: anywhere; -webkit-user-select: text; user-select: text; }
+.pl-size { font-size: 12.5px; color: var(--muted); text-align: right; white-space: nowrap; }
+.pl-acts { display: inline-flex; gap: 6px; justify-content: flex-end; }
+.pl-row.is-missing .pl-path, .pl-bad { color: var(--bad); }
+.pl-job { margin: 8px 0 0; }
+.pl-job.is-bad { color: var(--bad); }
+.pl-job.is-good { color: var(--good); }
+@media (max-width: 760px) { .pl-row { grid-template-columns: minmax(0, 1fr); } .pl-size { text-align: left; } .pl-acts { justify-content: flex-start; } }
 /* the Appearance card: two parts under a thin line, like the drawers */
