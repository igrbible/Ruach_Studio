diff --git a/tools/console/app.css b/tools/console/app.css
index fc3c620..a43481e 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -6038,3 +6038,19 @@ body.daw-full #dawPanel { position: fixed; inset: 0; z-index: 60; margin: 0; bor
 body.daw-full #dawPanel > summary { display: none; }
 body.daw-full #dawPanel .mx-wave, body.daw-full #dawPanel .mx-lane.is-open .mx-wave { height: clamp(48px, calc((100vh - 170px) / var(--mx-lanes, 6) - 10px), 220px); }
 .mx-head .mx-full { align-self: flex-end; }
+/* HERESY 1500: a seed and its word go to the next line together */
+.run-seeds .seed-pair { display: inline-block; max-width: 100%; }
+/* HERESY 1501: the DAW, Bitwig's way: each lane its colour, its meter, the lane the keys act on; the ruler row */
+.mx-lane[data-strip] { border-left: 3px solid var(--mx-lane, var(--line-soft)); }
+.mx-lane.is-focus { box-shadow: inset 0 0 0 1px var(--mx-lane, var(--amber)); }
+.mx-lane[data-strip] .mx-name { cursor: pointer; color: var(--mx-lane, var(--ink)); }
+.mx-meter { position: relative; flex: none; width: 6px; height: 24px; border-radius: 2px; background: color-mix(in srgb, var(--ink) 10%, transparent); overflow: hidden; }
+.mx-meter i { position: absolute; left: 0; right: 0; bottom: 0; height: 0; background: linear-gradient(to top, #3f9a4a 0, #3f9a4a 70%, #e0b030 85%, #c8372d 100%); background-size: 100% 24px; background-position: bottom; }
+.mx-meter.is-hot { box-shadow: 0 0 0 1px #c8372d; }
+.mx-ruler-row { display: grid; grid-template-columns: minmax(650px, 700px) minmax(0, 1fr); align-items: center; gap: 8px; border: 1px solid transparent; border-left-width: 3px; border-radius: 6px; padding: 0 6px; }   /* HERESY 1501b: the lanes' grid and their 3 px left edge, so its time stands over their waves */
+.mx-ruler-ctl { gap: 6px; }
+.mx-ruler-ctl .mx-master { margin-left: 4px; }
+.mx-ruler-ctl .mx-keys { margin-left: auto; cursor: help; }
+.mx-wave.mx-ruler { height: 22px; cursor: text; }
+.mx-wave.mx-ruler canvas { display: block; --mx-wave: var(--dim); }
+body.daw-full #dawPanel .mx-wave.mx-ruler { height: 22px; }
diff --git a/tools/console/app.js b/tools/console/app.js
index d984589..62adf8b 100644
--- a/tools/console/app.js
+++ b/tools/console/app.js
@@ -3535,13 +3535,13 @@
     return parts.map(tr).join(" · ");              // HERESY 1166
   }
 
-  function runSeeds(job) {
+  function runSeeds(job, asList) {
     var lm = job.resolved.lm_seed || job.request.lm_seed, sound = job.resolved.seed || job.request.seed, parts = [];
     var songs = job.request.songs || 1, variations = job.request.variations || 1;
     if (job.kind === "transcribe") return "";
     if (lm && /^\d+$/.test(lm)) parts.push("music seed " + lm + (songs > 1 ? " \u2026 +" + (songs - 1) : ""));
     if (sound && /^\d+$/.test(sound) && !job.request.plan) parts.push("sound seed " + sound + (variations > 1 ? " \u2026 +" + (variations - 1) : ""));
-    return parts.map(tr).join(" · ");              // HERESY 1166
+    return asList ? parts.map(tr) : parts.map(tr).join(" · ");              // HERESY 1166
   }
 
   function stageRead(job, s) {
@@ -3610,7 +3610,10 @@
     $("runState").dataset.s = job.status === "saving" ? "running" : job.status;
     $("cancelRun").classList.toggle("is-hidden", !isLive(job));
     $("runWhat").textContent = runDescription(job);
-    $("runSeeds").textContent = runSeeds(job);
+    // HERESY 1500 (Viktor 16.10.2026: «Звуковой сид на вторую строку, если сам сид отрывается от лейбла»): each seed with its word, one piece
+    // that goes to the next line whole
+    var seedsHtml = runSeeds(job, true).map(function (x) { return '<span class="seed-pair" translate="no">' + escape(x) + "</span>"; }).join(" · ");
+    if ($("runSeeds").dataset.html !== seedsHtml) { $("runSeeds").innerHTML = seedsHtml; $("runSeeds").dataset.html = seedsHtml; }
     if (!STATE.take) {
       var eyebrow = label;
       if (job.status === "queued") eyebrow = active && active !== job ? "waiting behind " + active.title : "waiting for the server";
