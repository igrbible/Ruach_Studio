diff --git a/tools/console/app.css b/tools/console/app.css
index 0d30fc5..5796c76 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -2351,6 +2351,7 @@ body[data-tab="collection"] .library, body[data-tab="collection"] #gripRight { d
 .yue2-mark .y2-word { fill: var(--ink); }
 .yue2-mark .y2-mark { fill: color-mix(in srgb, #A4513A 82%, var(--ink)); }
 .about-mark { display: block; height: 64px; width: auto; overflow: visible; }
+.about-mark.ruach-logo { height: 40px; max-width: 100%; }   /* HERESY 1266: the name alone, as wide as the column allows */
 .about-tagline { font: 400 12px/1.4 var(--sans); color: var(--muted); }
 .about-links.about-ours { margin-top: 1.4em; }
 /* HERESY 1166: the Engine's LoRAs in two groups, trained here and from Hugging Face */
@@ -3424,8 +3425,10 @@ input[type="search"]::-webkit-search-cancel-button { cursor: pointer; }
    without the words her hang below it looked misplaced (1148: «без текста логотипа не красиво смотрится»); narrower
    still: that, at the start of the bar. The square is the favicon only. */
 .topbar .brand { position: absolute; left: 50%; top: 0; transform: translateX(-50%); height: var(--bar-h); z-index: 2; pointer-events: none; display: block; }
-.topbar .brand .brand-logo { display: block; height: 100%; }
-.brand-full { display: block; height: calc(var(--bar-h) + 10px); width: auto; overflow: visible; }
+/* HERESY 1266: the name alone, inside the bar, at one height (--logo-h: the Trainer's place is measured by it) */
+:root { --logo-h: 28px; }
+.topbar .brand .brand-logo { display: flex; align-items: center; height: 100%; }
+.brand-full { display: block; height: var(--logo-h); width: auto; }
 /* HERESY 1148 (Viktor, 03.10.2026): no stray selection when a click or a drag misses a button: the page's own words do not
    select; the fields one types into, the log, the guide, notes, the take's id and anything marked .selectable do */
 body { -webkit-user-select: none; user-select: none; }
@@ -3438,8 +3441,7 @@ html.i18n-wait body { visibility: hidden; }
 
 .brand-compact { display: none; height: 50px; width: auto; margin-top: 1px; overflow: visible; }   /* 1.4 : 1, cut from the bar's copy; inside the bar (1148) */
 .topbar .ws-current + .spacer { display: none; }
-@media (max-width: 1659px) { .brand-full { display: none; } .brand-compact { display: block; }
-  .ws-current .ws-cap { display: none; } }   /* 1148 (Viktor): with the logo's words gone, WORKSPACE goes too; the select names itself */
+@media (max-width: 1659px) { .ws-current .ws-cap { display: none; } }   /* 1148 (Viktor): with the logo's words gone, WORKSPACE goes too; the select names itself */
 /* HERESY 1157 (Viktor: «обрезанное лого на высоких скейлах… Вообще не пляшет и выглядит несоответствующе. Может вообще
    убрать логотип в таких случаях?»): where the logo would lose its words, it goes whole; the bar keeps the rooms and tools */
 @media (max-width: 1659px) { .topbar .brand { display: none; } }
@@ -3906,7 +3908,8 @@ body[data-frame="compose"] .k-plan #setupLibRow { flex-wrap: wrap; }
      A calmer page (html[data-motion="reduced"]) cuts it to nothing with every other transition. */
 @property --bar-h { syntax: "<length>"; inherits: true; initial-value: 52px; }
 :root { --bar-h: 52px; }
-@media (min-width: 1660px) { body.bar-tall { --bar-h: 98px; } }   /* HERESY 1167: 105 → 98 (Viktor: «отступ логотипа уменьши при высоком баре») */
+/* HERESY 1266 (Viktor 09.10.2026: «убирай из него высокий вариант. Больше без этих понтов. Стабильный тулбар во всей Студии»): the
+   bar tall at the page's top (1167) is gone: one height everywhere */
 body { transition: --bar-h .22s ease; }
 @media (prefers-reduced-motion: reduce) { body { transition: none; } }
 /* · the cheat-sheet's lead paragraph across the sheet («убери ручные переносы строк. Пусть всё автоврепом идёт») */
@@ -3955,7 +3958,7 @@ html.booting.veil-lift .boot-veil { opacity: 0; pointer-events: none; }
   text-align: center; animation: boot-in 1.1s .15s ease both; }
 .boot-osem b { color: var(--ink); font-weight: 600; letter-spacing: .18em; }
 html.i18n-wait .boot-veil > * { visibility: hidden; }
-.boot-logo { width: min(86vw, 1100px); animation: boot-in 1.1s ease both; }
+.boot-logo { width: min(72vw, 820px); animation: boot-in 1.1s ease both; }   /* HERESY 1266: the name alone */
 .boot-mark { display: block; width: 100%; height: auto; overflow: visible; }
 .boot-words { margin: 18px 0 0; font: 500 clamp(13px, 1.15vw, 19px)/1.4 var(--heading); letter-spacing: .34em; text-transform: uppercase;
   color: var(--muted); text-align: center; animation: boot-in 1.1s .25s ease both; }
@@ -4353,7 +4356,7 @@ body[data-frame="compose"] #view-compose, body[data-frame="take"] #view-take {
 .tabs .tab-soon:hover { color: var(--muted); }
 .topbar .tabs-side { margin-left: 0; }
 @media (min-width: 1660px) {
-  .topbar .tabs-side { position: absolute; top: 50%; transform: translateY(-50%); left: calc(50% + 54px * var(--logo-aspect, 4.1423) + 18px); }
+  .topbar .tabs-side { position: absolute; top: 50%; transform: translateY(-50%); left: calc(50% + var(--logo-h) / 2 * var(--logo-aspect, 9.7216) + 18px); }
 }
 /* the Refiner's way out: at its head's end, beside the take in hand; in Stems, at the end of the split's row */
 .post-head .post-daw { margin-left: auto; align-self: center; }
