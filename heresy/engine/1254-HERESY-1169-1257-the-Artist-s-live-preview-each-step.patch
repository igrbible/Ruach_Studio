+
+/* HERESY 1257: the live preview in its place, and the gallery */
+.ar-pic .ar-gone.ar-develop { position: relative; padding: 0; border-style: solid; animation: none; cursor: default; }
+.ar-gone.ar-develop img { display: block; width: 100%; height: 100%; object-fit: cover; image-rendering: auto; }
+.ar-stepno { position: absolute; right: 6px; bottom: 6px; padding: 1px 7px; border-radius: var(--r-pill); background: rgba(0, 0, 0, .55); color: #fff;
+  font-size: 11px; font-variant-numeric: tabular-nums; }
+.ar-live { align-self: center; white-space: nowrap; }
+.ar-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin: 16px 0 0; }
+.ar-looks, .ar-filters, .ar-sizes { display: inline-flex; gap: 6px; flex-wrap: wrap; }
+.ar-filters[hidden], .ar-sizes[hidden] { display: none; }
+.ar-bar .chip.is-on { border-color: var(--amber); color: var(--amber); background: color-mix(in srgb, var(--amber) 12%, transparent); }
+.ar-total { margin-left: auto; font-size: 12px; color: var(--dim); font-variant-numeric: tabular-nums; }
+.ar-gallery { display: flex; flex-wrap: wrap; gap: 10px; }
+.ar-gpic { position: relative; margin: 0; }
+.ar-gpic .ar-thumb { height: var(--g-h, 200px); }
+.ar-star { position: absolute; top: 6px; right: 6px; width: 26px; height: 26px; display: grid; place-items: center; padding: 0; border: 0;
+  border-radius: 50%; background: rgba(0, 0, 0, .45); color: #fff; font-size: 15px; line-height: 1; cursor: pointer; opacity: 0; transition: opacity .12s ease; }
+.ar-gpic:hover .ar-star, .ar-star:focus-visible, .ar-star.is-on { opacity: 1; }
+.ar-star.is-on, .ar-vstar.is-on { color: #f2c14e; }
+.ar-view .ar-vstar { font-size: 18px; }
