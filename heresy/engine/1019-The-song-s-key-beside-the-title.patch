 tools/console/app.js       |  44 +++++++++++++++++++++++++++++++++++++
 tools/console/index.html   |  15 +++++++++----
 tools/public/index.html.gz | Bin 265262 -> 265931 bytes
 4 files changed, 61 insertions(+), 4 deletions(-)

