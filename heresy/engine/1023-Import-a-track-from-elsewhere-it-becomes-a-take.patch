+          <textarea id="impLyrics" rows="4" spellcheck="false" placeholder="[Verse]&#10;…"></textarea></label>
+        <div class="dv-actions">
+          <button type="button" class="btn primary small" id="impRun">Import</button>
+          <span class="row-hint mono" id="impState"></span>
