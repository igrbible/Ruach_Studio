diff --git a/tools/console/app.css b/tools/console/app.css
index 053fc1f..0b4b243 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -3628,3 +3628,138 @@ body[data-tab="post"] .lib-refined { display: inline-flex; }
 /* HERESY 1165: the overlay's play is the cards' hollow one, light on the overlay's dark in either theme */
 .art-cap .coll-play { width: 34px; height: 34px; color: #f1ece4; }
 .art-cap .coll-play:hover, .art-cap .coll-play.is-playing { color: #fff; }
+
+/* ============================================================= the Creator's kitchen (HERESY 1167)
+   Viktor 05.10.2026: «Левую промптинг генерации на 2/3 слева как основную, разделить её на две колонки по 1/3, всё
+   пересмотреть и реорганизовать. Статистику/карту трека реально нужно на 1/3 ширины справа… [дубли] во втором фрейме
+   1/3 ширины вниз этого фрейма под-фреймом. И для экономии пространства карточки сделать более компактными… Каждую
+   секцию отчётливо обособить, может даже едва заметным карточным абажуром. Схлопнутые блоки тоже нужно как-то более
+   контрастно изобразить». At every width the form is two columns of cards, the words and the machine; from 1600 px
+   they stand side by side over two thirds of the room, and the right third holds the take over its takes. */
+
+/* each part of the form on a ground of its own, barely raised: the lampshade */
+.compose { gap: 14px; }
+.k-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
+.k-card {
+  display: flex; flex-direction: column; gap: 14px; min-width: 0;
+  padding: 14px 16px 16px;
+  border-radius: var(--r-lg);
+  background: color-mix(in srgb, var(--panel) 55%, var(--ground));
+  border: 1px solid var(--line-soft);
+  box-shadow: 0 1px 2px color-mix(in srgb, var(--shadow-md) 45%, transparent), 0 12px 26px -22px var(--shadow-lg);
+}
+.k-card > .field-row, .k-card > .field { margin: 0; }
+/* the drawers are cards themselves: their group wears no second frame */
+.k-card.k-more { padding: 0; gap: 10px; background: none; border: 0; box-shadow: none; }
+.k-song .wr-hand { margin: 0; }
+
+/* closed reads as closed: a folded part and a closed drawer stand on a firmer ground, with a firm line and the
+   chevron in the accent, so what is hidden is never missed */
+:is(#view-compose, #view-take) .drawer:not([open]) {
+  background: var(--raise);
+  border-color: color-mix(in srgb, var(--line) 55%, var(--line-strong));
+}
+:is(#view-compose, #view-take) .drawer:not([open]) > summary .sum-name { font-weight: 600; }
+:is(#view-compose, #view-take) .drawer:not([open]):hover { border-color: var(--amber-dim); }
+:is(#view-compose, #view-take) .drawer > summary .chev { border-left-color: var(--amber); }
+.compose [data-fold].is-folded > .label {
+  padding: 9px 12px; border-radius: var(--r-md);
+  background: var(--raise);
+  border: 1px solid color-mix(in srgb, var(--line) 55%, var(--line-strong));
+  color: var(--ink);
+}
+.compose [data-fold].is-folded > .label:hover { border-color: var(--amber-dim); }
+.compose [data-fold] > .label .fold-chev { border-left-color: var(--amber); }
+
+/* from 1600 px: the words | the machine over two thirds; the take over its takes in the last third */
+@media (min-width: 1600px) {
+  body[data-tab="create"] .workspace {
+    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
+    grid-template-rows: var(--k-take, clamp(480px, 56%, 760px)) minmax(0, 1fr);   /* the take needs ~600 px, its takes the rest */
+  }
+  body[data-tab="create"] #view-compose { grid-column: 1; grid-row: 1 / 3; }
+  body[data-tab="create"] #view-take { grid-column: 2; grid-row: 1; }
+  body[data-tab="create"] .library { grid-column: 2; grid-row: 2; }
+  body[data-tab="create"] .col-grip { display: none; }
+  body[data-tab="create"] .compose {
+    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: minmax(min-content, 1fr) auto;
+    gap: 14px 16px; align-items: start; flex: 1 0 auto;   /* a short kitchen still has its bar at the bottom */
+  }
+  /* the bar stays in sight at the column's foot; its ground reaches into the column's margins by a shadow, so its
+     buttons keep to the kitchen's right edge */
+  body[data-tab="create"] .compose > .submit-bar {
+    grid-column: 1 / -1; position: sticky; bottom: -60px; z-index: 4;
+    margin: 0 0 -60px; padding: 12px 0 14px;
+    background: var(--ground);
+    box-shadow: -22px 0 0 0 var(--ground), 22px 0 0 0 var(--ground);
+  }
+
+  /* the line between the take and its takes: drag it, double-click for the default, arrows move it */
+  .k-split { display: none; }
+  body[data-tab="create"] .k-split {
+    display: block; grid-column: 2; grid-row: 2; align-self: start; position: relative;
+    height: 11px; margin-top: -6px; z-index: 7; cursor: row-resize; touch-action: none; outline: none;
+  }
+  body[data-tab="create"] .k-split::after {
+    content: ""; position: absolute; left: 0; right: 0; top: 4px; height: 3px; border-radius: 2px;
+    background: transparent; transition: background .15s;
+  }
+  body[data-tab="create"] .k-split:hover::after, body[data-tab="create"] .k-split:focus-visible::after,
+  body[data-tab="create"] .k-split.is-dragging::after { background: var(--amber); }
+  body.is-resizing-rows, body.is-resizing-rows * { cursor: row-resize !important; user-select: none !important; }
+
+  /* folded, the takes are one bar under the take, and the take has the third to itself */
+  body[data-tab="create"] .workspace.lib-folded { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) !important; grid-template-rows: minmax(0, 1fr) auto; }
+  body[data-tab="create"] .workspace.lib-folded .k-split { display: none; }
+  body[data-tab="create"] .library.is-folded .lib-unfold {
+    writing-mode: horizontal-tb; flex-direction: row; justify-content: flex-start; gap: 10px;
+    width: 100%; height: 40px; padding: 0 16px;
+  }
+  body[data-tab="create"] .library.is-folded .lib-unfold-name { writing-mode: horizontal-tb; }
+
+  /* the takes in compact cards: the title, then its marks, length and time beside its workspace and its votes */
+  body[data-tab="create"] .library .lib-list { gap: 2px; padding: 6px 8px; }
+  body[data-tab="create"] .library .take {
+    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; column-gap: 8px; row-gap: 3px;
+    padding: 7px 10px;
+  }
+  body[data-tab="create"] .library .take-title { grid-column: 1 / -1; margin: 0; font-size: 13px; }
+  body[data-tab="create"] .library .take-style { display: none; }
+  body[data-tab="create"] .library .take-foot { grid-column: 1; grid-row: 2; margin: 0; flex-wrap: nowrap; white-space: nowrap; }
+  body[data-tab="create"] .library .take-extra { display: contents; }
+  body[data-tab="create"] .library .take-extra .coll-badges { grid-column: 2; grid-row: 2; margin: 0; flex-wrap: nowrap; overflow: hidden; }
+  body[data-tab="create"] .library .take-extra .coll-badge { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
+  body[data-tab="create"] .library .take-rate { grid-column: 3; grid-row: 2; }
+  body[data-tab="create"] .library .take.is-running-row .take-style { display: block; grid-column: 1 / -1; -webkit-line-clamp: 1; }
+}
+
+/* the adapters not in use, behind one line (loras.js): closed, it reads as closed */
+.lora-lib > summary {
+  display: flex; align-items: center; gap: 9px; padding: 8px 12px; cursor: pointer; list-style: none;
+  border-radius: var(--r-md); background: var(--raise); color: var(--ink); font-size: 12.5px; font-weight: 600;
+  border: 1px solid color-mix(in srgb, var(--line) 55%, var(--line-strong));
+}
+.lora-lib > summary::-webkit-details-marker { display: none; }
+.lora-lib > summary:hover { border-color: var(--amber-dim); }
+.lora-lib > summary .chev { border-left-color: var(--amber); }
+.lora-lib[open] > summary .chev { transform: rotate(90deg); }
+.lora-lib[open] > summary { margin-bottom: 8px; background: transparent; border-color: var(--line-soft); }
+.lora-lib-count { color: var(--dim); font-weight: 400; font-size: 11.5px; }
+.lora-lib-count:empty { display: none; }
+
+/* the profile's line in one row: its menu gives way to its three buttons */
+.k-plan #setupLibRow { flex-wrap: nowrap; margin: 0; }
+.k-plan #setupLibRow select { flex: 1 1 160px; min-width: 0; max-width: 300px; }
+
+@media (min-width: 1600px) {
+  /* the four drawers two by two; an open one takes the whole width */
+  body[data-tab="create"] .k-card.k-more { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
+  body[data-tab="create"] .k-more .drawer[open] { grid-column: 1 / -1; }
+}
+
+@media (min-width: 1600px) {
+  /* the take's tools tighter in its third: smaller buttons, closer rows */
+  body[data-tab="create"] #view-take .take-tools { gap: 8px 14px; }
+  body[data-tab="create"] #view-take .take-tools .btn.small { padding: 4px 9px; font-size: 11.5px; }
+  body[data-tab="create"] #view-take .tool-row { gap: 5px; }
+}
