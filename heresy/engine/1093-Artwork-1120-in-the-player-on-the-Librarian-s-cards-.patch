       navigator.mediaSession.metadata = t ? new MediaMetadata({ title: displayTitle(t), artist: "Ruach Studio",
-        album: t.style ? String(t.style).split(/[.\n]/)[0].slice(0, 80) : "" }) : null;
+        album: t.style ? String(t.style).split(/[.\n]/)[0].slice(0, 80) : "",
+        artwork: art ? [{ src: location.origin + art, sizes: "768x768", type: "image/jpeg" }] : [] }) : null;
       navigator.mediaSession.playbackState = t ? (isPlaying() ? "playing" : "paused") : "none";
     } catch (e) { /* an old browser */ }
   }
@@ -5689,6 +5725,12 @@
           .then(function (t) { if (t !== null) return renameTake(name, t).then(function (ok) { if (ok && HC) HC.reload(); }); })
           .catch(function (e) { toast(e.message, "bad"); });
       } },
+      take.session ? null : (function () {                       // HERESY 1120: artwork, asked for
+        return artUrl(name) ? { icon: "▣", label: "Artwork", items: [
+          { label: "Open the artwork", action: function () { window.open(artUrl(name), "_blank", "noopener"); } },
+          { label: "Draw it again", hint: "a new prompt, a new picture", action: function () { drawArt(name, true); } }
+        ] } : { icon: "▣", label: "Draw artwork", hint: "half a minute on a GPU", action: function () { drawArt(name, false); } };
+      })(),
       { sep: true },
       HC ? { icon: "▦", label: "Workspaces", items: ws.map(function (w) {
         var on = inWs.indexOf(w) >= 0;
@@ -5741,7 +5783,8 @@
       ] },
       { icon: "⤓", label: "Download", items: [
         { label: formatExt(take.format).toUpperCase(), action: save(downloadUrl(take), audioFileName(take)) },
-        convertible(take) ? { label: "MP3 · " + mp3Rate() + " kbps", action: save(mp3Url(take), fileTitle(take) + ".mp3") } : null,
+        convertible(take) ? { label: "MP3 · " + mp3Rate() + " kbps", hint: artUrl(name) ? "with its artwork" : "", action: save(mp3Url(take), fileTitle(take) + ".mp3") } : null,
+        artUrl(name) ? { label: "Artwork · JPEG", action: save(artUrl(name), fileTitle(take) + ".jpg") } : null,
         take.session ? null : { sep: true },             // HERESY 1074: the take, its mix and stems, for openDAW or any DAW
         take.session ? null : { label: "REAPER project", hint: "mix, stems, score, lyrics", action: function () {   // HERESY 1104
           reaperProject(take).catch(function (e) { toast("No REAPER project: " + e.message, "bad"); });
