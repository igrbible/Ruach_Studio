+/* HERESY 1166 (Viktor 04.10.2026: «По колонкам в Engine. Давай подумаем, как всё ужать и передвинуть, чтобы на 1080p всё
+   встало красиво и не таким длинным полотенцем… Ты всё замерь и пересмотри»; at 1920×1080 the page ran 3 975 px): the
+   cards stand in the order of his rows; narrower than 1400px the flex rows above keep their old sequence by `order`;
+   from 1400px one grid of thirty columns, so thirds, fifths and sixths share it */
+.engine-grid > .eg-server { order: 1; }
+.engine-grid > .eg-compute { order: 2; }
+.engine-grid > .eg-hardware { order: 3; }
+.engine-grid > .eg-gpus { order: 4; }
+.engine-grid > .eg-vae { order: 5; }
+.engine-grid > .eg-loras { order: 6; }
+.engine-grid > .eg-sliders { order: 7; }
+.engine-grid > .eg-writer { order: 8; }
+.engine-grid > .eg-look { order: 9; }
+.engine-grid > .eg-log { order: 10; }
+.engine-grid > .eg-about { order: 11; }
+@media (min-width: 1400px) {
+  .engine-grid { display: grid; grid-template-columns: repeat(30, minmax(0, 1fr)); }
+  .engine-grid > .eg-server   { grid-area: 1 / 1 / 2 / 11; }    /* Server over Hardware | the log    1/3 · 2/3 */
+  .engine-grid > .eg-hardware { grid-area: 2 / 1 / 3 / 11; }
+  .engine-grid > .eg-log      { grid-area: 1 / 11 / 3 / 31; }
+  .engine-grid > .eg-compute  { grid-area: 3 / 1 / 4 / 13; }    /* Compute | GPUs                    2/5 · 3/5 */
+  .engine-grid > .eg-gpus     { grid-area: 3 / 13 / 4 / 31; }
+  .engine-grid > .eg-look     { grid-area: 4 / 1 / 5 / 21; }    /* Appearance | Writer               4/6 · 2/6 */
+  .engine-grid > .eg-writer   { grid-area: 4 / 21 / 5 / 31; }
+  .engine-grid > .eg-vae      { grid-area: 5 / 1 / 6 / 6; }     /* VAEs | LoRAs                      1/6 · 5/6 */
+  .engine-grid > .eg-loras    { grid-area: 5 / 6 / 6 / 31; }
+  .engine-grid > .eg-sliders  { grid-area: 6 / 1 / 7 / 31; }
+  .engine-grid > .eg-about    { grid-area: 7 / 1 / 8 / 31; }
+  /* the log fills its column beside Server and Hardware, 260px at least */
+  .eg-log .log-body { flex: 1 1 0; height: auto; min-height: 260px; }
+  /* a sixth is narrower than two tiles: the decoders one under another */
+  .eg-vae .vae-list { grid-template-columns: minmax(0, 1fr); }
+}
