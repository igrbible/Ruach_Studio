+    set: function (o) { ["rest", "restNight", "played", "bars"].forEach(function (k) { if (o && isFinite(o[k])) WAVE[k] = Math.max(0, Math.min(1, +o[k])); });
       WAVE.epoch++; drawWave(); return this.get(); }
