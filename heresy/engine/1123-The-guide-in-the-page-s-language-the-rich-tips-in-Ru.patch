+    if (!state.loading) state.loading = (lang === "en" ? get("GUIDE.md") : get("GUIDE." + lang + ".md").catch(function () { return get("GUIDE.md"); }))
+      .then(function (md) { if (state.lang === lang) parse(md); });
     return state.loading;
