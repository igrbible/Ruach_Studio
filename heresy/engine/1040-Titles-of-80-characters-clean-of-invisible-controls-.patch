         </label>
         <label class="field keyfield">
           <span class="label">Key</span>
@@ -1037,6 +1037,9 @@ Q6_K · 2.9 GB, Q5_K_M · 2.6 GB · smaller, less VRAM"></select>
   <canvas id="wave" height="40"></canvas>
   <span class="mono time dim" id="timeTotal">0:00</span>
 
