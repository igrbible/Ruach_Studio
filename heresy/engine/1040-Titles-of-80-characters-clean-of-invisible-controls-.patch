@@ -313,7 +313,7 @@ Q6_K · 2.9 GB, Q5_K_M · 2.6 GB · smaller, less VRAM"></select>
       <div class="field-row title-row">
         <label class="field titlefield grow">
           <span class="label">Title</span>
-          <input type="text" id="title" placeholder="Song title" autocomplete="off" />
