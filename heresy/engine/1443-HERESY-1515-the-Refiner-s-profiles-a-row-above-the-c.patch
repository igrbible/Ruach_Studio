diff --git a/tools/console/app.css b/tools/console/app.css
index e7a51d0..5aacc6d 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -6181,3 +6181,10 @@ body.daw-full #dawPanel .mx-wave.mx-ruler { height: 22px; }
 }
 #derivedTree .dv-acts { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }
 
+/* HERESY 1515: the Refiner's setups by name, a row above the canvas (the chain's row, empty in the canvas) */
+#view-post > #pcvBar { grid-column: 1 / -1; grid-row: 3; }
+.pcv-bar { display: flex; align-items: center; min-height: 28px; }
+.pcv-bar[hidden] { display: none; }
+.pcv-profiles { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
+.pcv-prof-cap { font: 600 10.5px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--dim); margin-right: 2px; }
+
