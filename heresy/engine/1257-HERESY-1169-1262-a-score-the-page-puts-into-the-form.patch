+++ b/tools/console/index.html
@@ -906,7 +906,7 @@ Blend · an add-on: two thirds Standard, one third Legacy"></select></label>
             <span class="label">Profile</span>
             <select id="setupLib" aria-label="Profiles" data-tip="A profile sets the mode, length, sampling, guidance, steps, VAE, sliders, LoRAs and output; the texts and seeds stay"></select>
             <button type="button" class="btn ghost small" id="setupApply">Apply</button>
-            <button type="button" class="btn ghost small" id="setupSave" data-tip="Keep every knob of the form under a name, on Forge">Save profile…</button>
+            <button type="button" class="btn ghost small" id="setupSave" data-tip="Keep every knob of the form under a name, on Forge">Save</button>
             <button type="button" class="btn ghost small" id="setupDel" disabled>Delete</button>
           </div>
           <fieldset class="field plan-field">
