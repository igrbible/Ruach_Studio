 @media (max-width: 1000px) { .hi-legend { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+/* HERESY 1167: a song's own tools beside New song (Open, Save, Example, Clear), their menus under them */
+.compose-tools { display: inline-flex; align-items: center; gap: 6px; margin-right: 6px; }
+.compose-tools .menu-wrap { position: relative; }
+.compose-tools .menu-pop { left: auto; right: 0; top: calc(100% + 4px); }
+/* HERESY 1167 (Viktor: «В Out of the Studio (DAW) у тебя жёсткие переносы строк. И здесь +2pt на тексты. Три колонки DAW -
+   расширь их по всей ширине»): the panel's texts across its width, 2 pt larger; the three DAWs in three columns */
+.dw-box { width: min(1240px, 100%); font-size: 15.5px; }
+.dw-box p, .dw-box .row-hint, .dw-head > div > * { max-width: none; }
+.dw-box .row-hint { font-size: 15px; }
+.dw-head b { font-size: 21px; }
+.dw-way h3 { font-size: 17.5px; }
+.dw-daws { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.dw-daw-head span, .dw-here, .dw-install summary, .dw-install p { font-size: 14.5px; }
+@media (max-width: 900px) { .dw-daws { grid-template-columns: minmax(0, 1fr); } }
+/* HERESY 1167 (Viktor: «Попап справа вверху можно растянуть на 200px… при наведении разворачивать вниз»): the peek 200 px
+   wider, reachable (it takes the pointer), and hovered it opens downward: the whole style, the whole lyrics */
+.coll-peek { width: 580px; pointer-events: auto; }
+.coll-peek .peek-lyrics-full { display: none; margin: 2px 0 0; white-space: pre-wrap; font: inherit; color: var(--ink); line-height: 1.35; }
+.coll-peek:hover { max-height: calc(100vh - 120px) !important; overflow: auto; }
+.coll-peek:hover .peek-lyrics { display: none; }
+.coll-peek:hover .peek-lyrics-full { display: block; }
+.coll-peek:hover .peek-style { display: block; -webkit-line-clamp: unset; }
+/* HERESY 1167 (Viktor: «Search box - дай ему авто сжимку до разумных размеров. Смотри, что творится»): a long workspace name
+   wrapped the head to a second line; now the numbers give way first (into two or three lines), the search narrows down to
+   220 px, and the head stays one line from 1400 px */
+@media (min-width: 1400px) { .coll-head { flex-wrap: nowrap; } }
+.coll-head #collNote { flex: 0 3 680px; min-width: 240px; }
+.coll-headtools { flex: 0 1 auto; min-width: 0; }
+.coll-headtools input[type="search"] { flex: 0 1 466px; width: 466px; min-width: 260px; }
