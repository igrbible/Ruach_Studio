+      shown = shown.filter(function (t) {                 // HERESY 1125: and the column's own filters
+        if (!F.hidden && HC.isHidden(t.name)) return false;
+        if (!HC.inCurrent(t.name) || !(m(displayTitle(t)) || m(t.name))) return false;
+        var r = HC.rating(t.name);
+        return !(F.liked && r <= 0) && !(F.noDisliked && r < 0) && !(F.noted && !HC.note(t.name));
+      });
     }
-    $("libCount").textContent = STATE.favOnly ? shown.length + " / " + STATE.takes.length : String(STATE.takes.length);
+    $("libCount").textContent = filtered ? shown.length + " / " + STATE.takes.length : String(STATE.takes.length);
+    $("libMenuBtn").classList.toggle("has-filter", F.liked || F.noDisliked || F.noted || F.hidden);
+    all("[data-libf]").forEach(function (b) { b.setAttribute("aria-checked", F[b.dataset.libf] ? "true" : "false"); });
     $("favFilter").setAttribute("aria-pressed", STATE.favOnly ? "true" : "false");
 
     // A run in progress sits at the top of the list, so it is never lost.
@@ -4345,7 +4369,7 @@
