+/* HERESY 1167: the draft's style as tags, and which form goes into the form */
+.draft-style-form { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin: -2px 0 6px; }
+.draft-style-form .label { margin: 0; }
+/* HERESY 1167: the Writer's saved briefs, a row under the brief as under the style */
+.assist-brief-lib { margin: 2px 0 8px; }
+.assist-brief-lib select { flex: 0 1 260px; min-width: 140px; }
+/* HERESY 1167 (Viktor: «две колонки SLIDERS и LORAS в одной строке. Их нужно на отдельные строки… Пройдись через все такие
+   моменты»): Sliders over LoRAs always; long names, amounts and values wrap inside the card instead of widening it */
+.meta-row.duo { grid-template-columns: minmax(0, 1fr); row-gap: 10px; }
+.meta-row.duo > .meta-col + .meta-col { border-left: none; padding-top: 10px; border-top: 1px solid var(--line-soft); }
+.meta-rows.addons { grid-template-columns: minmax(0, max-content) minmax(0, 1fr); }
+.meta-rows.addons .amt { white-space: normal; }
+.meta-rows dd { white-space: normal; overflow-wrap: anywhere; }
+.meta-rows dd.num { white-space: nowrap; }
+/* the rooms say what they are in two lines beside their names (as the Writer) */
+.col-note.col-note-two { white-space: normal; max-width: 430px; line-height: 1.35; align-self: center; }
+.post-head { flex-wrap: wrap; row-gap: 4px; }
+.post-head .post-take { font: 500 16px/1.4 var(--heading); color: var(--ink); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 46%; }
+.post-head .post-take:empty { display: none; }
+/* the Librarian's numbers in two lines, its search 50 pt narrower: the head on one line where it fits */
+.coll-head #collNote { flex: 0 1 680px; white-space: normal; line-height: 1.35; align-self: center; }
+.coll-headtools { flex: 0 1 auto; }
+.coll-headtools input[type="search"] { flex: 0 1 466px; width: 466px; min-width: 200px; }
