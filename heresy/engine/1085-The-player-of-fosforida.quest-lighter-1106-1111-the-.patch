+#playbar .play, #playbar .play:hover { width: 46px; height: 46px; border-radius: 50%; border: 1.5px solid var(--amber); background: none; color: var(--amber); box-shadow: none; }
+#playbar .play:hover { background: color-mix(in srgb, var(--amber) 10%, transparent); transform: scale(1.05); }
+#playbar .play .play-icon { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linejoin: round; }
+#playbar .play:not(.is-playing) .play-icon-play { margin-left: 3px; }
+#playbar #muteGlyph { display: grid; place-items: center; }
+#playbar #muteGlyph .ui-ico { width: 18px; height: 18px; }
+#playbar .volume #volume { width: 110px; }
+@media (max-width: 1360px) { #playbar .pb-side .speed-pick, #playbar .volume #volume { display: none; } }
+@media (max-width: 1150px) { #playbar .pb-row { grid-template-columns: auto 1fr; } #playbar .playbar-id { display: none; } }
+
+/* HERESY 1107: the line to the studio, beside the server log */
+.net-say { margin-left: 8px; padding: 0 6px; border-radius: var(--r-pill); font-size: 11px; color: var(--muted); white-space: nowrap; flex: none; }
+.net-say[data-q="good"] { color: var(--good); }
+.net-say[data-q="slow"] { color: var(--amber); }
+.net-say[data-q="bad"] { color: var(--bad); }
+
+/* HERESY 1110: the Writing room's line */
+.assist-line { margin: 0 0 10px; padding: 7px 10px; border: 1px solid var(--line); border-left-width: 3px; border-radius: var(--r-sm); font-size: 12.5px; color: var(--ink); }
+.assist-line[data-s="ready"] { border-left-color: var(--good); }
+.assist-line[data-s="warn"] { border-left-color: var(--amber); }
+.assist-line[data-s="bad"] { border-left-color: var(--bad); background: color-mix(in srgb, var(--bad) 6%, transparent); }
+
+/* ---------------------------------------------------------------- HERESY 1111: the player, lighter still */
+/* no ring round play: the triangle alone, larger */
+#playbar .play, #playbar .play:hover { border: 0; background: none; box-shadow: none; width: 44px; height: 44px; }
+#playbar .play:hover { transform: scale(1.08); background: none; color: var(--amber-hi, var(--amber)); }
+#playbar .play .play-icon { width: 30px; height: 30px; stroke-width: 1.4; }
+/* the status: a dot, no words (the tip says them); larger; it pulses while it plays; 60 % see-through when it does not */
+#playbar .status-pill { width: 28px; height: 28px; padding: 0; border: 0; background: none; justify-content: center; }
+#playbar .status-pill #statusText { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+#playbar .status-pill .status-dot { width: 12px; height: 12px; }
+#playbar .status-pill:not([data-s="playing"]):not([data-s="rendering"]) { opacity: .4; }
+#playbar .status-pill[data-s="playing"] .status-dot { animation: pb-beat 1.6s ease-in-out infinite; }
+@keyframes pb-beat { 0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 color-mix(in srgb, var(--good) 45%, transparent); }
+                     50% { transform: scale(1.18); box-shadow: 0 0 0 6px color-mix(in srgb, var(--good) 0%, transparent); } }
+@media (prefers-reduced-motion: reduce) { #playbar .status-pill .status-dot { animation: none; } }
+/* what the eye does not need now steps back until the pointer comes */
+#playbar .pb-tog, #playbar .skip-btn, #playbar .speed-pick, #playbar .volume, #playbar .pb-rate .pb-btn, #playbar .pb-side .time { opacity: .5; transition: opacity .15s ease; }
+#playbar .pb-tog.is-on, #playbar .pb-rate .pb-btn[aria-pressed="true"] { opacity: 1; }
+#playbar .pb-tog:hover, #playbar .skip-btn:hover, #playbar .speed-pick:hover, #playbar .speed-pick:focus, #playbar .volume:hover, #playbar .volume:focus-within,
+#playbar .pb-rate:hover .pb-btn, #playbar .pb-side .time:hover, #playbar:focus-within .pb-tog:focus-visible { opacity: 1; }
+#playbar #timeTotal { cursor: pointer; }
+#playbar .speed-pick { font-variant-numeric: tabular-nums; }
