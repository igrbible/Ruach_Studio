+#playbar .pb-names { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
+#playbar .pb-names strong { font-family: var(--heading); font-weight: 500; font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; }
+#playbar .pb-sub { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+#playbar .pb-ctrl { display: flex; align-items: center; gap: 10px; }
+#playbar .pb-side { display: flex; align-items: center; justify-content: flex-end; gap: 10px; min-width: 0; }
+#playbar .pb-side .time { white-space: nowrap; }
+/* the outlines, light: thin strokes, nothing filled */
+#playbar .ui-ico, .coll-play .ui-ico, .coll-pin .ui-ico { stroke-width: 1.5; }
+#playbar .skip-btn .ui-ico { width: 20px; height: 20px; }
+#playbar .pb-tog { color: var(--dim); opacity: 1; padding: 6px; border: 0; background: none; }
+#playbar .pb-tog .ui-ico { width: 18px; height: 18px; }
+#playbar .pb-tog:hover { color: var(--ink); }
