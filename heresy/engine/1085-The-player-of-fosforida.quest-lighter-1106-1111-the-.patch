 input[type="checkbox"], input[type="radio"] { accent-color: var(--check, var(--amber)); }
+
+/* ---------------------------------------------------------------- HERESY 1106: the player of fosforida.quest */
+#playbar { flex-direction: column; align-items: stretch; justify-content: center; gap: 6px; padding: 8px 22px 10px; }
+#playbar #wave { display: block; width: 100%; height: 52px; flex: none; cursor: pointer; border-radius: var(--r-md); }
+#playbar .pb-row { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 16px; min-height: 48px; }
+#playbar .playbar-id { display: flex; align-items: center; gap: 12px; width: auto; min-width: 0; }
+#playbar .pb-cover { flex: none; width: 46px; height: 46px; border-radius: var(--r-sm); display: grid; place-items: center;
+  background: color-mix(in srgb, var(--amber) 14%, var(--raise)); box-shadow: 0 4px 12px -6px var(--shadow-lg, rgba(0,0,0,.35)); }
+#playbar .pb-cover svg { width: 22px; height: 22px; fill: none; stroke: rgba(255,255,255,.82); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
