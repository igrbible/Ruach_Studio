 .take:hover .take-title, .take:focus-within .take-title { padding-right: var(--tools-w, 170px); }
 .take.has-rate:hover .take-title, .take.has-rate:focus-within .take-title { padding-right: var(--tools-w, 140px); }
+/* HERESY 1421 (Viktor 13.10.2026: «В поиске и реплейсе в обоих редакторах… кнопка X съезжает иногда на новую линию»): the bar as wide
+   as its rows may be, the find field (and the replace field) the one that gives way: the count's words in any language never push
+   ✕ under the row */
+.find-bar { width: min(440px, calc(100vw - 8px)); }
+.find-bar .find-q, .find-bar .find-rep .find-r { flex: 1 1 0; min-width: 80px; width: auto; }
+.find-bar .find-n { flex: none; white-space: nowrap; }
+.find-bar .find-btn { flex: none; }
+/* HERESY 1421 (Viktor 13.10.2026: «К хуям убери mp3, огранить, скачать и удалить кнопки с лица карточки в takes. У нас есть это всё в
+   контекстном меню. А вот со второй строки лучше перенести в хвост первой ИДЁТ/ИГРАЕТ и VAE»): of the hover tools only the star is left
+   on a card (the four are the take menu's: Download, Refine, Move to the trash; their links stay in the markup unseen, the checks'
+   handle on the files' names); the title's row ends with playing (or a run's state) and the decoder, the second row is the workspaces' */
+.take-row-tools > .take-mp3, .take-row-tools > .take-post, .take-row-tools > .take-dl, .take-row-tools > .take-del { display: none; }
+.take-head { display: flex; align-items: center; gap: 6px; min-width: 0; margin-bottom: 3px; padding-right: 36px; }
+.take.has-rate .take-head { padding-right: 0; }
+.take-head > .take-title { flex: 0 1 auto; min-width: 0; margin-bottom: 0; padding-right: 0; }
+.take:hover .take-head > .take-title, .take:focus-within .take-head > .take-title,
+.take.has-rate:hover .take-head > .take-title, .take.has-rate:focus-within .take-head > .take-title { padding-right: 0; }
+.take-head > .tag { flex: none; font-family: var(--mono); font-size: 10.5px; }
+.take-foot:empty { display: none; }
