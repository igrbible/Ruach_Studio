diff --git a/tools/console/app.css b/tools/console/app.css
index 7cf535b..84be8ff 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -6160,3 +6160,15 @@ body.daw-full #dawPanel .mx-wave.mx-ruler { height: 22px; }
 .mx-wave { height: 64px; transition: none; }
 .mx-lane.is-open .mx-wave { height: 64px; }
 
+/* HERESY 1512: the Refiner's Audio I/O: the interfaces in two columns, the gateway's choice under them */
+.au-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
+.au-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; }
+.au-list { display: flex; flex-direction: column; gap: 8px; max-height: 42vh; overflow: auto; }
+.au-card { padding: 8px 10px; border: 1px solid var(--line-soft); border-radius: var(--r-sm); }
+.au-card-name { font-weight: 600; margin-bottom: 4px; }
+.au-devs { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 3px; font-size: 13px; }
+.au-way { font-size: 11px; color: var(--amber); text-transform: uppercase; letter-spacing: .06em; }
+.au-kind { display: inline-block; min-width: 64px; font-size: 11px; color: var(--dim); text-transform: uppercase; letter-spacing: .06em; }
+.au-gate { display: flex; flex-direction: column; gap: 8px; padding-top: 10px; border-top: 1px solid var(--line-soft); }
+#auState.is-bad { color: var(--bad, #e06c5a); }
+
