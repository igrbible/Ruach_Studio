+    var bl = parseFloat(cs.borderLeftWidth) || 0, bt = parseFloat(cs.borderTopWidth) || 0, lh = parseFloat(cs.lineHeight) || p.height || 20;
+    var top = r.top + k * (bt + p.top - box.scrollTop), bottom = top + k * lh;
