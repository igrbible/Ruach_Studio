index b8a679a..f423715 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -5922,3 +5922,37 @@ body:has(#view-engine:not(.is-hidden)) :is(.topbar, #playbar) { z-index: 37; }
 
 /* HERESY 1465: a plugin step that runs on a card of the lab's jobs */
 .pl-panel .pl-gpu { margin-left: auto; padding: 1px 6px; border: 1px solid var(--line); border-radius: 4px; color: var(--muted); }
+
+/* HERESY 1471: the Refiner's DAW: lanes of a set of stems, the wave's upper half and the whole one under the pointer */
+#dawPanel .mx-body { display: flex; flex-direction: column; gap: 10px; }
+.mx-head { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px; }
+.mx-head .mx-set select { min-width: 200px; }
+.mx-head .mx-bus select { min-width: 90px; }
+.mx-time { font-size: 13px; color: var(--muted); min-width: 92px; align-self: center; }
+.mx-state { align-self: center; }
+.mx-state.is-bad { color: var(--bad, #e06c5a); }
+.mx-lanes { position: relative; display: flex; flex-direction: column; gap: 4px; }
+.mx-lane { display: grid; grid-template-columns: minmax(650px, 700px) minmax(0, 1fr); align-items: center; gap: 8px; border: 1px solid var(--line-soft); border-radius: 6px; padding: 3px 6px; background: var(--sunk); }
+.mx-lane.is-quiet .mx-wave, .mx-lane.is-quiet .mx-name { opacity: .45; }
+.mx-ctl { display: flex; align-items: center; gap: 6px; min-width: 0; }
+.mx-name { flex: 0 0 104px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; font-size: 13px; }
+.mx-ctl select.mx-ver { flex: 0 0 150px; width: 150px; min-width: 0; height: 26px; padding: 2px 6px; font-size: 12px; }
+.mx-rest-say { flex: 0 0 150px; font-size: 12px; color: var(--dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.mx-ms { flex: none; width: 24px; height: 24px; padding: 0; border: 1px solid var(--line); border-radius: 4px; background: transparent; color: var(--muted); font: 600 11px/1 monospace; cursor: pointer; }
+.mx-ms.is-on { background: var(--amber); color: var(--on-amber); border-color: var(--amber); }
+.mx-ms.mx-solo.is-on { background: var(--patina, #6a9f8f); border-color: var(--patina, #6a9f8f); color: var(--ground); }
+.mx-fader { display: flex; align-items: center; gap: 4px; flex: 0 0 150px; }
+.mx-fader input { width: 90px; }
+.mx-fader output { font-size: 11px; color: var(--muted); width: 56px; text-align: right; }
+.mx-knob { display: flex; align-items: center; gap: 2px; flex: none; font-size: 11px; color: var(--dim); }
+.mx-knob input { width: 42px; }
+#dawPanel input[type="range"] { accent-color: var(--amber); }
+.mx-wave { position: relative; height: 34px; min-width: 0; cursor: crosshair; transition: height .12s ease; }
+.mx-lane.is-open .mx-wave { height: 68px; }
+.mx-wave canvas { display: block; --mx-wave: var(--amber); --mx-quiet: rgba(0, 0, 0, .55); }
+.mx-head-line { position: absolute; top: 0; bottom: 0; width: 1px; background: var(--ink); opacity: .75; pointer-events: none; }
+.mx-note { margin: 0; }
+
+/* HERESY 1473: a selection standing on All Workspaces says so in the bar */
+#collSelCount.is-all { color: var(--bad, #e06c5a); }
+
