+  // ---- HERESY 1067: the history, a card a run (as the Collection's cards are for takes): what it was
+  // given, what it did (the curves, the time, the memory), and its epochs, each one a LoRA on a click
+  function when(t) { var d = new Date((t || 0) * 1000); return t ? d.toLocaleDateString() + " " + d.toTimeString().slice(0, 5) : ""; }
+  function span(sec) { sec = Math.round(sec || 0); var h = Math.floor(sec / 3600), m = Math.floor(sec % 3600 / 60); return h ? h + " h " + m + " min" : m + " min"; }
+  function chart(ser) {
+    var lines = [["loss", "var(--amber)", "flow loss (NAR)"], ["ar_ce", "var(--accent, #6aa9ff)", "ar_ce (AR)"]].filter(function (l) { return ser[l[0]] && ser[l[0]].curve.length > 1; });
+    if (!lines.length) return "";
+    var W = 320, H = 70, last = 0;
+    lines.forEach(function (l) { var c = ser[l[0]].curve; last = Math.max(last, c[c.length - 1][0]); });
+    var paths = lines.map(function (l) {
+      var c = ser[l[0]].curve, lo = Infinity, hi = -Infinity;
+      c.forEach(function (p) { lo = Math.min(lo, p[1]); hi = Math.max(hi, p[1]); });
+      if (hi === lo) hi = lo + 1;
+      var dd = c.map(function (p, i) { return (i ? "L" : "M") + (W * p[0] / last).toFixed(1) + " " + (H - 4 - (H - 8) * (p[1] - lo) / (hi - lo)).toFixed(1); }).join(" ");
+      return '<path d="' + dd + '" fill="none" stroke="' + l[1] + '" stroke-width="1.4" vector-effect="non-scaling-stroke"><title>' + l[2] + ": " + lo.toFixed(3) + " … " + hi.toFixed(3) + "</title></path>";
+    }).join("");
+    return '<svg class="tr-chart" viewBox="0 0 ' + W + " " + H + '" preserveAspectRatio="none">' + paths + "</svg>" +
+      '<div class="tr-legend">' + lines.map(function (l) { var x = ser[l[0]]; return '<span><i style="background:' + l[1] + '"></i>' + l[2] + " " + x.first.toFixed(3) + " → " + x.last.toFixed(3) + " (min " + x.min.toFixed(3) + ")</span>"; }).join("") + "</div>";
+  }
+  function card(r) {
+    var o = r.options || {}, ser = r.series || {}, cks = r.checkpoints || [];
+    var took = (r.ended || (r.status === "running" ? Date.now() / 1000 : r.started)) - r.started;
+    var ar = ser.ar_ce ? ser.ar_ce.last : r.ar_ce, memo = ar != null && ar < 0.3;
+    var bytes = cks.reduce(function (s, c) { return s + (c.bytes || 0); }, 0);
+    return '<article class="tr-card is-' + esc(r.status) + '">' +
+      '<div class="tr-chead"><b>' + esc(r.name) + '</b><span class="tr-st is-' + esc(r.status) + '">' + esc(r.status) + "</span>" + (r.kind ? '<span class="tr-tag">' + esc(r.kind) + "</span>" : "") +
+        '<span class="spacer"></span><span class="tr-when">' + esc(when(r.started)) + " · " + span(took) + "</span></div>" +
+      '<div class="tr-facts">' +
+        "<span><em>set</em> " + esc(r.dataset) + (r.tracks ? " · " + r.tracks + " tracks" : "") + "</span>" +
+        "<span><em>steps</em> " + (r.step || 0) + " / " + (r.steps || "?") + (r.tracks ? " · epoch " + ((r.step || 0) / r.tracks).toFixed(1) + " / " + (r.steps / r.tracks).toFixed(0) : "") + "</span>" +
+        "<span><em>rank</em> " + esc(o.rank) + " · lr " + esc(o.lr) + "</span>" +
+        "<span><em>AR</em> " + esc(o.ar_loss_weight) + " · KL " + esc(o.ar_kl_weight) + " · ×" + esc(o.ar_lr_multiplier) + "</span>" +
+        "<span><em>mode</em> " + esc(o.cot) + " · " + esc(o.quant) + (o.do_separation ? " · separated" : "") + "</span>" +
+        (ser.sec_per_step ? "<span><em>speed</em> " + ser.sec_per_step + " s/step</span>" : "") +
+        (r.vram_peak_mb ? "<span><em>VRAM</em> " + (r.vram_peak_mb / 1024).toFixed(1) + " GB peak · GPU" + esc(r.gpu) + "</span>" : r.gpu != null ? "<span><em>GPU</em> " + esc(r.gpu) + "</span>" : "") +
+      "</div>" +
+      (memo ? '<p class="tr-err">ar_ce ' + ar.toFixed(3) + ": the AR is learning the songs by heart; an earlier epoch may be the better adapter</p>" : "") +
+      (ser.error ? '<p class="tr-err">' + esc(ser.error) + "</p>" : "") + chart(ser) +
+      (r.error ? '<p class="tr-err">' + esc(r.error) + "</p>" : "") +
+      (cks.length ? '<div class="tr-epochs"><span class="label">epochs · ' + cks.length + " saved · " + gb(bytes) + "</span>" + cks.map(function (c) {
+        return '<button type="button" class="coll-chip' + (c.lora ? " is-on" : "") + '" data-pub="' + esc(r.name) + '" data-file="' + esc(c.file) + '" data-tip="step ' + c.step + " · " + when(c.saved) +
+          (c.lora ? " · in loras/ as " + esc(c.lora) : " · click: into loras/, ready in Create") + '">' + (c.epoch != null ? "e" + Math.round(c.epoch) : "final") + (c.lora ? " ✓" : "") + "</button>";
+      }).join("") + "</div>" : "") +
+      '<div class="tr-cacts">' + (r.lora ? "<code>loras/" + esc(r.lora) + "</code>" : "") + '<span class="spacer"></span>' +
+        '<a class="btn ghost small" href="/lab/train/log?name=' + encodeURIComponent(r.name) + '" target="_blank" rel="noopener">Log</a>' +
+        '<button type="button" class="btn ghost small" data-watch="' + esc(r.name) + '">Watch</button></div>' +
+      "</article>";
+  }
+  function publish(name, file) {
+    api("/train/publish", { name: name, file: file }).then(function (d) { toast("In loras/: " + d.lora); load(); }).catch(function (e) { toast(e.message, true); });
   }
 
   // ---- step 1: the raw tracks
@@ -114,10 +161,13 @@
     var set = (document.querySelector('input[name="trSet"]:checked') || {}).value;
     if (!set) return toast("Pick a set (step 2)", true);
     var spec = { dataset: set, name: slug($("trRunName").value || set + "-" + state.kind) };
-    ["steps", "rank", "lr", "ar_loss_weight", "ar_kl_weight", "ar_lr_multiplier"].forEach(function (k) { spec[k] = parseFloat($("tr_" + k).value); });
+    spec.kind = state.kind;
+    ["steps", "save_epochs", "rank", "lr", "ar_loss_weight", "ar_kl_weight", "ar_lr_multiplier"].forEach(function (k) { spec[k] = parseFloat($("tr_" + k).value); });
     spec.cot = $("tr_cot").value; spec.quant = $("tr_quant").value; spec.do_separation = $("tr_sep").checked;
-    window.HeresyDialog.confirm("Train " + spec.name + "?\n\n" + spec.steps + " steps on " + set + ", rank " + spec.rank + ", AR weight " + spec.ar_loss_weight +
-      ". It takes a GPU of its own for hours; the first run also fetches Comfy-Org's YuE2 weights.", { ok: "Train" }).then(function (ok) {
+    var tracks = ((state.data.prepared || []).filter(function (p) { return p.name === set; })[0] || {}).tracks || 1;
+    var epochs = Math.ceil(spec.steps / tracks);
+    window.HeresyDialog.confirm("Train " + spec.name + "?\n\n" + epochs * tracks + " steps (" + epochs + " epochs of " + tracks + " tracks) on " + set + ", rank " + spec.rank + ", AR weight " + spec.ar_loss_weight +
+      "; a checkpoint every " + (spec.save_epochs > 1 ? spec.save_epochs + " epochs" : "epoch") + ", all kept. It takes a GPU of its own for hours; the first run also fetches Comfy-Org's YuE2 weights.", { ok: "Train" }).then(function (ok) {
       if (!ok) return;
       return api("/train/run", spec).then(function () { toast("Training " + spec.name); watch(spec.name); load(); });
     }).catch(function (e) { toast(e.message, true); });
@@ -167,7 +217,11 @@
       window.HeresyDialog.confirm("Stop " + state.run + "?\n\nAI-Toolkit saves what it has on the way out; the last checkpoint goes to loras/.", { ok: "Stop", danger: true })
         .then(function (ok) { if (ok) return api("/train/stop", { name: state.run }).then(function () { toast("Stopping " + state.run); }); }).catch(function (e) { toast(e.message, true); });
     });
-    $("trRuns").addEventListener("click", function (e) { var b = e.target.closest("[data-watch]"); if (b) watch(b.dataset.watch); });
+    $("trRuns").addEventListener("click", function (e) {
+      var b = e.target.closest("[data-watch]"), p = e.target.closest("[data-pub]");
+      if (b) watch(b.dataset.watch);
+      if (p && !p.classList.contains("is-on")) publish(p.dataset.pub, p.dataset.file);
+    });
     setKind("style");
   }
 
