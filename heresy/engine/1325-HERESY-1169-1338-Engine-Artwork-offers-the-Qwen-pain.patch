Viktor 10.10.2026: «И в настройках движка, в Engine не забудь прописать выборы всех генеративных art моделей. Там только qwen сейчас.»; the plan he took the same day: «Автообложки дублей с Lightning».

Engine → Artwork lists, beside Krea 2 Muse and SDXL, the Qwen painters this machine has, as the Artist room lists them: Qwen-Image 2512 Q4 and Q6 with Lightning, each fp8 fine-tune in artwork/Qwen-Image-2512/checkpoints/ its own line, Qwen-Image 2.1 with its licence said (not for a song that is sold); each line says its room and its time; one not here is not offered; a choice made before comes back when its line does. The take's artwork then asks the lab for it by name (a fine-tune as «qwen2512-fp8:FILE»). The note under the choice says what Lightning and 2.1's licence mean.

Suite: 621/0 in the kitchen.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/console/app.js     | 25 +++++++++++++++++++++++++
 tools/console/index.html |  2 +-
 2 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/tools/console/app.js b/tools/console/app.js
index 9a28ee6..369e73c 100644
--- a/tools/console/app.js
+++ b/tools/console/app.js
@@ -5499,6 +5499,31 @@
       store("yue2.artPainter", this.value || null);
       toast(this.value ? "Artwork from now on: " + this.options[this.selectedIndex].textContent : "Artwork: the painter by the cards");
     });
+    // HERESY 1338 (Viktor 10.10.2026: «в Engine не забудь прописать выборы всех генеративных art моделей»): the Qwen painters this
+    // machine has, as the Artist room lists them, a cover painted with Lightning; each fine-tune of 2512 its own line
+    var SPEED = { "qwen2512-q4": "about 30 s a picture", "qwen2512-q6": "about 30 s a picture", "qwen2512-fp8": "about 40 s a picture", "qwen21": "about 2 min a picture" };
+    function qwenRows(list) {
+      var have = {};
+      Array.prototype.forEach.call(sel.options, function (o) { have[o.value] = 1; });
+      (list || []).forEach(function (p) {
+        if (!/^qwen/.test(p.key) || !p.ready) return;
+        var tail = (p.key === "qwen21" ? " · not for a song that is sold" : p.lightning ? " · Lightning" : " · without Lightning (its file is not here): slow") +
+          " · about " + Math.round((+p.need_mb || 0) / 1024) + " GB · " + SPEED[p.key];
+        var rows = p.key === "qwen2512-fp8" ? (p.models || []).map(function (m) { return [p.key + ":" + m, "Qwen-Image 2512 · " + m.replace(/\.safetensors$/, "") + tail]; })
+          : [[p.key, p.label + tail]];
+        rows.forEach(function (r) {
+          if (have[r[0]]) return;
+          var o = document.createElement("option");
+          o.value = r[0];
+          o.textContent = r[1];
+          sel.appendChild(o);
+        });
+      });
+      var want = recall("yue2.artPainter") || "";      // a Qwen painter chosen before: its line is here now
+      if (want && sel.value !== want && Array.prototype.some.call(sel.options, function (o) { return o.value === want; })) sel.value = want;
+    }
+    window.ruachArtPainters = function (list) { qwenRows(list); return Array.prototype.map.call(sel.options, function (o) { return [o.value, o.textContent]; }); };   // for the checks
+    api("/lab/artist/painters").then(function (d) { qwenRows(d && d.painters); }).catch(function () { /* the lab later: Krea and SDXL stand */ });
   })();
   function drawArt(name, again, quiet) {
     var take = findTake(name), title = take ? displayTitle(take) : name;
diff --git a/tools/console/index.html b/tools/console/index.html
index a0d6096..aaa3c3c 100644
--- a/tools/console/index.html
+++ b/tools/console/index.html
@@ -350,7 +350,7 @@ Blend · an add-on: two thirds Standard, one third Legacy"></select></label>
         </select></label>
       <p class="row-hint">Krea 2 Muse by <a href="https://civitai.com/models/2741166" target="_blank" rel="noopener noreferrer">Stable Yogi</a>, a fine-tune of
         <a href="https://krea.ai/krea-2-licensing" target="_blank" rel="noopener noreferrer">Krea 2</a> (Krea 2 Community License: its pictures pass a content filter);
-        SDXL: CyberRealistic XL by Cyberdelia. Times on an RTX 3090, the prompt and the look-over not counted.</p>
+        SDXL: CyberRealistic XL by Cyberdelia. Qwen-Image 2512 (Apache-2.0) paints a cover with Lightning (lightx2v, Apache-2.0) when its file is here; Qwen-Image 2.1 is under Qwen's research licence: research and evaluation only, not for a song that is sold. Times on an RTX 3090, the prompt and the look-over not counted.</p>
     </div>
 
     <div class="card wide lora-card eg-vae">
