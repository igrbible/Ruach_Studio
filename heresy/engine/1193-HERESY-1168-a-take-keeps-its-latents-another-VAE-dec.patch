     auto                  started = std::chrono::steady_clock::now();
@@ -1601,6 +1701,7 @@ static void run_job(std::shared_ptr<Job> job, Yue2Request request) {
                                             (int) t / M, (int) t % M, !request.abc.empty(), render_seconds);
             if (!name.empty()) {
                 job->takes.push_back(name);
