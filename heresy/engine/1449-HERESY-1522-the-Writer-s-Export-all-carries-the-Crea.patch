diff --git a/tools/console/heresy-i18n-be.js b/tools/console/heresy-i18n-be.js
index b5b5327..51a723c 100644
--- a/tools/console/heresy-i18n-be.js
+++ b/tools/console/heresy-i18n-be.js
@@ -5588,5 +5588,9 @@ RuachI18n.add("be", {
 "Back to the last quarter-minute mark (0:15, 0:30…). The ← key: to the last 5 s mark": "Назад да апошняй пазнакі чвэрці хвіліны (0:15, 0:30…). Клавіша ←: да апошняй пазнакі 5 с",
 "Same as the text": "Як у тэксту",
 "Up to three parts of the frame, each with words of its own: at every step the painter is asked once more for each region, with the prompt and the region's words, and the answers are blended by soft-edged boxes (Latent Couple's way). Each region costs a whole pass more a step. Qwen-Image 2512": "Да трох частак кадра, у кожнай свае словы: на кожным кроку мастака пытаюцца яшчэ раз пра кожны рэгіён, з промптам і словамі рэгіёна, і адказы змешваюцца мяккімі рамкамі (як у Latent Couple). Кожны рэгіён каштуе цэлага лішняга праходу на крок. Qwen-Image 2512",
-"The score written in {0} (it came as {1}): the same notes, spelled as the engine sings them": "Партытура запісана ў {0} (прыйшла як {1}): тыя ж ноты, запісаныя так, як іх спявае рухавік"
+"The score written in {0} (it came as {1}): the same notes, spelled as the engine sings them": "Партытура запісана ў {0} (прыйшла як {1}): тыя ж ноты, запісаныя так, як іх спявае рухавік",
+"Export all: every document of the Writer, with its versions, the takes made from it and its trash, and the Creator's versions of every title, in one file (a backup)": "Экспарт усяго: кожны дакумент Пісьменніка з яго версіямі, створанымі з яго сэмпламі і кошыкам, і версіі Творцы па кожнай назве, у адным файле (рэзервовая копія)",
+"Import a Writer backup: what is missing here comes in; the same is left alone; a document that differs from its namesake here comes in beside it as a copy; a title of the Creator's versions here gains the versions it lacks. Nothing here is written over": "Імпарт рэзервовай копіі Пісьменніка: чаго тут няма, прыходзіць; тое ж самае застаецца як ёсць; дакумент, што адрозніваецца ад свайго цёзкі тут, становіцца побач копіяй; назва з версій Творцы атрымлівае версіі, якіх бракуе. Нічога тут не перазапісваецца",
+"Writer backup: {0} documents and {1} in the trash, the Creator's versions of {2} titles, into {3}": "Рэзервовая копія Пісьменніка: дакументаў {0}, у кошыку {1}, версіі Творцы па назвах: {2}, у {3}",
+"the Creator's versions: {0} new, {1} titles new": "версіі Творцы: новых {0}, новых назваў {1}"
 });
