Subject: [PATCH 1298/1364] =?UTF-8?q?HERESY=201169=20=C2=B7=201309:=20the?=
 =?UTF-8?q?=20take's=20cover=20as=20the=20Artist's=20reference=20at=20a=20?=
 =?UTF-8?q?click?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Viktor 10.10.2026: «Артиста по модели InvokeAI постарайся на максимум вывести со всем возможным ахуем».

«The take's cover» in the reference's place, shown when the take picked on the right has one (the head repaints it as covers come and go; .btn's display gave way to [hidden] by a rule of its own): a click reads the cover as the player has it into the reference. With «Paint around it» a square cover becomes a 16:9 for the take's video or a 9:16 for a short; with «Mask…» a part of it is repainted.

Suite: 562/0 in the kitchen.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/console/app.css          |  1 +
 tools/console/heresy-artist.js | 14 ++++++++++++++
 tools/console/index.html       |  1 +
 3 files changed, 16 insertions(+)

diff --git a/tools/console/app.css b/tools/console/app.css
index 4eac8b7..a28664c 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -4779,6 +4779,7 @@ body[data-tab="artist"] .col-grip.left { display: none; }
 .ar-ref-empty .row-hint { margin: 0; flex: 1 1 200px; }
 .ar-ref-empty[hidden] { display: none; }                  /* its flex beat the attribute: the empty words stayed beside the picture */
 .ar-ref-pick { cursor: pointer; }
+#arRefTake[hidden] { display: none; }                    /* HERESY 1309: .btn's display beats the attribute */
 .ar-ref-on { display: grid; grid-template-columns: 72px minmax(0, 1fr) auto; gap: 10px; align-items: center; }
 .ar-ref-on[hidden] { display: none; }
 .ar-ref-on img { width: 72px; height: 72px; object-fit: cover; border-radius: var(--r-sm, 6px); background: var(--ground); }
diff --git a/tools/console/heresy-artist.js b/tools/console/heresy-artist.js
index 7beee43..3850a07 100644
--- a/tools/console/heresy-artist.js
+++ b/tools/console/heresy-artist.js
@@ -335,10 +335,22 @@
   function setTake(take) {
     state.take = take && take.name ? take : null;
     paintHead();
+    paintRefTake();                                    // HERESY 1309
     if (state.runs.length) paintRuns();     // «Set as cover» names the take
   }
   function hasArt(name) { return !!(state.hooks && state.hooks.artUrl && state.hooks.artUrl(name)); }
+  // HERESY 1309: the take's cover as the reference, at a click, when the take picked on the right has one
+  function paintRefTake() { var b = $("arRefTake"); if (b) b.hidden = !(state.take && hasArt(state.take.name)); }
+  function refFromTake() {
+    var take = state.take, url = take && hasArt(take.name) && state.hooks.artUrl(take.name);
+    if (!url) return toast(tr("Pick a take with a cover on the right first"), "bad");
+    fetch(url).then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.blob(); }).then(function (b) {
+      var f = new File([b], (take.label || take.name) + ".jpg", { type: b.type || "image/jpeg" });
+      refFromFile(f);
+    }).catch(function (e) { toast(tr("The cover could not be read:") + " " + e.message, "bad"); });
+  }
   function paintHead() {
+    paintRefTake();                                  // HERESY 1309: the take may have a cover now, or none
     var t = state.take;
     $("arTake").textContent = t ? t.label || t.name : "";
     $("arTakeNote").textContent = t ? (hasArt(t.name) ? tr("its cover can be one of these") : tr("no cover yet: give it one of these")) : tr("pick a take on the right to give it a cover");
@@ -772,6 +784,8 @@
     $("arRefFile").addEventListener("change", function () { refFromFile(this.files && this.files[0]); this.value = ""; });
     $("arRefX").addEventListener("click", function () { setRef(null); });
     $("arMaskOpen").addEventListener("click", maskEditor);   // HERESY 1306
+    $("arRefTake").addEventListener("click", refFromTake);   // HERESY 1309
+    paintRefTake();
     document.addEventListener("keydown", function (e) { if (e.key === "Escape" && state.cmpA) { compareOff(); toast(tr("No comparing")); } });   // HERESY 1308
     $("arRefFit").addEventListener("change", paintRefSay);    // HERESY 1307
     var refBox = $("arRef");
diff --git a/tools/console/index.html b/tools/console/index.html
index a71dd71..967685a 100644
--- a/tools/console/index.html
+++ b/tools/console/index.html
@@ -1466,6 +1466,7 @@ Blend · an add-on: two thirds Standard, one third Legacy"></select></label>
       <div class="ar-ref" id="arRef" tabindex="-1">
         <div class="ar-ref-empty" id="arRefEmpty"><span class="label">Reference picture <em>paint from it, as image to image</em></span>
           <span class="row-hint">drop a picture here, paste one (Ctrl+V), or take the stage's with «As reference»</span>
+          <button type="button" class="btn ghost small" id="arRefTake" hidden data-tip="The cover of the take picked on the right as the reference: with «Paint around it» it becomes a 16:9 for the video or a 9:16 for a short">The take's cover</button>   <!-- HERESY 1309 -->
           <label class="btn ghost small ar-ref-pick">Choose…<input type="file" id="arRefFile" accept="image/png,image/jpeg,image/webp" hidden data-tip="A PNG, JPEG or WebP picture of your own to paint from" /></label></div>
         <div class="ar-ref-on" id="arRefOn" hidden>
           <span class="ar-ref-pic"><img id="arRefImg" alt="" draggable="false" /><canvas id="arRefMask" hidden aria-hidden="true"></canvas></span>
