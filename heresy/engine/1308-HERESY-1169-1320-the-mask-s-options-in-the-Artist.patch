Content-Transfer-Encoding: 8bit

Viktor 10.10.2026: «По маске не хватает добавления латентного зерна поверх непрорисовываемых частей, блюра по краям маски».

Under the reference, when a mask is on or «Paint around it»: Grow (px, negative shrinks), Edge (the blur of its edge), Soft (differential diffusion: a grey edge changes only in the last steps) and Grain (the share of the painting the kept part takes); kept in this browser; Draw carries them, Again takes the run's own.

Suite: 578/0 in the kitchen.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/console/app.css          |  6 ++++++
 tools/console/heresy-artist.js | 21 +++++++++++++++++++++
 tools/console/index.html       |  7 +++++++
 3 files changed, 34 insertions(+)

diff --git a/tools/console/app.css b/tools/console/app.css
index 11e444a..d0a89c9 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -4587,6 +4587,12 @@ body[data-frame] :is(#view-compose, #view-take) { scrollbar-gutter: stable; }
 .tr-voice-opts { display: inline-flex; gap: 4px; }
 .tr-voice .tr-chip { padding: 2px 9px; }
 .tr-voice .tr-chip.is-on { border-color: var(--amber); color: var(--amber); }
+/* HERESY 1320: the mask's options under the reference */
+.ar-mask-opts { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: flex-end; gap: 8px 12px; padding-top: 8px; }
+.ar-mask-opts[hidden] { display: none; }
+.ar-mask-opts .field { margin: 0; }
+.ar-mask-opts input[type="number"] { width: 5em; }
+.ar-mask-opts .check { align-self: center; margin-bottom: 4px; }
 /* HERESY 1319: the sampling, folded, its values in the summary */
 .ar-sampling { flex: 1 1 100%; border: 1px solid var(--line-a); border-radius: var(--r-sm); padding: 4px 8px; }
 .ar-sampling > summary { cursor: pointer; display: flex; align-items: baseline; gap: 8px; padding: 2px 0; list-style: none; }
diff --git a/tools/console/heresy-artist.js b/tools/console/heresy-artist.js
index ac11ae5..e377da6 100644
--- a/tools/console/heresy-artist.js
+++ b/tools/console/heresy-artist.js
@@ -190,11 +190,27 @@
     var fit = $("arRefFit") && $("arRefFit").checked;   // HERESY 1307: painting around: the edges from the noise, the middle kept
     $("arRefSay").textContent = fit ? tr("the edges painted anew") : (+$("arRefStr").value).toFixed(2);
     $("arRef").classList.toggle("is-fit", !!fit);
+    if ($("arMaskOpts")) $("arMaskOpts").hidden = !(state.ref && (state.mask || fit));   // HERESY 1320: the mask's options when there is one
+  }
+  // HERESY 1320 (Viktor 10.10.2026: «По маске не хватает добавления латентного зерна поверх непрорисовываемых частей, блюра по краям
+  // маски»): the mask's options, kept in this browser
+  function maskOpts() {
+    return { grow: Math.max(-64, Math.min(128, Math.round(+$("arMkGrow").value || 0))), edge: Math.max(0, Math.min(96, Math.round(+$("arMkEdge").value || 0))),
+             soft: $("arMkSoft").checked, grain: Math.max(0, Math.min(0.6, +(+$("arMkGrain").value || 0).toFixed(2))) };
+  }
+  function keepMaskOpts() { keep("yue2.arMaskOpts", JSON.stringify(maskOpts())); }
+  function loadMaskOpts() {
+    var o = null;
+    try { o = JSON.parse(recall("yue2.arMaskOpts") || "null"); } catch (e) { o = null; }
+    if (!o) return;
+    $("arMkGrow").value = String(o.grow || 0); $("arMkEdge").value = String(o.edge != null ? o.edge : 24);
+    $("arMkSoft").checked = o.soft !== false; $("arMkGrain").value = String(o.grain != null ? o.grain : 0.1);
   }
   // HERESY 1306 (Viktor: «Артиста по модели InvokeAI постарайся на максимум вывести»): a mask on the reference, as InvokeAI's
   // inpaint: white repaints, the rest stays; state.mask {data} at the reference's own size; its red over the thumbnail
   function setMask(m) {
     state.mask = m || null;
+    if ($("arMaskOpts")) $("arMaskOpts").hidden = !(state.ref && (state.mask || ($("arRefFit") && $("arRefFit").checked)));   // HERESY 1320
     var c = $("arRefMask"), b = $("arMaskOpen");
     if (b) { b.classList.toggle("is-on", !!m); b.textContent = tr(m ? "Mask ✓" : "Mask…"); }
     if (!c) return;
@@ -380,6 +396,8 @@
     else if (!again && state.ref) { body.ref = state.ref.data || { id: state.ref.id, file: state.ref.file }; body.strength = +$("arRefStr").value; }
     if (again && again.ref && again.mask) body.mask = { id: again.id, file: again.mask };   // HERESY 1306: Again repaints by the run's own
     if (!again && state.ref && state.mask) body.mask = state.mask.data;
+    if (again && again.mask_opts) body.mask_opts = again.mask_opts;     // HERESY 1320
+    else if (!again && state.ref && (state.mask || $("arRefFit").checked)) body.mask_opts = maskOpts();
     if (!again && state.ref && $("arRefFit").checked) body.fit = true;   // HERESY 1307: painted around
     body.preview = $("arLive").checked;                 // HERESY 1257: each step's picture while it paints
     if (state.take) body.take = state.take.name;
@@ -1078,6 +1096,8 @@
     paintRefTake();
     document.addEventListener("keydown", function (e) { if (e.key === "Escape" && state.cmpA) { compareOff(); toast(tr("No comparing")); } });   // HERESY 1308
     $("arRefFit").addEventListener("change", paintRefSay);    // HERESY 1307
+    loadMaskOpts();                                     // HERESY 1320
+    ["arMkGrow", "arMkEdge", "arMkSoft", "arMkGrain"].forEach(function (id) { $(id).addEventListener("change", keepMaskOpts); });
     var refBox = $("arRef");
     ["dragenter", "dragover"].forEach(function (k) { refBox.addEventListener(k, function (e) { if (e.dataTransfer && Array.prototype.indexOf.call(e.dataTransfer.types || [], "Files") >= 0) { e.preventDefault(); refBox.classList.add("is-over"); } }); });
     ["dragleave", "drop"].forEach(function (k) { refBox.addEventListener(k, function () { refBox.classList.remove("is-over"); }); });
@@ -1150,6 +1170,7 @@
   // HERESY 1271: the room entered, the stage follows a painting run again (the picture picked stays picked otherwise)
   window.HeresyArtistRef = { set: setRef, get: function () { return state.ref; }, fromFile: refFromFile,   // HERESY 1305: for the checks
     mask: function () { return state.mask; }, editor: function () { return state.maskEditor; },     // 1306
+    setMask: function (m) { setMask(m); paintRefSay(); },                                            // 1320
     compare: function () { return state.compare; }, picking: function () { return !!state.cmpA; } };  // 1308
   window.HeresyArtist = { init: init, reload: function () { state.pinSel = false; paintHead(); return load(); }, setTake: setTake,
     loras: { reload: loadLoras, now: lorasNow, set: setLoras, open: openLoraLib, lib: function () { return state.loraLibOpen; } },   // HERESY 1316: for the checks
diff --git a/tools/console/index.html b/tools/console/index.html
index 16e7a19..95704e6 100644
--- a/tools/console/index.html
+++ b/tools/console/index.html
@@ -1477,6 +1477,13 @@ Blend · an add-on: two thirds Standard, one third Legacy"></select></label>
           </div>
           <span class="ar-ref-btns"><button type="button" class="btn ghost small" id="arMaskOpen" data-tip="Paint what of the picture to repaint (white repaints, the rest stays as it is): as inpainting">Mask…</button>
           <button type="button" class="pb-btn ar-ref-x" id="arRefX" aria-label="No reference picture" data-tip="No reference: paint from the noise">✕</button></span>
+          <!-- HERESY 1320: the mask's options -->
+          <div class="ar-mask-opts" id="arMaskOpts" hidden>
+            <label class="field"><span class="label">Grow</span><input type="number" id="arMkGrow" min="-64" max="128" step="4" value="0" data-tip="The mask grown by so many pixels (negative: shrunk), as ComfyUI's GrowMask: room for the new paint to meet the old" /></label>
+            <label class="field"><span class="label">Edge</span><input type="number" id="arMkEdge" min="0" max="96" step="4" value="24" data-tip="How soft the mask's edge is, in pixels: the new paint fades into the old over it" /></label>
+            <label class="check" data-tip="Soft repainting (differential diffusion, A1111's soft inpainting): where the edge is grey the picture changes only in the last steps, a little; no seam"><input type="checkbox" id="arMkSoft" checked /> Soft</label>
+            <label class="field"><span class="label">Grain</span><input type="number" id="arMkGrain" min="0" max="0.6" step="0.05" value="0.1" data-tip="How much of the painting the kept part takes, at each step and at the end: its grain and light sewn to the new paint (0 keeps it exactly)" /></label>
+          </div>
         </div>
       </div>
       <div class="ar-knobs">
