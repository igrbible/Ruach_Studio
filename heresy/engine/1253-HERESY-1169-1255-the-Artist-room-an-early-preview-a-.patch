+.ar-shape input { margin: 0; accent-color: var(--amber); }
+.ar-shape.is-on { border-color: var(--amber); color: var(--amber); background: color-mix(in srgb, var(--amber) 12%, transparent); }
+.ar-seed { width: 13.5em; flex: none; }
+.ar-seed-row { display: flex; gap: 6px; align-items: center; }
+.ar-count { width: 7.5em; flex: none; }
+.ar-painter { width: 17.5em; flex: none; }
+.ar-go { display: flex; align-items: center; gap: 12px; margin-left: auto; }
+.ar-go .row-hint { margin: 0; white-space: nowrap; }
+.ar-runs { display: flex; flex-direction: column; gap: 14px; margin: 16px 0 28px; }
+.ar-empty { margin: 8px 0; color: var(--dim); font-size: 13px; }
+.ar-run { border: 1px solid var(--line-a); border-radius: var(--r-lg); padding: 10px 12px 12px; background: var(--raise); }
+.ar-run.is-live { border-color: var(--amber-dim); }
+.ar-run-head { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-size: 12.5px; color: var(--muted); }
+.ar-when { color: var(--ink); font-variant-numeric: tabular-nums; }
+.ar-meta { color: var(--dim); font-variant-numeric: tabular-nums; }
+.ar-state.is-run, .ar-state.is-wait { color: var(--amber); }
+.ar-state.is-bad { color: var(--bad); }
+.ar-why { color: var(--dim); font-size: 12px; }
+.ar-acts { margin-left: auto; display: inline-flex; gap: 6px; }
+.ar-prompt { margin: 8px 0 10px; font-size: 13px; line-height: 1.45; color: var(--ink); cursor: pointer; overflow: hidden;
+  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
+.ar-prompt.is-open { display: block; -webkit-line-clamp: unset; }
+.ar-pics { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-start; }
+.ar-pic { margin: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
+.ar-thumb, .ar-pic .ar-gone { display: block; height: 200px; aspect-ratio: var(--ar, 1); padding: 0; overflow: hidden; background: var(--field);
+  border: 1px solid var(--line-a); border-radius: var(--r-md); cursor: zoom-in; }
+.ar-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
+.ar-thumb:hover, .ar-thumb:focus-visible { border-color: var(--amber); }
+.ar-pic .ar-gone { display: grid; place-items: center; padding: 10px; text-align: center; font-size: 12px; color: var(--dim); cursor: default; border-style: dashed; }
+.ar-pic.is-wait .ar-gone { animation: ar-pulse 1.6s ease-in-out infinite; }
+@keyframes ar-pulse { 50% { opacity: .5; } }
+.ar-pic figcaption { display: flex; align-items: center; gap: 6px; align-self: stretch; min-width: 0; font-size: 12px; color: var(--dim); }
+.ar-cap { margin-right: auto; font-variant-numeric: tabular-nums; white-space: nowrap; }
+.ar-dl { display: inline-grid; place-items: center; width: 26px; height: 26px; flex: none; color: var(--muted); border-radius: var(--r-sm); }
+.ar-dl:hover { color: var(--ink); background: var(--hover); }
+.ar-dl svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
+/* a picture over the page keeps its own shape (the takes' artwork is square) */
+.ar-view .art-fig { align-items: stretch; }
+.ar-view .art-img { aspect-ratio: auto; width: auto; height: auto; max-width: calc(100vw - 140px); max-height: calc(100vh - var(--playbar-h, 60px) - 96px); align-self: center; }
+.ar-view .art-cap { width: auto; }
+.ar-view .ar-cover { flex: none; }
