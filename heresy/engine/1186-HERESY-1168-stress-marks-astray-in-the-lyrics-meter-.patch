index 6645004..e6a6243 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -4208,3 +4208,11 @@ body[data-frame="compose"] #view-compose, body[data-frame="take"] #view-take {
   font: inherit; cursor: pointer; }
 .lyr-tog:hover { border-color: var(--hover-line, var(--line-strong)); color: var(--ink); }
 .lyr-tog[aria-pressed="true"] { border-color: var(--amber); color: var(--amber); }
+/* HERESY 1168 (Viktor: «проверку проёбов с x301»): the stress marks astray — a button under the box (red: off a vowel;
+   amber: two in one word) that goes to the next, and a mark before the line's syllable count */
+.lyr-tog.lyr-warn.bad { border-color: color-mix(in srgb, var(--bad) 55%, transparent); color: var(--bad); }
+.lyr-tog.lyr-warn.near { border-color: color-mix(in srgb, #d9a441 55%, transparent); color: #d9a441; }
+.lyr-tog.lyr-warn:hover { border-color: currentColor; }
+.lyr-x { margin-right: 3px; font: 700 14px/1 var(--sans); vertical-align: -3px; }
+.lyr-x.bad { color: var(--bad); }
+.lyr-x.near { color: #d9a441; }
