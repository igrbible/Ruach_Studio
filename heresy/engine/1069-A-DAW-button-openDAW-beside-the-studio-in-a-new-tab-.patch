Date: Fri, 2 Oct 2026 00:50:01 -0600
Subject: [PATCH 1069/1178] A DAW button: openDAW beside the studio in a new
 tab (shift-click: its address)

HERESY 1075. openDAW wants a secure origin: localhost through an ssh tunnel by default, or https.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/console/app.js          | 8 ++++++++
 tools/console/heresy-icons.js | 1 +
 tools/console/index.html      | 1 +
 3 files changed, 10 insertions(+)

diff --git a/tools/console/app.js b/tools/console/app.js
index 5120125..51c61d0 100644
--- a/tools/console/app.js
+++ b/tools/console/app.js
@@ -5192,6 +5192,14 @@
   });
 
   if (window.HeresyTrain) window.HeresyTrain.init({ toast: toast });   // HERESY 1063
+  // HERESY 1075: openDAW beside the studio (tools/serve-opendaw.py, the ruach-daw unit). It wants a secure origin:
+  // http://localhost:41880 through an ssh tunnel by default; shift-click sets another address, kept with the page.
+  if ($("dawOpen")) $("dawOpen").addEventListener("click", function (e) {
+    var url = recall("yue2.dawUrl") || "http://localhost:41880";
+    if (!e.shiftKey) return void window.open(url, "ruach-opendaw");
+    window.HeresyDialog.prompt("openDAW's address\n\nIt needs a secure origin: localhost through a tunnel\n(ssh -L 41880:127.0.0.1:41880 192.168.1.10) or https.", url, { ok: "Keep it" })
+      .then(function (v) { v = (v || "").trim(); if (v) { store("yue2.dawUrl", v); toast("openDAW at " + v); } });
+  });
   if (window.HeresyInstruments) window.HeresyInstruments.init({        // HERESY 1069: the ♪ cheat-sheet
     toast: toast, findTake: findTake, playNow: function (t) { STATE.playZone = "collection"; playNow(t); }
   });
