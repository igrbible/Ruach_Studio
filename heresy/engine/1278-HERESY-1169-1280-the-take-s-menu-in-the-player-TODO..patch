+    takeMenu(t.name, event.clientX, event.clientY);
+  }
+  $("wave").addEventListener("contextmenu", playerTakeMenu);
+  document.querySelector("#playbar .playbar-id").addEventListener("contextmenu", playerTakeMenu);
 
