diff --git a/tools/console/app.css b/tools/console/app.css
index de1b0e8..9af01e0 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -2773,3 +2773,10 @@ body[data-tab="train"] .playbar:hover, body[data-tab="train"] .playbar:focus-wit
 body[data-tab="train"] .playbar::before { content: ""; position: absolute; top: 2px; left: 50%; width: 48px; height: 3px; margin-left: -24px; border-radius: 2px; background: var(--line-strong); }
 body[data-tab="train"] .playbar:has(.play.is-playing)::before { background: var(--amber); width: 120px; margin-left: -60px; }
 body[data-tab="train"] .workspace { height: calc(100vh - 52px - 8px); }
+/* HERESY 1090: another run's curve beside this one's */
+.tr-plot path.cmp { fill: none; stroke: #4fa3c7; stroke-width: 1.8; stroke-dasharray: 5 4; vector-effect: non-scaling-stroke; }
+.tr-cmpkey { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; font-size: 11px; color: var(--muted); }
+.tr-cmpkey span { display: inline-block; width: 18px; height: 0; margin-left: 8px; border-top: 2px solid var(--ink); }
+.tr-chart[data-key="ar_ce"] .tr-cmpkey .k-this { border-top-color: var(--amber); }
+.tr-cmpkey .k-cmp { border-top: 2px dashed #4fa3c7; }
+.tr-cmp { width: auto; max-width: 260px; padding: 4px 26px 4px 8px; font-size: 12px; }
