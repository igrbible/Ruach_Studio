+            <label class="field ar-samp-num" id="arLightBox" hidden><span class="label">Lightning</span><input type="number" id="arLight" min="0" max="1.5" step="0.05" data-tip="Lightning's 8-step adapter for Qwen-Image 2512: 1.0 as its makers give it, lower for a fine-tune (0.55 with 12 steps, as Viktor paints); 0 turns it off: then 10 to 60 steps with guidance, about four times as long" /></label>
+            <label class="field ar-samp-num" id="arCfgBox" hidden><span class="label">Guidance</span><input type="number" id="arCfg" min="1" max="10" step="0.5" data-tip="Without Lightning: how closely the picture follows the prompt (true CFG, two passes a step); 4 is Qwen-Image's own" /></label>
+            <button type="button" class="btn ghost small" id="arSampReset" data-tip="The painter's own steps, sampler and schedule">Reset</button>
+          </div>
+        </details>
