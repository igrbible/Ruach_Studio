 tools/console/heresy-i18n-be.js | 8 ++++++--
 tools/console/heresy-i18n-el.js | 8 ++++++--
 tools/console/heresy-i18n-es.js | 8 ++++++--
 tools/console/heresy-i18n-it.js | 8 ++++++--
