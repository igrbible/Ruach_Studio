+        yyjson_mut_arr_add_real(doc, pt, std::round(p.second * 1000.0) / 1000.0);
+        yyjson_mut_arr_append(pts, pt);
+    }
+    yyjson_mut_obj_add_val(doc, item, "curve", pts);
+}
