+
+/* HERESY 1096: the guide */
+.guide-btn { min-width: 34px; height: 30px; padding: 0 9px; font: 600 15px/1 var(--sans); }
+.head-more-items .hm-text { gap: 10px; font-size: 13px; }
+.hm-glyph { display: inline-grid; place-items: center; width: 16px; font-weight: 700; }
+.hg-back { position: fixed; inset: 0; z-index: 150; display: flex; align-items: center; justify-content: center; padding: 3vh 3vw;
+  background: color-mix(in srgb, var(--ground) 55%, transparent); backdrop-filter: blur(3px); opacity: 0; transition: opacity .16s ease; }
+.hg-back.is-on { opacity: 1; }
+.hg-back[hidden] { display: none; }
+.hg-box { width: min(1180px, 100%); height: min(88vh, 980px); display: grid; grid-template-rows: auto auto minmax(0, 1fr); border: 1px solid var(--line);
+  border-radius: var(--r-md); background: var(--panel); box-shadow: 0 30px 80px -30px var(--shadow-lg, rgba(0,0,0,.45)); overflow: hidden; }
+.hg-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 18px 10px; }
+.hg-title { font: 500 20px/1.3 var(--heading); margin-right: 12px; }
+.hg-lead { font-size: 12.5px; color: var(--muted); }
+.hg-tabs { display: flex; flex-wrap: wrap; gap: 4px; padding: 0 16px 10px; border-bottom: 1px solid var(--line); }
+.hg-tabs button { padding: 6px 14px; border: 1px solid var(--line); border-radius: var(--r-pill); background: var(--panel); color: var(--ink); font: 500 13px var(--sans); cursor: pointer; }
+.hg-tabs button:hover { border-color: var(--line-strong); }
+.hg-tabs button.is-on { border-color: var(--amber); box-shadow: inset 0 0 0 1px var(--amber); color: var(--amber); }
+.hg-main { display: grid; grid-template-columns: 210px minmax(0, 1fr); min-height: 0; }
+.hg-stops { display: flex; flex-direction: column; gap: 2px; padding: 12px 8px; border-right: 1px solid var(--line-soft, var(--line)); overflow-y: auto; }
+.hg-stops button { text-align: left; padding: 5px 8px; border: 0; border-radius: var(--r-sm); background: none; color: var(--muted); font: 12.5px/1.35 var(--sans); cursor: pointer; }
+.hg-stops button:hover { background: var(--hover); color: var(--ink); }
+.hg-body { overflow-y: auto; padding: 8px 28px 40px; font-size: 14.5px; line-height: 1.6; color: var(--ink); }
+.hg-body h3 { margin: 26px 0 8px; font: 500 18px/1.35 var(--heading); scroll-margin-top: 10px; }
+.hg-body h4 { margin: 18px 0 6px; font-size: 14.5px; }
+.hg-body p { margin: 0 0 10px; max-width: 78ch; }
+.hg-body ul, .hg-body ol { margin: 0 0 12px; padding-left: 22px; max-width: 80ch; }
+.hg-body li { margin: 3px 0; }
+.hg-body code { font: 12.5px var(--mono); padding: 1px 5px; border-radius: 4px; background: var(--sunk); }
+.hg-body pre { padding: 10px 12px; border-radius: var(--r-sm); background: var(--sunk); overflow-x: auto; }
+.hg-body pre code { padding: 0; background: none; }
+.hg-body a { color: var(--amber); }
+.hg-note { margin: 10px 0 14px; padding: 10px 14px; border-left: 3px solid var(--amber); background: color-mix(in srgb, var(--amber) 7%, transparent); border-radius: 0 var(--r-sm) var(--r-sm) 0; max-width: 78ch; }
+.hg-table { border-collapse: collapse; margin: 6px 0 14px; font-size: 13.5px; }
+.hg-table th, .hg-table td { padding: 5px 14px 5px 0; border-bottom: 1px solid var(--line-soft, var(--line)); text-align: left; vertical-align: top; }
+.hg-table th { color: var(--dim); font-weight: 500; }
+.hg-fig { margin: 10px 0 18px; }
+.hg-fig img { display: block; max-width: 100%; height: auto; border: 1px solid var(--line); border-radius: var(--r-sm); cursor: zoom-in; box-shadow: 0 8px 24px -16px var(--shadow-lg, rgba(0,0,0,.35)); }
+.hg-fig figcaption { margin-top: 5px; font-size: 12px; color: var(--dim); }
+.hg-zoom { position: fixed; inset: 0; z-index: 160; display: flex; align-items: center; justify-content: center; padding: 2vh 2vw; background: rgba(0,0,0,.72); cursor: zoom-out; }
+.hg-zoom[hidden] { display: none; }
+.hg-zoom img { max-width: 100%; max-height: 100%; border-radius: 6px; box-shadow: 0 20px 60px rgba(0,0,0,.5); }
+@media (max-width: 900px) { .hg-main { grid-template-columns: minmax(0, 1fr); } .hg-stops { display: none; } }
+/* HERESY 1098: the Librarian's heading names the collection open */
+.coll-where { font-weight: 600; color: var(--amber); margin-left: 2px; }
+.coll-col .col-head h2 { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 60%; }
