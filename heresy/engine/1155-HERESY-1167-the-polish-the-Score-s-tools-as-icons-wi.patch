+
+/* HERESY 1167 (Viktor 05.10.2026): the interface's fine polish
+   · the bar's height as one value; tall (40 pt more, the logo with it) while the page stands at its top, where the logo shows
+     whole; its usual height once a room's column scrolls (app.js).
+     The height is the animated value itself, so the bar, the rooms under it, the sticky bands and the logo move as one: with
+     the bar animated alone, for its 0.22 s the page was taller than the window (a scrollbar came and went) or a gap opened.
+     A calmer page (html[data-motion="reduced"]) cuts it to nothing with every other transition. */
+@property --bar-h { syntax: "<length>"; inherits: true; initial-value: 52px; }
+:root { --bar-h: 52px; }
+@media (min-width: 1660px) { body.bar-tall { --bar-h: 105px; } }
+body { transition: --bar-h .22s ease; }
+@media (prefers-reduced-motion: reduce) { body { transition: none; } }
+/* · the cheat-sheet's lead paragraph across the sheet («убери ручные переносы строк. Пусть всё автоврепом идёт») */
+.hi-box > .row-hint { max-width: none; }
+/* · the Score's tools: icons where the icon says it, the paper and its side together */
+.score-head .icon-btn { display: inline-grid; place-items: center; padding: 4px 7px; }
+.score-head .icon-btn .ui-ico { width: 17px; height: 17px; }
+.score-print { display: inline-flex; align-items: center; gap: 2px; }
+.score-print select { width: auto; padding: 3px 6px; font-size: 12px; }
+.sheet-side[aria-pressed="true"] { color: var(--amber); border-color: var(--amber-dim); background: color-mix(in srgb, var(--amber) 9%, transparent); }
+#staffFull .ui-ico { width: 19px; height: 19px; stroke-width: 2.3; }
+.score-from-sound { margin: 0 0 8px; max-width: none; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
+.score-from-sound .mono { color: var(--muted); }
+/* · the line between the Creator's two frames (from 1400 px); the takes wide (40 / 60): the form in one column */
+.k-vsplit { display: none; }
+@media (min-width: 1400px) {
+  body[data-tab="create"] .workspace { grid-template-columns: minmax(0, var(--k-l, 2fr)) minmax(0, var(--k-r, 1fr)); }
+  body[data-tab="create"] .workspace.lib-folded { grid-template-columns: minmax(0, var(--k-l, 2fr)) minmax(0, var(--k-r, 1fr)) 40px !important; }
+  body[data-tab="create"] .k-vsplit {
+    display: block; grid-column: 2; grid-row: 1 / 3; justify-self: start; align-self: stretch; position: relative;
+    width: 12px; margin-left: -6px; z-index: 8; cursor: col-resize; touch-action: none; outline: none;
+  }
+  body[data-tab="create"] .workspace.lib-folded .k-vsplit { grid-row: 1; }
+  body[data-tab="create"] .k-vsplit::after {
+    content: ""; position: absolute; top: 0; bottom: 0; left: 4px; width: 3px; border-radius: 2px; background: transparent; transition: background .15s;
+  }
+  body[data-tab="create"] .k-vsplit:hover::after, body[data-tab="create"] .k-vsplit:focus-visible::after,
+  body[data-tab="create"] .k-vsplit.is-dragging::after { background: var(--amber); }
+  body[data-tab="create"] .workspace.k-wide .compose { grid-template-columns: minmax(0, 1fr); }
+}
