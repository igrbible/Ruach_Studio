 .icon-check:has(input:focus-visible) { outline: 2px solid var(--amber); outline-offset: 1px; }
 @media (max-width: 1400px) { .coll-bulk { flex-wrap: wrap; } }
+
+/* HERESY 1169 · 1235 (Viktor 08.10.2026: «первая статичная строка фильтрации... сделай её ахуйной»): the filters as framed groups like the bar of the checked: a caption, then chips joined into one control, each an icon, its word and how many takes of this place it would show */
+.coll-filters { gap: 10px; }
+.coll-fgroup { display: inline-flex; align-items: stretch; flex: none; border: 1px solid var(--line-a); border-radius: var(--r-md); overflow: hidden; background: color-mix(in srgb, var(--ink) 2%, transparent); }
+.coll-fgroup > .coll-cap-inline { display: inline-flex; align-items: center; padding: 0 10px; border-right: 1px solid var(--line-a); font-size: 10.5px; letter-spacing: .09em; background: color-mix(in srgb, var(--ink) 5%, transparent); }
+.coll-fgroup .coll-chip, .coll-fgroup .coll-chip-ico { display: inline-flex; align-items: center; gap: 6px; padding: 5px 11px; border: 0; border-right: 1px solid var(--line-a); border-radius: 0; background: none; color: var(--muted); font-size: 12.5px; line-height: 18px; transition: background-color .12s ease, color .12s ease; }
+.coll-fgroup .coll-chip:last-child { border-right: 0; }
+.coll-fgroup .coll-chip:hover { background: color-mix(in srgb, var(--amber) 9%, transparent); color: var(--ink); }
+.coll-fgroup .coll-chip.is-on { background: color-mix(in srgb, var(--amber) 17%, transparent); color: var(--amber); box-shadow: inset 0 -2px 0 var(--amber); }
+.coll-fgroup .coll-chip svg { width: 15px; height: 15px; flex: none; display: block; }
+.coll-fn { min-width: 18px; padding: 0 5px; box-sizing: border-box; border-radius: 999px; font-size: 10.5px; line-height: 16px; text-align: center; font-variant-numeric: tabular-nums; color: var(--muted); background: color-mix(in srgb, var(--ink) 8%, transparent); }
+.coll-fgroup .coll-chip.is-on .coll-fn { color: var(--amber); background: color-mix(in srgb, var(--amber) 18%, transparent); }
+.coll-fgroup .coll-chip.is-none:not(:hover) { opacity: .5; }
+.coll-fclear[hidden] { display: none; }
