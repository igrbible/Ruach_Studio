index 1ff9172..4e43438 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -6243,3 +6243,12 @@ body.daw-full #dawPanel .mx-wave.mx-ruler { height: 22px; }
 .hc-on .field:has(> .hc-box), .nd-body .field:has(> .hc-box) { align-self: start; }
 .hc-list:empty::after { content: "\2014"; color: var(--dim); padding: 2px 6px; }
 
+/* HERESY 1527: a branch's Delete at the end of its head; the take's trash under its tree */
+.dv-group-head { display: flow-root; }   /* the float held in its head: a row under it keeps its whole width (1513's waves from one x to one x) */
+.dv-group-head .dv-del { float: right; margin: -3px 0 0 8px; opacity: .7; }
+.dv-group-head .dv-del:hover { opacity: 1; color: var(--bad); }
+.dv-trash { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; margin-top: 10px; padding-top: 8px; border-top: 1px dashed var(--line-a); }
+.dv-trash-row { display: flex; align-items: baseline; gap: 10px; width: 100%; padding: 3px 0; }
+.dv-trash-row .dv-name { flex: 1; min-width: 0; }
+.dv-trash .dv-empty { margin-top: 4px; }
