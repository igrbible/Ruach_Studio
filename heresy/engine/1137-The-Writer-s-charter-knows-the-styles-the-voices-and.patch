   var KEPT_NAMES = ["Instrumental Probe"];
-  var DATA = {"families":{"strings-plucked":"plucked strings","strings-bowed":"bowed strings","keys":"keys","winds-wood":"woodwinds","winds-brass":"brass and horns","winds-reed":"reeds and bagpipes","perc-drum":"drums","perc-tuned":"tuned percussion","perc-small":"small percussion","synth":"synths and electronics","voice":"voice-like","ensemble":"ensembles","other":"other"},"instruments":[{"slug":"duduk","family":"winds-reed","family_name":"reeds and bagpipes","home":"Armenia","tag":"duduk","en":"Apricot-wood double reed: a warm, nasal, mournful voice, often over a drone.","ru":"Абрикосовая дудка с двойной тростью: тёплый, носовой, скорбный голос, часто над бурдоном.","title":"Duduk","flag":"Heard: a real duduk, in full spectrum (the A/B of 03.10 in «💎 Instrumental Probe LoRA»); its own adapter: loras/duduk-yt-r16."},{"slug":"low-wooden-flute","family":"winds-wood","family_name":"woodwinds","home":"everywhere","tag":"low wooden flute","en":"A breathy, dark, low flute of wood: air as much as tone.","ru":"Низкая деревянная флейта: тёмная, с густым дыханием, воздуха в ней не меньше, чем тона.","title":"Low Wooden Flute","flag":""},{"slug":"shofar","family":"winds-brass","family_name":"brass and horns","home":"Israel","tag":"shofar (ram's horn)","en":"A ram's horn blown with the lips: two raw notes, blasts and broken calls, no melody.","ru":"Бараний рог, дуют губами: две сырые ноты, протяжные и прерывистые сигналы, мелодии нет.","title":"Shofar (Ram's Horn)","flag":"Probed many times, without success: YuE2 does not know the shofar. The probes always give another pipe or horn, never a shofar, not even close. Its probes (below) are kept: take one as the horn or trumpet it turned out to be. Its adapter knows it: loras/shofar-yt-r16 at epoch 110, Viktor's ear: «Mind-blowing: no shofar player has heard the like. A whole meditation. One hundred percent a Yemenite shofar, an antelope horn two metres long» (167 overtrained, weak and thin; 66 undertrained, a trumpet in it).","failed":true},{"slug":"kinnor-lyre","family":"strings-plucked","family_name":"plucked strings","home":"ancient Israel","tag":"kinnor lyre","en":"David's lyre: few gut strings, bright, dry, sparse plucked chords.","ru":"Лира Давида: несколько жильных струн, светлый сухой звук, редкие щипковые аккорды.","title":"Kinnor Lyre","flag":""},{"slug":"harp","family":"strings-plucked","family_name":"plucked strings","home":"everywhere","tag":"harp","en":"Concert harp: rippling glissandi and bell-like notes with a long ring.","ru":"Концертная арфа: переливы глиссандо и колокольные ноты с долгим звоном.","title":"Harp","flag":""},{"slug":"psaltery","family":"strings-plucked","family_name":"plucked strings","home":"Near East, medieval Europe","tag":"psaltery","en":"A box of many plucked strings: shimmering, harp-like, close and metallic.","ru":"Ящик с множеством щипковых струн: мерцающий, близкий к арфе, но металличнее.","title":"Psaltery","flag":""},{"slug":"frame-drum","family":"perc-drum","family_name":"drums","home":"Near East","tag":"frame drum","en":"A wide hand drum on a wooden frame: deep boom and dry finger slaps.","ru":"Широкий ручной бубен на деревянном обруче: глубокий удар и сухие шлепки пальцами.","title":"Frame Drum","flag":""},{"slug":"tambourine","family":"perc-small","family_name":"small percussion","home":"everywhere","tag":"tambourine","en":"Small frame drum with jingles: shakes, rolls and bright metal clatter.","ru":"Бубен с тарелочками: тряска, тремоло и светлый металлический звон.","title":"Tambourine","flag":""},{"slug":"finger-cymbals","family":"perc-small","family_name":"small percussion","home":"Near East","tag":"finger cymbals","en":"Tiny cymbals struck between fingers: high, pure, ringing chimes.","ru":"Крошечные тарелочки на пальцах: высокий чистый звон.","title":"Finger Cymbals","flag":""},{"slug":"oud","family":"strings-plucked","family_name":"plucked strings","home":"Middle East","tag":"oud","en":"Fretless short-necked lute: woody, round, sliding Arabic maqam lines.","ru":"Безладовая лютня: древесный круглый звук, скользящие мелодии арабских макамов.","title":"Oud","flag":""},{"slug":"qanun","family":"strings-plucked","family_name":"plucked strings","home":"Middle East","tag":"qanun","en":"A flat zither plucked with picks: fast, glittering runs and tremolos.","ru":"Плоская цитра, играют медиаторами на пальцах: быстрые искристые пассажи и тремоло.","title":"Qanun","flag":""},{"slug":"ney-flute","family":"winds-wood","family_name":"woodwinds","home":"Persia, Turkey","tag":"ney flute","en":"End-blown reed flute: breathy, hollow, spiritual, the Sufi sound.","ru":"Тростниковая продольная флейта: полая, с дыханием, суфийский звук.","title":"Ney Flute","flag":""},{"slug":"kaval","family":"winds-wood","family_name":"woodwinds","home":"Balkans","tag":"kaval","en":"Long open shepherd's flute: soft, airy low register with growled overtones.","ru":"Длинная пастушья флейта: мягкий воздушный низ с рычащими обертонами.","title":"Kaval","flag":""},{"slug":"zurna","family":"winds-reed","family_name":"reeds and bagpipes","home":"Turkey, Balkans","tag":"zurna","en":"Loud conical double reed: piercing, festive, outdoor and wild.","ru":"Громкий конический гобой: пронзительный, праздничный, уличный и дикий.","title":"Zurna","flag":""},{"slug":"darbuka","family":"perc-drum","family_name":"drums","home":"Middle East","tag":"darbuka","en":"Goblet drum: deep doum, sharp tek and fast rolls.","ru":"Кубковый барабан: глубокий «дум», резкий «тек» и быстрые дроби.","title":"Darbuka","flag":""},{"slug":"santur","family":"strings-plucked","family_name":"plucked strings","home":"Persia","tag":"santur","en":"Hammered dulcimer of Persia: shimmering, bell-like repeated notes.","ru":"Персидские цимбалы: мерцающие колокольные повторы нот.","title":"Santur","flag":""},{"slug":"bandura","family":"strings-plucked","family_name":"plucked strings","home":"Ukraine","tag":"bandura","en":"Ukraine's many-stringed lute-harp: bright, chiming, harp-like chords.","ru":"Украинская многострунная лютня-арфа: звонкая, светлая, аккорды как у арфы.","title":"Bandura","flag":""},{"slug":"trembita","family":"winds-brass","family_name":"brass and horns","home":"Carpathians","tag":"trembita (alpine horn)","en":"A wooden horn of the Hutsuls, metres long: low, raw calls with natural overtones.","ru":"Гуцульская деревянная труба в несколько метров: низкие сырые сигналы на натуральных обертонах.","title":"Trembita (Alpine Horn)","flag":""},{"slug":"hammered-dulcimer","family":"strings-plucked","family_name":"plucked strings","home":"Ukraine, Eastern Europe","tag":"hammered dulcimer (tsymbaly)","en":"Strings struck with hammers: bright, ringing, fast tremolos.","ru":"Цимбалы, струны бьют молоточками: яркий звон и быстрые тремоло.","title":"Hammered Dulcimer (Tsymbaly)","flag":""},{"slug":"sopilka","family":"winds-wood","family_name":"woodwinds","home":"Ukraine","tag":"sopilka (low)","en":"Ukrainian fipple flute: clear, folk, slightly breathy.","ru":"Украинская сопилка: ясный народный звук с лёгким дыханием.","title":"Sopilka (Low)","flag":""},{"slug":"sitar","family":"strings-plucked","family_name":"plucked strings","home":"India","tag":"sitar","en":"Long-necked lute with sympathetic strings: buzzing, bending, droning.","ru":"Длинногрифая лютня с резонансными струнами: жужжит, тянет ноты, гудит бурдоном.","title":"Sitar","flag":""},{"slug":"tanpura-drone","family":"strings-plucked","family_name":"plucked strings","home":"India","tag":"tanpura drone","en":"Four strings never stopped: a continuous, buzzing, shimmering drone.","ru":"Четыре струны без мелодии: сплошной жужжащий мерцающий бурдон.","title":"Tanpura Drone","flag":""},{"slug":"erhu","family":"strings-bowed","family_name":"bowed strings","home":"China","tag":"erhu","en":"Two-string fiddle: a singing, crying, voice-like slide.","ru":"Двуструнная скрипка: поющее, плачущее, почти голосовое скольжение.","title":"Erhu","flag":""},{"slug":"guzheng","family":"strings-plucked","family_name":"plucked strings","home":"China","tag":"guzheng","en":"Long zither with movable bridges: cascading plucks and bent notes.","ru":"Длинная цитра с подвижными подставками: каскады щипков и изогнутые ноты.","title":"Guzheng","flag":""},{"slug":"bansuri","family":"winds-wood","family_name":"woodwinds","home":"India","tag":"bansuri","en":"Bamboo side-blown flute: soft, breathy, ornamented, pastoral.","ru":"Бамбуковая поперечная флейта: мягкая, с дыханием и украшениями, пастушья.","title":"Bansuri","flag":""},{"slug":"didgeridoo","family":"winds-brass","family_name":"brass and horns","home":"Australia","tag":"didgeridoo","en":"A hollow log blown with buzzing lips: one low drone, rhythmic growls, circular breath.","ru":"Полое бревно, губы вибрируют: один низкий бурдон, ритмичное рычание, круговое дыхание.","title":"Didgeridoo","flag":"B: a strong shamanic vibe."},{"slug":"throat-singing-drone","family":"voice","family_name":"voice-like","home":"Tuva, Mongolia","tag":"throat singing drone","en":"One voice making two: a low drone with a whistling overtone above.","ru":"Один голос, два звука: низкий бурдон и свистящий обертон над ним.","title":"Throat Singing Drone","flag":""},{"slug":"cello","family":"strings-bowed","family_name":"bowed strings","home":"Europe","tag":"cello","en":"Warm, deep bowed strings, close to the human voice.","ru":"Тёплые глубокие смычковые, ближе всех к человеческому голосу.","title":"Cello","flag":""},{"slug":"viola","family":"strings-bowed","family_name":"bowed strings","home":"Europe","tag":"viola","en":"Between violin and cello: darker, veiled, melancholy.","ru":"Между скрипкой и виолончелью: темнее, приглушённее, меланхоличнее.","title":"Viola","flag":""},{"slug":"violin","family":"strings-bowed","family_name":"bowed strings","home":"Europe","tag":"violin","en":"The high bowed voice: bright, singing, agile.","ru":"Высокий смычковый голос: яркий, поющий, подвижный.","title":"Violin","flag":""},{"slug":"double-bass","family":"strings-bowed","family_name":"bowed strings","home":"Europe","tag":"double bass","en":"The lowest bowed string: a deep foundation, plucked or bowed.","ru":"Самая низкая смычковая струна: глубокий фундамент, щипком или смычком.","title":"Double Bass","flag":""},{"slug":"string-quartet","family":"ensemble","family_name":"ensembles","home":"Europe","tag":"string quartet","en":"Two violins, viola and cello: intimate chamber harmony.","ru":"Две скрипки, альт и виолончель: камерная гармония вблизи.","title":"String Quartet","flag":""},{"slug":"flute","family":"winds-wood","family_name":"woodwinds","home":"Europe","tag":"flute","en":"Concert flute: pure, silvery, airy.","ru":"Концертная флейта: чистая, серебристая, воздушная.","title":"Flute","flag":""},{"slug":"oboe","family":"winds-reed","family_name":"reeds and bagpipes","home":"Europe","tag":"oboe","en":"Double reed: plaintive, nasal, penetrating.","ru":"Двойная трость: жалобный, носовой, проникающий звук.","title":"Oboe","flag":"Failed (Viktor 04.10: «unfortunately, YuE2 has no oboe»): no oboe in its probes.","failed":true},{"slug":"clarinet","family":"winds-reed","family_name":"reeds and bagpipes","home":"Europe","tag":"clarinet","en":"Single reed: round, woody, from a dark low to a sweet high.","ru":"Одинарная трость: круглый древесный звук, от тёмного низа до сладкого верха.","title":"Clarinet","flag":""},{"slug":"bassoon","family":"winds-reed","family_name":"reeds and bagpipes","home":"Europe","tag":"bassoon","en":"Low double reed: dry, reedy, often wry.","ru":"Низкая двойная трость: сухой, тростниковый, часто с усмешкой.","title":"Bassoon","flag":"No such reed: YuE2 does not play the bassoon. Both probes deleted.","failed":true},{"slug":"french-horn","family":"winds-brass","family_name":"brass and horns","home":"Europe","tag":"french horn","en":"Coiled horn: noble, warm, heroic and distant.","ru":"Валторна: благородная, тёплая, героическая и далёкая.","title":"French Horn","flag":""},{"slug":"trumpet","family":"winds-brass","fa