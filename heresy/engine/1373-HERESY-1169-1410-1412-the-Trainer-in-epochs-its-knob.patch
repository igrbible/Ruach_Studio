diff --git a/tools/console/app.css b/tools/console/app.css
index 782cc91..98c5714 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -5424,3 +5424,39 @@ body:has(.ar-view) .hm-tip { z-index: 131; }
 .coll-grid.artbin .coll-title { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; overflow-wrap: anywhere;
   font-size: 12.5px; line-height: 1.35; }
 .coll-grid.artbin .coll-meta { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; overflow-wrap: anywhere; line-height: 1.35; }
+/* HERESY 1411 (Viktor 13.10.2026: «сделай его изящным… чтобы заголовки полей не схлопывались в две строки. Подсказки в тултипы»): the
+   Trainer's knobs, five a row on a wide pane (the run · how long and how wide · the music half), four or three on narrower ones; a label
+   on one line, cut with … rather than folded; the units inside their fields; the guide's links a small «?» */
+.tr-knobs { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px 14px; align-items: end; }
+@media (max-width: 1500px) { .tr-knobs { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
+@media (max-width: 1100px) { .tr-knobs { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
+@media (max-width: 700px) { .tr-knobs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+.tr-knobs .field > .label { display: flex; align-items: center; gap: 6px; min-width: 0; height: 18px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.tr-knobs .check { align-self: end; min-height: 34px; display: flex; align-items: center; gap: 8px; white-space: nowrap; }
+.tr-knobs .check > span { overflow: hidden; text-overflow: ellipsis; }
+.tr-q { flex: none; display: inline-grid; place-items: center; width: 16px; height: 16px; margin: 0; border: 1px solid currentColor; border-radius: 50%;
+  font-size: 10px; font-weight: 700; line-height: 1; opacity: .8; text-decoration: none; }
+.tr-q:hover { opacity: 1; text-decoration: none; }
+.tr-unit-in { position: relative; display: block; min-width: 0; }
+.tr-unit-in input { width: 100%; padding-right: 7.5em; }
+.tr-unit { position: absolute; right: 9px; top: 50%; transform: translateY(-50%); max-width: calc(100% - 4.5em); overflow: hidden; text-overflow: ellipsis;
+  white-space: nowrap; font-size: 11px; color: var(--muted); pointer-events: none; }
+.tr-unit:empty { display: none; }
+/* HERESY 1412 (Viktor 13.10.2026: «Раздели CFG строку на две, отступи вниз немного от общего семплинга, выровняй оба вправо»): the two
+   guidances a row each, a little below the samplers, the light before its field, the fields at the right edge as the samplers' are */
+.field-row.cfg-rows { flex-direction: column; align-items: stretch; gap: 8px; margin-top: 14px; }
+.field-row.cfg-rows > .field.field-inline { width: 100%; }
+.field-row.cfg-rows > .field.field-inline > .label { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
+.field-row.cfg-rows .cfg-light { order: 1; margin: 0 2px 0 0; }
+.field-row.cfg-rows > .field.field-inline > input { order: 2; width: 9.5em; min-width: 0; }
+/* the take's card (Viktor: «Сделай столбец ФОРМА тоже жидким… в следующую полосу, в один ряд, заголовки над полосами с кружками»):
+   Song | Sound in two flowing columns, Shape a band under them, its three scales side by side, each name over its dots; fewer a row
+   when the card is narrow */
+.meta-row.pair { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
+.meta-rows.shape-trio { grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); justify-content: stretch; gap: 6px 16px; }
+.meta-rows.shape-trio > div { display: flex; flex-direction: column; align-items: flex-start; gap: 3px; min-width: 0; }
+.meta-rows.shape-trio dd { max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+@container (max-width: 380px) {
+  .meta-row.pair { grid-template-columns: minmax(0, 1fr); row-gap: 10px; }
+  .meta-row.pair > .meta-col + .meta-col { border-left: none; padding-top: 10px; border-top: 1px solid var(--line-soft); }
+}
