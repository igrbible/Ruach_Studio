diff --git a/tools/console/app.css b/tools/console/app.css
index 5f0644f..9604fbf 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -2387,3 +2387,87 @@ body[data-tab="collection"] .library, body[data-tab="collection"] #gripRight { d
 .pc-st.is-failed { color: var(--bad); }
 .pc-say { margin-left: 6px; color: var(--muted); }
 .pc-say.is-bad { color: var(--bad); }
+
+/* HERESY 1056: karaoke timing */
+.kt-box { margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--line-soft); }
+.kt-cap { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); font-weight: 500; }
+.kt-rows { margin: 8px 0 0; padding: 0; list-style: none; max-height: 320px; overflow: auto; font-size: 13px; }
+.kt-rows li { display: flex; gap: 10px; padding: 3px 0; border-bottom: 1px solid var(--line-soft); }
+.kt-rows li.is-guessed { color: var(--muted); font-style: italic; }
+.kt-t { flex: none; border: 0; background: none; color: var(--amber); cursor: pointer; padding: 0; font-size: 12px; }
+.kt-rows li.is-guessed .kt-t { color: var(--dim); }
+
+/* HERESY 1057: the studio's own dialogs */
+.hd-back { position: fixed; inset: 0; z-index: 120; display: flex; align-items: center; justify-content: center; padding: 16px;
+  background: color-mix(in srgb, var(--ground) 55%, transparent); backdrop-filter: blur(3px); opacity: 0; transition: opacity .12s ease; }
+.hd-back.is-on { opacity: 1; }
+.hd-back.is-leaving { opacity: 0; }
+.hd-box { width: min(480px, 100%); display: flex; flex-direction: column; gap: 10px; padding: 18px 20px 16px; border: 1px solid var(--line-strong);
+  border-radius: var(--r-lg); background: var(--panel); box-shadow: 0 20px 60px var(--shadow-lg); transform: translateY(6px) scale(.98); transition: transform .12s ease; }
+.hd-back.is-on .hd-box { transform: none; }
+.hd-title { font: 600 16px/1.35 var(--sans); color: var(--ink); }
+.hd-body { white-space: pre-line; color: var(--muted); font-size: 13.5px; line-height: 1.5; }
+.hd-input { width: 100%; }
+.hd-acts { display: flex; justify-content: flex-end; gap: 8px; margin-top: 4px; }
+
+/* HERESY 1058: every dropdown in the studio's own dress: no native arrow, a drawn chevron, room for it */
+select { appearance: none; -webkit-appearance: none; background-color: var(--field);
+  background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%);
+  background-position: calc(100% - 14px) 52%, calc(100% - 9px) 52%; background-size: 5px 5px, 5px 5px; background-repeat: no-repeat;
+  padding-right: 26px !important; border: 1px solid var(--line); border-radius: var(--r-md); color: var(--ink); cursor: pointer; }
+select:hover { border-color: var(--hover-line, var(--line-strong)); }
+select:focus { background-image: linear-gradient(45deg, transparent 50%, var(--amber) 50%), linear-gradient(135deg, var(--amber) 50%, transparent 50%); }
+select option, select optgroup { background: var(--panel); color: var(--ink); }
+.coll-inline { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; }
+.coll-inline select { width: auto; padding-top: 4px; padding-bottom: 4px; }
+
+/* HERESY 1058: a note as a mark; the card that sounds pulses */
+.coll-hasnote { color: var(--amber); opacity: .9; }
+.coll-nonote { visibility: hidden; width: 29px; }
+.coll-card.is-sounding { animation: coll-pulse 1.6s ease-in-out infinite; }
+@keyframes coll-pulse {
+  0%, 100% { box-shadow: 0 2px 6px color-mix(in srgb, var(--amber) 18%, transparent); }
+  50% { box-shadow: 0 6px 22px color-mix(in srgb, var(--amber) 45%, transparent); }
+}
+@media (prefers-reduced-motion: reduce) { .coll-card.is-sounding { animation: none; box-shadow: 0 4px 16px color-mix(in srgb, var(--amber) 35%, transparent); } }
+
+/* HERESY 1059: the datasheet, and a card flashed into sight */
+.ds-back { position: fixed; inset: 0; z-index: 70; display: flex; align-items: center; justify-content: center; padding: 16px;
+  background: color-mix(in srgb, var(--ground) 55%, transparent); backdrop-filter: blur(2px); }
+.ds-box { width: min(1240px, 100%); max-height: calc(100vh - 32px); overflow: auto; padding: 18px 20px; border: 1px solid var(--line-strong);
+  border-radius: var(--r-lg); background: var(--panel); box-shadow: 0 20px 60px var(--shadow-lg); display: flex; flex-direction: column; gap: 12px; }
+.ds-head { display: flex; flex-wrap: wrap; gap: 8px; align-items: flex-start; }
+.ds-head > div:first-child { min-width: 0; }
+.ds-cols { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(280px, 1fr); gap: 18px; }
+@media (max-width: 900px) { .ds-cols { grid-template-columns: minmax(0, 1fr); } }
+.ds-texts .sheet-text { max-height: 260px; overflow: auto; }
+.ds-lyrics { max-height: 420px !important; }
+.ds-abc { font-size: 11.5px; max-height: 300px !important; }
+.ds-knobs { display: flex; flex-direction: column; gap: 10px; }
+.ds-group { padding: 8px 10px; border: 1px solid var(--line-soft); border-radius: var(--r-md); }
+.ds-kv { display: flex; justify-content: space-between; gap: 12px; padding: 2px 0; font-size: 13px; }
+.ds-kv span { color: var(--muted); }
+.ds-kv b { font-weight: 500; font-family: var(--mono); font-size: 12.5px; text-align: right; overflow-wrap: anywhere; }
+.coll-card.is-flash { outline: 2px solid var(--amber); outline-offset: 2px; transition: outline-color .3s; }
+
+/* HERESY 1059: the chain's progress */
+.pc-bar { width: 100%; height: 5px; border-radius: 3px; background: var(--sunk); overflow: hidden; margin-bottom: 4px; }
+.pc-bar i { display: block; height: 100%; background: var(--good); transition: width .4s ease; }
+.pc-bar.is-running i { background: linear-gradient(90deg, var(--amber), var(--amber-hi), var(--amber)); background-size: 200% 100%; animation: pc-flow 1.4s linear infinite; }
+.pc-bar.is-failed i { background: var(--bad); }
+@keyframes pc-flow { from { background-position: 200% 0; } to { background-position: 0 0; } }
+.pc-st.is-running { animation: pc-blink 1.2s ease-in-out infinite; }
+@keyframes pc-blink { 50% { opacity: .55; } }
+#pcRun.is-magic { opacity: 1 !important; pointer-events: none; background: linear-gradient(90deg, var(--amber), var(--amber-hi), var(--amber)); background-size: 200% 100%; animation: pc-flow 2s linear infinite; }
+
+/* HERESY 1059: the player fits a narrow window (and a zoomed one): the 1042 rule had brought the
+   title block back over the 1150 px query; below 900 px the bar sheds what it can spare */
+@media (max-width: 1150px) { .playbar-id { display: none; } }
+@media (max-width: 900px) {
+  .playbar { gap: 6px; padding: 0 8px; }
+  .status-pill { width: auto; padding: 0 8px; }
+  #statusText { display: none; }
+  .autoplay-btn { padding: 2px 6px; font-size: 11px; }
+  #volume { display: none; }
+  #wave { min-width: 0; flex: 1 1 60px; }
+}
