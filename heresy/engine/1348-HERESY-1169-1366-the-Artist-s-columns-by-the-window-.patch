Viktor 11.10.2026: «Выровняй высоты полей ввода в пар с дропдаун селекторами. При сжатии колонки РАСПИСАНИЕ остаётся на той же строке и врубает скроллинг горизонтальный. Поставь минимум 25% ширины экрана, максимум 30%. На правую колонку минимум 20%, максимум 35%». The fields 41.7 px to the selects' 35.7 (the seed's mode 32.6): all 36. The sideways scroll: the sampling block could not be narrower than its summary's line (364 px in Russian with Qwen fp8, Exp Heun 2 x0 SDE, Bong tangent), a flex item's least width; min-width 0 lets the line end in «…» and the fields wrap. The painter's and fine-tune's selects narrow too; their own rows (1345) said again, which their names' width alone had kept. The edges' bounds and widths are shares of the window, measured again when it changes; the grid clamps them in vw. Suite (suite-1366.part).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/console/app.css          | 13 ++++++++++++-
 tools/console/heresy-artist.js | 23 +++++++++++++++++------
 2 files changed, 29 insertions(+), 7 deletions(-)

diff --git a/tools/console/app.css b/tools/console/app.css
index 50578bd..cf37740 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -5154,7 +5154,7 @@ body.ar-cmp-picking #arRuns .ar-thumb, body.ar-cmp-picking #arRuns .ar-gpic butt
 #arStop[hidden] { display: none; }   /* HERESY 1345: a .btn shows through [hidden] (1340 left Stop in sight with no run going) */
 #arDraw.is-stop:hover { filter: brightness(1.08); }
 /* HERESY 1271: the Artist in three columns, the outer two as wide as their edges are dragged (kept), the stage the rest */
-.ar-cols { display: grid; grid-template-columns: var(--ar-l, 380px) 12px minmax(280px, 1fr) 12px var(--ar-r, 560px); column-gap: 4px; align-items: start; margin-top: 14px; }
+.ar-cols { display: grid; grid-template-columns: clamp(25vw, var(--ar-l, 25vw), 30vw) 12px minmax(280px, 1fr) 12px clamp(20vw, var(--ar-r, 28vw), 35vw); column-gap: 4px; align-items: start; margin-top: 14px; }   /* HERESY 1366: 25–30 % and 20–35 % of the window */
 .ar-left, .ar-stage, .ar-right { min-width: 0; }
 .ar-left, .ar-stage { position: sticky; top: 8px; }
 /* HERESY 1340 (Viktor 10.10.2026: «Левая колонка Художника не прокручивается независимо»; «Среднюю колонку фрейм промпта растянуть
@@ -5316,3 +5316,14 @@ body:has(.ar-view) .hm-tip { z-index: 131; }
 .ar-lora-keys { grid-area: keys; display: flex; }
 .ar-lora-keys .ar-lora-k { flex: 1; min-width: 0; font-size: 12px; padding: 3px 6px; }
 .ar-lora-keys .ar-lora-k.is-bad { border-color: var(--bad, #e06c5a); }
+/* HERESY 1366 (Viktor 11.10.2026: «Выровняй высоты полей ввода в пар с дропдаун селекторами. При сжатии колонки РАСПИСАНИЕ остаётся на той же
+   строке и врубает скроллинг горизонтальный»): the Artist's fields one height with its selects (they stood 42 px to the selects' 36, the
+   seed's mode at 33); the sampling block narrows with the column (its summary's line, a flex item that never wraps, held it at 382 px:
+   the block may be narrower than that line, which ends in «…», and its fields wrap), and so do the painter's and the fine-tune's selects
+   (their longest name held them) */
+#view-artist .ar-left :is(input:not([type=checkbox]):not([type=radio]):not([type=range]):not([type=file]):not(.ar-lora-k), select) { height: 36px; padding-top: 0; padding-bottom: 0; }
+#view-artist .ar-left #arSeedNew { height: 36px; min-width: 36px; }
+.ar-left .ar-sampling { min-width: 0; }
+.ar-left .ar-sampling > summary { min-width: 0; }
+.ar-left .ar-knobs > .ar-painter, .ar-left .ar-knobs > .ar-model { flex: 1 1 100%; min-width: 0; }   /* 1345: each a row of its own */
+.ar-left .ar-painter select, .ar-left .ar-model select { min-width: 0; width: 100%; }
diff --git a/tools/console/heresy-artist.js b/tools/console/heresy-artist.js
index f99eea8..4c624e6 100644
--- a/tools/console/heresy-artist.js
+++ b/tools/console/heresy-artist.js
@@ -1443,14 +1443,25 @@
   function edges() {                                     // the two edges: dragged, ← →, Home or a double click; the widths kept
     var cols = $("arCols");
     if (!cols) return;
-    var E = { l: { key: "yue2.arL", min: 280, max: 640, def: 380, col: ".ar-left", prop: "--ar-l", sign: 1 },
-              r: { key: "yue2.arR", min: 300, max: 900, def: 560, col: ".ar-right", prop: "--ar-r", sign: -1 } };
+    // HERESY 1366 (Viktor 11.10.2026: «Поставь минимум 25% ширины экрана, максимум 30%. На правую колонку минимум 20%, максимум 35%»): the
+    // edges' bounds and their own widths are shares of the window, measured each time: a window made wider or narrower brings the kept
+    // widths back inside them
+    var E = { l: { key: "yue2.arL", min: 0.25, max: 0.30, def: 0.25, col: ".ar-left", prop: "--ar-l", sign: 1 },
+              r: { key: "yue2.arR", min: 0.20, max: 0.35, def: 0.28, col: ".ar-right", prop: "--ar-r", sign: -1 } };
+    function px(f) { return Math.round(f * window.innerWidth); }
     Object.keys(E).forEach(function (s) {
       var e = E[s], rz = $(s === "l" ? "arEdgeL" : "arEdgeR"), col = cols.querySelector(e.col);
       if (!rz || !col) return;
-      function setW(w) { w = Math.max(e.min, Math.min(e.max, Math.round(w))); cols.style.setProperty(e.prop, w + "px"); rz.setAttribute("aria-valuenow", String(w)); fitStage(); return w; }
-      rz.setAttribute("aria-valuemin", String(e.min)); rz.setAttribute("aria-valuemax", String(e.max));
-      setW(parseInt(recall(e.key), 10) || e.def);
+      function setW(w) {
+        var lo = px(e.min), hi = px(e.max);
+        w = Math.max(lo, Math.min(hi, Math.round(w)));
+        cols.style.setProperty(e.prop, w + "px");
+        rz.setAttribute("aria-valuemin", String(lo)); rz.setAttribute("aria-valuemax", String(hi)); rz.setAttribute("aria-valuenow", String(w));
+        fitStage();
+        return w;
+      }
+      setW(parseInt(recall(e.key), 10) || px(e.def));
+      window.addEventListener("resize", function () { setW(parseInt(recall(e.key), 10) || px(e.def)); });
       rz.addEventListener("pointerdown", function (ev) {
         if (ev.button !== 0) return;
         ev.preventDefault();
@@ -1465,7 +1476,7 @@
         }
         rz.addEventListener("pointermove", move); rz.addEventListener("pointerup", up); rz.addEventListener("pointercancel", up);
       });
-      rz.addEventListener("dblclick", function () { keep(e.key, null); setW(e.def); });
+      rz.addEventListener("dblclick", function () { keep(e.key, null); setW(px(e.def)); });
       rz.addEventListener("keydown", function (k) {
         if (k.key === "ArrowLeft" || k.key === "ArrowRight") { k.preventDefault(); k.stopPropagation(); keep(e.key, String(setW(col.getBoundingClientRect().width + e.sign * (k.key === "ArrowRight" ? 16 : -16)))); }
         else if (k.key === "Home") { k.preventDefault(); k.stopPropagation(); keep(e.key, null); setW(e.def); }
