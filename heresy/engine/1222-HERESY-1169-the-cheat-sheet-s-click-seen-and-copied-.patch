diff --git a/tools/console/app.css b/tools/console/app.css
index 283780e..4c88200 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -4381,3 +4381,16 @@ body[data-frame="compose"] #view-compose, body[data-frame="take"] #view-take {
   top: calc((100vh - var(--playbar-h)) * .015 / var(--frame-zoom)); height: calc((100vh - var(--playbar-h)) * .97 / var(--frame-zoom)); }
 body[data-frame] :is(#view-compose, #view-take) > .col-head { padding-top: 13px; padding-bottom: 9px; }
 body[data-frame="compose"] .compose > .submit-bar { padding-top: 9px; padding-bottom: 10px; }
+/* HERESY 1169 (Viktor 07.10.2026: «В шпаргалке по стилям и инструментам проблемка. Не работает кликание, вставка,
+   копирование»): a click on a name did put it into the Style prompt, but its words showed under the sheet (the toasts stood at
+   40, the sheet at 70) and nothing else moved in sight: the toasts stand over every window now, the pointer going through them
+   to what is under; a name the prompt holds is marked in the sheet, as a pen marks it; the sheet's words select and copy
+   again (1148 had stopped the page's own words from selecting) */
+.toasts { z-index: 200; pointer-events: none; }
+.hi-tag.is-in { background: color-mix(in srgb, var(--amber) 24%, transparent); border-radius: 2px;
+  box-shadow: 0 0 0 2px color-mix(in srgb, var(--amber) 24%, transparent); }
+.hi-box :is(.hi-table, .hi-warn, .hi-legend, .hi-more) { -webkit-user-select: text; user-select: text; }
+/* HERESY 1169 (Viktor 07.10.2026: «Ширину зафиксируй в дропдауне подстановки по `[`»): the list as wide whatever the tag in
+   hand says of itself, and its note two lines high always, so neither the box nor its rows move as the choice moves */
+.tc-pop { width: min(460px, calc(100vw - 8px)); }
+.tc-note { min-height: 2.8em; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
