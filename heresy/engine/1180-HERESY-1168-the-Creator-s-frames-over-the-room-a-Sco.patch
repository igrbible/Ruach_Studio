diff --git a/tools/console/app.css b/tools/console/app.css
index 2ebf560..cc2f22e 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -4144,3 +4144,27 @@ select option, select optgroup { background-color: var(--panel); color: var(--in
 .eg-unload-row .check { white-space: nowrap; }
 /* HERESY 1167 (Viktor: «SVG кнопки переключения режима день/ночь/система сделай побольше»): 21 px, the others 17 */
 .day-night .hz-icon { width: 21px; height: 21px; }
+/* HERESY 1168 (Viktor 06.10.2026: «если нет партитуры, нужно прятать все кнопки… Туда только кнопку "Сгенерить партитуру из
+   звука"»): no score yet, nothing to engrave, print, zoom or export: the button that writes it, alone */
+#scorePanel[data-empty] .score-head, #scorePanel[data-empty] .paper, #scorePanel[data-empty] .score-check { display: none !important; }
+/* (important: the engraver leaves its own inline display on the staff it drew for the take before.) And the row of the
+   button was never hidden by its [hidden]: its display: flex outweighed it, so it stood under every score */
+.score-from-sound[hidden], .score-from-sound .btn[hidden] { display: none; }
+/* HERESY 1168 (Viktor 06.10.2026: «на каждый фрейм — левый и правый — разворот этого фрейма… в оверлей окно 95%x95%, с
+   увеличением масштаба всего фрейма на добрых 20%»): a Creator frame over the room, 95 % of the screen above the player (the
+   player stays in sight and in hand), all of it a fifth larger. The frame is lifted where it stands; the zoom multiplies its
+   own sizes too, so they are given divided by it */
+.frame-tools { display: inline-flex; align-items: center; gap: 2px; flex: none; }
+.frame-tools .icon-btn { display: inline-grid; place-items: center; padding: 4px 7px; }
+.frame-tools .ui-ico { width: 17px; height: 17px; }
+.frame-tools .frame-swap { display: none; }
+body[data-frame] .frame-tools .frame-swap { display: inline-grid; }
+.frame-veil { position: fixed; left: 0; right: 0; top: 0; bottom: var(--playbar-h); z-index: 26;
+  background: color-mix(in srgb, var(--ground) 45%, rgba(0, 0, 0, .55)); backdrop-filter: blur(3px); }
+:root { --frame-zoom: 1.2; }
+body[data-frame="compose"] #view-compose, body[data-frame="take"] #view-take {
+  position: fixed; z-index: 27; zoom: var(--frame-zoom);
+  left: calc(2.5vw / var(--frame-zoom)); width: calc(95vw / var(--frame-zoom));
+  top: calc((100vh - var(--playbar-h)) * .025 / var(--frame-zoom)); height: calc((100vh - var(--playbar-h)) * .95 / var(--frame-zoom));
+  border: 1px solid var(--line-strong-a); border-radius: var(--r-lg); box-shadow: 0 24px 80px var(--shadow-lg);
+}
