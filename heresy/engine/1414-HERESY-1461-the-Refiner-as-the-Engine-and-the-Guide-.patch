diff --git a/tools/console/app.css b/tools/console/app.css
index 55e41cd..ad70364 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -5878,3 +5878,35 @@ body:has(#view-engine:not(.is-hidden)) :is(.topbar, #playbar) { z-index: 37; }
 .pl-panel .pl-check { flex-direction: row; align-items: center; gap: 6px; }
 .pl-panel .pl-state.is-bad { color: var(--bad, #e06c5a); }
 
+/* HERESY 1461 (Viktor 15.10.2026: «Если считаешь, что нужна переделка дизайна комнаты Огранщика, или несколько вкладок внутри, —
+   одобряю»): the Refiner as the Engine and the Guide: the steps as tabs in a column at the left, grouped in the chain's order, the
+   open step at the right and what is made from the take under it; the room's head, the import and the chain across the top.
+   Narrower than 1100 px it stays one column as it was */
+@media (min-width: 1100px) {
+  #view-post:not(.is-hidden) { display: grid; grid-template-columns: minmax(220px, 260px) minmax(0, 1fr); column-gap: 18px; align-content: start;
+    grid-template-rows: auto auto auto auto 1fr; }   /* the steps' extra height into the tree's row */
+  #view-post > .drawer.is-step:not(.is-step-off), #view-post > .dv-tree-box { align-self: start; }
+  #view-post > * { grid-column: 1 / -1; }
+  #view-post > .post-head { grid-row: 1; }
+  #view-post > #importPanel { grid-row: 2; }
+  #view-post > #postChain { grid-row: 3; }
+  #view-post > #postSteps { grid-column: 1; grid-row: 4 / span 2; align-self: start; position: sticky; top: 8px; flex-direction: column; flex-wrap: nowrap; gap: 3px;
+    margin: 4px 0 0; padding: 10px 8px; border: 1px solid var(--line-a); border-radius: var(--r-md); background: var(--panel); }
+  #view-post > .drawer.is-step:not(.is-step-off) { grid-column: 2; grid-row: 4; margin-top: 4px; }
+  #view-post > .dv-tree-box { grid-column: 2; grid-row: 5; }
+  #postSteps .ps-arrow { display: none; }
+  #postSteps .ps-step { width: 100%; border-radius: var(--r-sm); border-color: transparent; padding: 7px 10px 7px 7px; }
+  #postSteps .ps-step:hover { border-color: transparent; background: color-mix(in srgb, var(--amber) 8%, transparent); }
+  #postSteps .ps-step.is-active { border-color: color-mix(in srgb, var(--amber) 40%, transparent); background: color-mix(in srgb, var(--amber) 12%, transparent);
+    box-shadow: inset 3px 0 0 var(--amber); }
+  #postSteps .ps-step.is-plugin { border-style: dashed; border-color: var(--line-a); }
+  #postSteps .ps-group { margin: 8px 4px 2px; font: 600 10.5px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--dim); }
+  #postSteps .ps-group:first-child { margin-top: 0; }
+}
+#postSteps .ps-group { display: none; }
+@media (min-width: 1100px) { #postSteps .ps-group { display: block; } }
+.pl-panel .rm-grid > .field:first-child { flex: 1 1 260px; max-width: 460px; }
+.pl-panel .rm-grid > .rm-num { width: auto; min-width: 120px; flex: 0 1 auto; }
+.pl-panel .rm-grid > .rm-num select, .pl-panel .rm-grid > .rm-num input { min-width: 120px; }
+.pl-panel .rm-grid > .pl-check { flex: 0 0 auto; align-self: center; }
+
