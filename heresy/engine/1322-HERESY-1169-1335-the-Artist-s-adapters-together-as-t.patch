Viktor 10.10.2026: «И по LoRA адаптерам сделай также суммарную силу как у Творца, чтобы не было прежёга из-за наложения адаптеров. МНогие этого вообще не знаю, что нужна суммарность, а не поднебесная сила каждого адаптера.»

Under the Artist's adapters, from two of them: their strengths together on the Creator's road (green to 1.2, amber to 1.8, red past it: a first measure for pictures, to be set by eye), its tip saying why stacked adapters burn a picture however modest each one is. Dragged, it moves them all at once, each in proportion to where it stood when the drag began, on the 0.05 grid, none past 1.5; one strength moved, the sum follows it; Draw carries what the rows show.

Suite: 615/0 in the kitchen (with 1336).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/console/app.css          |  2 ++
 tools/console/heresy-artist.js | 39 +++++++++++++++++++++++++++++++++-
 2 files changed, 40 insertions(+), 1 deletion(-)

diff --git a/tools/console/app.css b/tools/console/app.css
index 971ccdd..05c621a 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -5098,3 +5098,5 @@ body.ar-cmp-picking #arRuns .ar-thumb, body.ar-cmp-picking #arRuns .ar-gpic butt
 body.log-pop { margin: 0; background: var(--panel); color: var(--ink); display: flex; flex-direction: column; height: 100vh; }
 .log-pop-head { display: flex; align-items: center; gap: 10px; padding: 6px 10px; border-bottom: 1px solid var(--line-a); }
 body.log-pop .log-dock-body { flex: 1 1 auto; height: auto; overflow: auto; padding: 8px 12px; }
+/* HERESY 1335: the Artist's adapters together, as the Creator's bar */
+.ar-lora-total { margin-top: 6px; }
diff --git a/tools/console/heresy-artist.js b/tools/console/heresy-artist.js
index e99cab8..081f6b6 100644
--- a/tools/console/heresy-artist.js
+++ b/tools/console/heresy-artist.js
@@ -1156,7 +1156,28 @@
         (words.length ? '<span class="ar-lora-words">' + words.map(function (w) {
           return '<button type="button" class="ar-lora-word" data-word="' + esc(w) + '" data-tip="' + esc(tr("Into the prompt:") + " " + w) + '" translate="no">' + esc(w) + "</button>"; }).join("") + "</span>" : "") +
         (state.loraLib && !e ? '<span class="ar-lora-gone">' + esc(tr("not in artwork/loras/ any more")) + "</span>" : "") + "</div>";
-    }).join("");
+    }).join("") + loraTotalBar(list);                     // HERESY 1335
+  }
+  // HERESY 1335: the adapters' strengths together, zoned; dragged, all of them in proportion
+  var LORA_TOTAL = { safe: 1.2, limit: 1.8, max: 4 };
+  function loraSum(list) { return (list || []).reduce(function (s, l) { return s + (+l.weight || 0); }, 0); }
+  function loraZone(t) { return t > LORA_TOTAL.limit + 1e-9 ? "is-red" : t > LORA_TOTAL.safe + 1e-9 ? "is-amber" : "is-green"; }
+  function loraTotalBar(list) {
+    if ((list || []).length < 2) return "";
+    var t = loraSum(list), z = LORA_TOTAL;
+    return '<label class="lora-total ar-lora-total ' + loraZone(t) + '" data-tip="' + esc(tr("All the adapters' strengths together: stacked, they add up, and past about") + " " + z.limit +
+      " " + tr("the picture burns (its colours and edges overdone), however modest each one is. Green to") + " " + z.safe + ", " + tr("amber to") + " " + z.limit + ", " + tr("red past it. Drag it to move them all at once, each in proportion.")) + '">' +
+      "<span>" + esc(tr("Together")) + "</span>" +
+      '<input type="range" class="zoned ar-lora-tw" style="--z1:' + (100 * z.safe / z.max).toFixed(1) + "%;--z2:" + (100 * z.limit / z.max).toFixed(1) + '%" min="0" max="' + z.max + '" step="0.05" value="' + t.toFixed(2) + '" aria-label="' + esc(tr("All together")) + '" />' +
+      "<output>" + t.toFixed(2) + "</output></label>";
+  }
+  function loraTotalPaint(list) {
+    var bar = document.querySelector("#arLoraList .ar-lora-total");
+    if (!bar) return;
+    var t = loraSum(list);
+    bar.className = "lora-total ar-lora-total " + loraZone(t);
+    bar.querySelector("output").textContent = t.toFixed(2);
+    if (!state.loraTotalDrag) bar.querySelector("input").value = t.toFixed(2);
   }
   function loraToggle(id) {
     var list = lorasNow(), at = list.map(function (l) { return l.id; }).indexOf(id);
@@ -1284,12 +1305,28 @@
     paintSampling();
     loadPainters();
     $("arLoraList").addEventListener("input", function (e) {
+      var tw = e.target.closest(".ar-lora-tw");          // HERESY 1335: together: each in proportion to where it stood when the drag began
+      if (tw) {
+        var lst = lorasNow();
+        if (!state.loraTotalDrag) state.loraTotalDrag = lst.map(function (l) { return +l.weight || 0; });
+        var base = state.loraTotalDrag, sum = base.reduce(function (s, v) { return s + v; }, 0), target = +tw.value;
+        lst.forEach(function (l, k) { l.weight = Math.min(1.5, Math.max(0, Math.round((sum > 1e-9 ? base[k] * target / sum : target / lst.length) * 20) / 20)); });
+        var al = lorasAll(); al[familyNow()] = lst; keep(KEY.loras, JSON.stringify(al));
+        Array.prototype.forEach.call(document.querySelectorAll("#arLoraList [data-li]"), function (row) {
+          var l = lst[+row.dataset.li]; if (!l) return;
+          row.querySelector(".ar-lora-w").value = (+l.weight).toFixed(2); row.querySelector(".ar-lora-wv").textContent = (+l.weight).toFixed(2);
+        });
+        loraTotalPaint(lst);
+        return;
+      }
       var w = e.target.closest(".ar-lora-w");
       if (!w) return;
       var row = w.closest("[data-li]"), list = lorasNow(), at = +row.dataset.li;
       row.querySelector(".ar-lora-wv").textContent = (+w.value).toFixed(2);
       if (list[at]) { list[at].weight = +(+w.value).toFixed(2); var all = lorasAll(); all[familyNow()] = list; keep(KEY.loras, JSON.stringify(all)); }
+      loraTotalPaint(list);                              // HERESY 1335
     });
+    $("arLoraList").addEventListener("change", function (e) { if (e.target.closest(".ar-lora-tw")) { state.loraTotalDrag = null; loraTotalPaint(lorasNow()); } });
     $("arLoraList").addEventListener("click", function (e) {
       var x = e.target.closest("[data-lx]"), wd = e.target.closest("[data-word]");
       if (x) { var list = lorasNow(); list.splice(+x.dataset.lx, 1); setLoras(list); }
