diff --git a/tools/console/app.css b/tools/console/app.css
index 8e70259..c22def7 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -4313,3 +4313,33 @@ body[data-frame="take"] #view-take > .col-head > .frame-tools { position: static
 /* HERESY 1169 (Viktor 07.10.2026: «A run is in progress… забирает лишнюю строку с футера… можно поднять в уровень с кнопкой
    Generate»): the bar's note on the bar's own row, left of Takes; a line of its own only where the row has no room for it */
 .submit-note { order: -1; flex: 1 1 260px; min-width: 0; }
+/* HERESY 1169 (Viktor 07.10.2026: «в правый фрейм в компактном режиме… название трека с кнопкой воспроизведения… вверху, и
+   сдвигают наши выстраданные иконки. Предлагаю иконки вверх вровень с full screen кнопкой и выровнять их влево, а ниже…
+   тайтл трека, с обрезкой конца… ниже статистика»): in the room the take's head is three rows: ▶ and its buttons from the
+   left with ⇆ ⤡ at the right end of the first (the corner 1168 asked for, level with them now), the title across on one
+   line, its numbers under it */
+body:not([data-frame="take"]) #view-take > .col-head { padding-right: 22px; align-items: center; }
+@media (max-width: 1500px) { body:not([data-frame="take"]) #view-take > .col-head { padding-right: 16px; } }
+body:not([data-frame="take"]) #view-take > .col-head > #playHere { order: 1; }
+body:not([data-frame="take"]) #view-take > .col-head > #takeActions { order: 2; }
+body:not([data-frame="take"]) #view-take > .col-head > :is(#backToRun, #cancelAway) { order: 3; }
+body:not([data-frame="take"]) #view-take > .col-head > .frame-tools { position: static; order: 4; margin-left: auto; }
+body:not([data-frame="take"]) #view-take > .col-head > .spacer { display: none; }
+body:not([data-frame="take"]) #view-take > .col-head > #takeTitle { order: 10; flex: 1 1 100%; }
+/* over the room (Viktor: «смести их блок влево хотя бы на 40-50pt… чел на кнопку <> тыкнуть пытается, а тыкнул на
+   корзину»): ⇆ ⤡ kept apart from the buttons before them, in both frames; 👍 👎 pressed as the star is */
+body[data-frame] :is(#view-compose, #view-take) > .col-head > .frame-tools { margin-left: 28px; }
+:is(#likeTake, #dislikeTake)[aria-pressed="true"] > :is(.ui-like, .ui-dislike) { fill-opacity: 1; }
+/* HERESY 1169: Songs × Sounds on Generate's row, integer sliders with their numbers, and the takes they make */
+.count-slider { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; color: var(--dim); flex: none; white-space: nowrap; }
+.count-slider input[type="range"] { width: 96px; height: auto; padding: 0; accent-color: var(--amber); }
+.count-slider .cs-val { min-width: 1.3em; text-align: right; font: 600 13px/1 var(--mono); color: var(--ink); }
+.cs-total { font: 12.5px/1 var(--mono); color: var(--muted); white-space: nowrap; flex: none; }
+/* Sampling's lower section: the sound half and the output (the old Sound and output drawer), and the two resets alike */
+.dot.dim { background: var(--dim); }
+.out-sub { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line-soft, var(--line-a)); }
+.out-sub > h4 { margin: 0 0 10px; }
+.out-sub .out-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }               /* under the two samplers, column for column */
+#advDrawer .out-sub .out-grid > .field:has(> #odeSolver) { grid-column: auto; }   /* over 1168's span: two columns here */
+.reset-btn { min-width: 128px; justify-content: center; }
+#advDrawer .reset-cell { padding-top: 0; align-self: center; }
