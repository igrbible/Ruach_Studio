diff --git a/tools/console/app.css b/tools/console/app.css
index c7eeb5e..5b3fb44 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -6196,3 +6196,43 @@ body.daw-full #dawPanel .mx-wave.mx-ruler { height: 22px; }
 .pcv-bar { gap: 10px; }
 .pcv-bar .pcv-tools { position: static; margin-left: auto; }
 
+/* HERESY 1519: the Creator's versions: a window over the page, the versions on the left, one (or two as a diff) on the right */
+.vr-back { position: fixed; left: 0; right: 0; top: 0; bottom: var(--playbar-h); z-index: 30; background: color-mix(in srgb, var(--ground) 45%, rgba(0, 0, 0, .55));
+  backdrop-filter: blur(3px); display: flex; align-items: center; justify-content: center; }
+.vr-back[hidden] { display: none; }
+.vr-box { width: min(1600px, 96vw); height: calc((100vh - var(--playbar-h)) * .94); display: flex; flex-direction: column; background: var(--ground);
+  border: 1px solid var(--line-strong-a, var(--line-a)); border-radius: var(--r-lg); box-shadow: 0 24px 80px var(--shadow-lg, rgba(0, 0, 0, .35)); }
+.vr-head { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-bottom: 1px solid var(--line-a); }
+.vr-title { font-size: 16px; }
+.vr-body { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(260px, 360px) minmax(0, 1fr); }
+.vr-list { overflow: auto; padding: 10px; border-right: 1px solid var(--line-a); display: flex; flex-direction: column; gap: 4px; }
+.vr-view { overflow: auto; padding: 14px 18px 18px; min-width: 0; }
+.vr-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; text-align: left; padding: 7px 10px; border: 1px solid transparent; border-radius: var(--r-md);
+  background: none; color: var(--ink); font: inherit; cursor: pointer; }
+.vr-row:hover { background: var(--hover); }
+.vr-row.is-a { border-color: var(--amber); background: color-mix(in srgb, var(--amber) 10%, transparent); }
+.vr-row.is-b { border-color: var(--patina, var(--good)); background: color-mix(in srgb, var(--patina, var(--good)) 10%, transparent); }
+.vr-row.is-trashed { cursor: default; opacity: .75; }
+.vr-n { color: var(--dim); }
+.vr-star { color: var(--amber); }
+.vr-label { font-weight: 600; }
+.vr-meta { flex-basis: 100%; font-size: 12px; color: var(--dim); }
+.vr-trash-btn { align-self: flex-start; margin-top: 10px; }
+.vr-acts { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 12px; }
+.vr-label-big { margin: 0 0 10px; font-weight: 600; }
+.vr-sec { margin: 0 0 16px; }
+.vr-cap { margin: 0 0 6px; font: 600 10.5px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--dim); }
+.vr-text { margin: 0; white-space: pre-wrap; font: inherit; line-height: 1.5; padding: 8px 10px; border: 1px solid var(--line-a); border-radius: var(--r-md); background: var(--sunk); }
+.vr-text.mono { font-family: var(--mono); font-size: 12.5px; }
+.vr-take { margin: 0 6px 6px 0; }
+.vr-take.is-gone { display: inline-block; padding: 4px 8px; color: var(--dim); text-decoration: line-through; }
+.vr-diff { border: 1px solid var(--line-a); border-radius: var(--r-md); background: var(--sunk); padding: 6px 0; font-family: var(--mono); font-size: 12.5px; line-height: 1.5; }
+.vr-l { white-space: pre-wrap; padding: 0 10px 0 26px; position: relative; }
+.vr-l .vr-sign { position: absolute; left: 10px; }
+.vr-l.is-del { background: color-mix(in srgb, var(--bad) 14%, transparent); }
+.vr-l.is-add { background: color-mix(in srgb, var(--good) 16%, transparent); }
+.vr-l.vr-gap { color: var(--dim); font-family: var(--sans); font-size: 11.5px; padding: 2px 10px; }
+.vr-words { white-space: pre-wrap; line-height: 1.6; padding: 8px 10px; border: 1px solid var(--line-a); border-radius: var(--r-md); background: var(--sunk); }
+.vr-words .is-del { background: color-mix(in srgb, var(--bad) 18%, transparent); text-decoration: line-through; margin-right: 2px; }
+.vr-words .is-add { background: color-mix(in srgb, var(--good) 20%, transparent); }
+
