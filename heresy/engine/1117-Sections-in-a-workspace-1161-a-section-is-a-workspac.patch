+      var A = wsParts(a), B = wsParts(b);
+      for (var i = 0; i < Math.min(A.length, B.length); i++) if (A[i] !== B[i]) return A[i] < B[i] ? -1 : 1;
+      return A.length - B.length;
+    });
+  }
