diff --git a/tools/console/app.css b/tools/console/app.css
index 9209fbf..2ad9531 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -1744,6 +1744,11 @@ fieldset.sound { border: 0; padding: 0; margin: 0; min-width: 0; display: flex;
   transition: opacity .12s ease, visibility .12s;
 }
 .tip.is-on { opacity: 1; visibility: visible; }
+/* HERESY 1279: a plain tip's lines as paragraphs, air between them (the blocks themselves hold no line ends to keep) */
+.tip.tip-paras { white-space: normal; }
+.tip .tip-p { margin: 0; color: inherit; white-space: pre-line; }
+.tip .tip-p + .tip-p { margin-top: .45em; }
+.tip .tip-p.tip-gap { margin-top: .8em; }
 .tip.tip-rich { max-width: min(600px, calc(100vw - 16px)); padding: 11px 13px; white-space: normal; }
 .tip .tip-kind { display: block; margin-bottom: 6px; font: 600 12.5px/1.4 var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--amber); }
 .tip .tip-kind code { letter-spacing: 0; text-transform: none; color: var(--amber); }
@@ -3197,7 +3202,8 @@ body[data-tab="train"] .log-dock.is-tall .log-dock-body { height: calc(100vh - v
 .hg-body h4 { margin: 18px 0 6px; font-size: 14.5px; }
 .hg-body p { margin: 0 0 10px; }
 .hg-body ul, .hg-body ol { margin: 0 0 12px; padding-left: 22px; }
-.hg-body li { margin: 3px 0; }
+.hg-body li { margin: 0 0 .55em; }   /* HERESY 1279: each item a paragraph, with air (3 px before) */
+.hg-body li > :is(ul, ol) { margin: .45em 0 0; }
 .hg-body code { font: 12.5px var(--mono); padding: 1px 5px; border-radius: 4px; background: var(--sunk); }
 .hg-body pre { padding: 10px 12px; border-radius: var(--r-sm); background: var(--sunk); overflow-x: auto; }
 .hg-body pre code { padding: 0; background: none; }
@@ -4177,6 +4183,7 @@ select option, select optgroup { background-color: var(--panel); color: var(--in
 .hi-more { font-size: 14.5px; color: var(--muted); }
 .hi-more summary { cursor: pointer; color: var(--ink); width: max-content; }
 .hi-more p { margin: 6px 0 2px; line-height: 1.5; }
+.hi-more p + p { margin-top: .55em; }   /* HERESY 1279: its three paragraphs */
 .hi-tools input, .hi-tools select, .hi-tools label { font-size: 15px; }
 .hi-table { font-size: 15.5px; }
 .hi-home { font-size: 14px; }
diff --git a/tools/console/app.js b/tools/console/app.js
index 872c15e..9b1ce28 100644
--- a/tools/console/app.js
+++ b/tools/console/app.js
@@ -412,11 +412,28 @@
   document.body.appendChild(tip);
   var tipFor = null, tipKept = false;   // HERESY 1167: kept = reached by the keyboard, it stays while focused
 
+  // HERESY 1279 (Viktor 09.10.2026: «По всей студии добавь спейсинг между параграфами в тултипах, гайдах и читшитах. Так
+  // красивее типографически, но не сломай редактор лирики»): a plain tip's lines are its paragraphs, with air between them (a
+  // blank line in the text a little more); its text stays the same for whoever reads it (the line ends kept between them)
+  function tipParagraphs(el, text) {
+    var parts = String(text == null ? "" : text).split(/(\n[ \t]*\n\s*|\n)/);
+    if (parts.length < 3) { el.textContent = text; return; }
+    for (var i = 0; i < parts.length; i += 2) {
+      if (i) el.appendChild(document.createTextNode(parts[i - 1]));
+      var p = document.createElement("p");
+      p.className = "tip-p" + (i && /\n[ \t]*\n/.test(parts[i - 1]) ? " tip-gap" : "");
+      p.textContent = parts[i];
+      el.appendChild(p);
+    }
+    el.classList.add("tip-paras");
+  }
+
   function showTip(target) {
     var ref = target.dataset.tipRef;
     tip.textContent = "";
+    tip.classList.remove("tip-paras");
     if (ref) tip.appendChild(document.getElementById(ref).content.cloneNode(true));
-    else tip.textContent = target.dataset.tip;
+    else tipParagraphs(tip, target.dataset.tip);
     if (target.dataset.tipHead) {   // HERESY 1168: a label's short note, moved off the label, is the tip's first line
       var head = document.createElement("div");
       head.className = "tip-head";
diff --git a/tools/console/heresy-i18n-be.js b/tools/console/heresy-i18n-be.js
index b0c76d2..471f48a 100644
--- a/tools/console/heresy-i18n-be.js
+++ b/tools/console/heresy-i18n-be.js
@@ -2784,6 +2784,9 @@ RuachI18n.add("be", {
 "painted by an image model: some show an instrument not quite as it really is": "іх малюе мадэль выяў: на некаторых інструмент не зусім такі, як насамрэч",
 "How the probes were made": "Як рабіліся пробы",
 "What YuE2 was asked to play, one instrument or one style at a time, in probes of two minutes (one minute for the first ones), two seeds each, A and B. Some probes are superb, and A and B agree, yet the instrument is not the one asked for. An instrument shapes the style of the whole piece: naming one moves the arrangement too. A crackle or a rustle of paper, as on a worn record, is an unlucky seed: make it again on another.": "Што YuE2 прасілі зайграць, па адным інструменце ці стылі за раз, пробамі па дзве хвіліны (першыя — па хвіліне), па два сіды на кожную, A і B. Бываюць пробы выдатныя, A і B сыходзяцца, а інструмент не той, што прасілі. Інструмент фармуе стыль усёй рэчы: назваўшы яго, рухаеш і аранжыроўку. Трэск або шолах паперы, як на зацёртай плытцы, — няўдалы сід: зрабі нанова на іншым.",
+"What YuE2 was asked to play, one instrument or one style at a time, in probes of two minutes (one minute for the first ones), two seeds each, A and B. Some probes are superb, and A and B agree, yet the instrument is not the one asked for.": "Што YuE2 прасілі зайграць, па адным інструменце ці стылі за раз, пробамі па дзве хвіліны (першыя — па хвіліне), па два сіды на кожную, A і B. Бываюць пробы выдатныя, A і B сыходзяцца, а інструмент не той, што прасілі.",
+"An instrument shapes the style of the whole piece: naming one moves the arrangement too.": "Інструмент фармуе стыль усёй рэчы: назваўшы яго, рухаеш і аранжыроўку.",
+"A crackle or a rustle of paper, as on a worn record, is an unlucky seed: make it again on another.": "Трэск або шолах паперы, як на зацёртай плытцы, — няўдалы сід: зрабі нанова на іншым.",
 "{#0} heard by ear": "на слых пачута: {0}",
 "Fails when named so: ask for it as the ancient triangular harp (the row below).": "Пад гэтай назвай не выходзіць: прасі яго як старажытную трохкутную арфу (радок ніжэй).",
 "Probed many times, without success: YuE2 does not know the shofar. The probes always give another pipe or horn, never a shofar, not even close. Its probes (below) are kept: take one as the horn or trumpet it turned out to be. Its adapter knows it: loras/shofar-yt-r16 at epoch 110, Viktor's ear: «Mind-blowing: no shofar player has heard the like. A whole meditation. One hundred percent a Yemenite shofar, an antelope horn two metres long» (167 overtrained, weak and thin; 66 undertrained, a trumpet in it).": "Спрабавалі шмат разоў, без поспеху: YuE2 не ведае шафара. Пробы заўсёды даюць іншую дудку ці рог, ніколі не шафар, нават блізка. Яго пробы (ніжэй) пакінутыя: бяры іх як той рог ці трубу, якімі яны аказаліся. Яго адаптар шафар ведае: loras/shofar-yt-r16 на эпосе 110, вуха Віктара: «Выбух мозгу: ніводзін шафарыст такога не чуў. Цэлая медытацыя. Стопрацэнтна йеменскі шафар, рог антылопы ў два метры» (167 перанатрэнаваная, слабая і тонкая; 66 недатрэнаваная, у ёй труба).",
