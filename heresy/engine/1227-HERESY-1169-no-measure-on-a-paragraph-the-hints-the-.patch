 tools/console/app.js            |  6 +++---
 tools/console/heresy-i18n-be.js |  3 +++
 tools/console/heresy-i18n-el.js |  3 +++
 tools/console/heresy-i18n-es.js |  3 +++
 tools/console/heresy-i18n-it.js |  3 +++
 tools/console/heresy-i18n-ru.js |  3 +++
