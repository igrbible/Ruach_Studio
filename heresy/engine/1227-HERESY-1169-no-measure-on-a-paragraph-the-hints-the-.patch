 /* the rooms say what they are in two lines beside their names (as the Writer) */
-.col-note.col-note-two { white-space: normal; max-width: 430px; line-height: 1.35; align-self: center; }
+.col-note.col-note-two { white-space: normal; line-height: 1.35; align-self: center; flex: 100 1 0; min-width: 0; }   /* the leftover of its row, the title whole */
 .post-head { flex-wrap: wrap; row-gap: 4px; }
 .post-head .post-take { font: 500 16px/1.4 var(--heading); color: var(--ink); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 46%; }
 .post-head .post-take:empty { display: none; }
@@ -4118,7 +4118,7 @@ select option, select optgroup { background-color: var(--panel); color: var(--in
 .hi-legend .hi-lg-no { color: var(--bad); font-style: normal; font-weight: 600; }
 .hi-more { font-size: 14.5px; color: var(--muted); }
 .hi-more summary { cursor: pointer; color: var(--ink); width: max-content; }
-.hi-more p { margin: 6px 0 2px; line-height: 1.5; max-width: 150ch; }
+.hi-more p { margin: 6px 0 2px; line-height: 1.5; }
 .hi-tools input, .hi-tools select, .hi-tools label { font-size: 15px; }
 .hi-table { font-size: 15.5px; }
 .hi-home { font-size: 14px; }
@@ -4436,3 +4436,6 @@ body[data-frame] :is(#view-compose, #view-take) { scrollbar-gutter: stable; }
 .lyr-tagsl > .lyr-tag { position: absolute; border-radius: 2px; background: color-mix(in srgb, var(--amber) 15%, transparent); }
 .lyr-tagsl > .lyr-band { position: absolute; left: 0; right: 0; background: color-mix(in srgb, var(--amber) 7%, transparent); box-shadow: inset 2px 0 0 var(--amber); }
 .lyr-tog.lyr-marks { color: var(--amber); }
+/* HERESY 1169 (Viktor 08.10.2026: «Снова ловлю тебя на хардкорных переносах строк… НИКОГДА НЕ ЛОМАТЬ СТРОКУ… вернуть ломанные
+   строки в их текущие autowrap параграфы»): no measure on a paragraph any more (the hints' 62 and 68ch, the guide's 78 and 80ch,
+   the cheat-sheet's 150ch, the rooms' notes' 430 px): the box sets the width and the text flows to its edge */
diff --git a/tools/console/app.js b/tools/console/app.js
index 6b13960..2e49767 100644
--- a/tools/console/app.js
+++ b/tools/console/app.js
@@ -5655,9 +5655,9 @@
     }).join("");
 
     if (!shown.length) {
-      var empty = STATE.favOnly ? "No favourites yet.<br>Tap ☆ on a take to keep it here."
-        : (STATE.library ? "No takes yet.<br>Every finished song lands here."
-                         : "The server keeps no library (start it with --outputs).<br>Songs made in this tab stay until it reloads.");
+      var empty = STATE.favOnly ? "No favourites yet. Tap ☆ on a take to keep it here."      // HERESY 1169: one paragraph, no break
+        : (STATE.library ? "No takes yet. Every finished song lands here."
+                         : "The server keeps no library (start it with --outputs). Songs made in this tab stay until it reloads.");
       list.innerHTML = running + '<div class="lib-empty">' + empty + "</div>";
       return;
     }
