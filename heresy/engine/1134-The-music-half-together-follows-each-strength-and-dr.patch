-.lora-total-road { position: relative; height: 6px; border-radius: 3px;
-  background: linear-gradient(to right, #3f9a4a 0, #3f9a4a var(--z1), #e0b030 var(--z2), #c8372d var(--z2), #c8372d 100%); }
-.lora-total-road i { position: absolute; top: -4px; width: 3px; height: 14px; margin-left: -1.5px; border-radius: 2px; background: var(--ink);
-  box-shadow: 0 0 0 1px var(--panel); }
 .lora-total.is-amber output { color: #c99a1c; }
 .lora-total.is-red { border-color: #c8372d; border-style: solid; }
 .lora-total.is-red output { color: #c8372d; }
