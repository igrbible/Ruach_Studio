diff --git a/tools/console/app.css b/tools/console/app.css
index e751def..60c6169 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -3030,3 +3030,35 @@ input[type="checkbox"], input[type="radio"] { accent-color: var(--check, var(--a
 #playbar .pb-rate:hover .pb-btn, #playbar .pb-side .time:hover, #playbar:focus-within .pb-tog:focus-visible { opacity: 1; }
 #playbar #timeTotal { cursor: pointer; }
 #playbar .speed-pick { font-variant-numeric: tabular-nums; }
+
+/* HERESY 1113: Unload in the bar, tinted while a model is loaded */
+#unloadModel.is-loaded { background: color-mix(in srgb, var(--bad) 20%, transparent); border-color: color-mix(in srgb, var(--bad) 35%, var(--line)); color: var(--bad-ink, var(--bad)); }
+#unloadModel:disabled:not(.is-loaded) { opacity: .45; }
+
+/* ---------------------------------------------------------------- HERESY 1115: tones and washes
+   Every theme gave flat colours only. Now each theme's own accent and ground give a ramp of tones, mixed in OKLab so
+   the steps look even to the eye, and the surfaces carry them faintly: one base colour, many shades, in every theme
+   without a line added to any theme. Faint on purpose: a working tool, not a salon. */
+:root {
+  --tone-1: color-mix(in oklab, var(--amber) 4%, var(--panel));
+  --tone-2: color-mix(in oklab, var(--amber) 8%, var(--panel));
+  --tone-3: color-mix(in oklab, var(--amber) 14%, var(--panel));
+  --tone-4: color-mix(in oklab, var(--amber) 22%, var(--panel));
+  --wash-1: color-mix(in oklab, var(--amber) 2.5%, var(--ground));
+  --wash-2: color-mix(in oklab, var(--amber) 5%, var(--ground));
+  --shade-1: color-mix(in oklab, var(--ink) 3%, var(--panel));
+}
+/* the bar and the heads of the rooms: a wash that fades */
+.topbar { background-image: linear-gradient(180deg, var(--wash-2), var(--ground)); }
+.col-head { background-image: linear-gradient(90deg, var(--wash-2), transparent 55%); }
+/* the player: a tone from the top, the glass kept */
+#playbar { background: linear-gradient(180deg, color-mix(in oklab, var(--tone-2) 80%, transparent), color-mix(in oklab, var(--panel) 80%, transparent)); }
+/* the Librarian's cards: a breath of the accent at the top; deeper when hovered, checked, playing */
+.coll-card { background: linear-gradient(180deg, var(--tone-1), var(--panel) 70%); }
+.coll-card:hover { background: linear-gradient(180deg, var(--tone-2), var(--tone-1)); }
+.coll-card.is-sel { background: linear-gradient(180deg, var(--tone-3), var(--tone-1)); }
+.coll-card.is-current { background: linear-gradient(180deg, var(--tone-2), var(--panel) 80%); }
+#playbar .pb-cover { box-shadow: 0 4px 12px -6px var(--shadow-lg, rgba(0,0,0,.35)), inset 0 0 0 1px color-mix(in oklab, var(--ink) 8%, transparent); }
+.coll-pin { background: linear-gradient(135deg, var(--tone-3), var(--tone-1)); }
+/* drawers: the summary a shade above the body */
+.drawer > summary { background: linear-gradient(180deg, var(--shade-1), var(--panel)); border-radius: var(--r-md) var(--r-md) 0 0; }
