+/* HERESY 1541 (Viktor 18.10.2026: «Некоторые кнопки с двумя словами переносятся на две строки»): a button's words on one line */
+.btn { white-space: nowrap; }
+/* HERESY 1540 (Viktor 18.10.2026: «…Made from This Take висит в хвосте каждой вкладки и докучает»): the tree its own place in the column;
+   opened, it stands where a step does; otherwise it is out of sight */
+#view-post > .dv-tree-box.is-step-off { display: none; }
+@media (min-width: 1100px) {
+  #view-post > .dv-tree-box { grid-row: 4; margin-top: 4px; }
+}
+#postSteps .ps-step.ps-tree .ps-mark { min-width: 22px; width: auto; padding: 0 4px; font-variant-numeric: tabular-nums; }
+#postSteps .ps-step.ps-tree.is-running .ps-mark { border-color: var(--amber); color: var(--amber); animation: pc-blink 1.2s ease-in-out infinite; }   /* 1540: something is being made */
+/* HERESY 1544: the master's chain: its slots in the console, the limiter's reduction in its device */
+.mc-master .mc-mins { grid-template-columns: 1fr; }
+.dv-lgrm i { background: #c8573d; }
+/* HERESY 1544e: the limiter's card compact; the master's slots only on the console's strip */
+.dv-limc { flex: 0 1 300px; }
+.dv-lim { align-items: flex-start; padding-bottom: 14px; }
+.dv-lim .dv-grm { height: 90px; }
+.dv-master .mc-mins { display: none; }
+/* HERESY 1543: the VCAs: a strip of their own, after the strips */
+.mc-vca { border-top-color: var(--ink); background: color-mix(in srgb, var(--ink) 6%, var(--sunk)); }
+.mc-vca-mid { align-items: center; justify-content: center; gap: 2px; }
+.mc-vca-n { font-size: 18px; line-height: 1; }
+.mc-vca-who { display: flex; flex-wrap: wrap; justify-content: center; gap: 2px; max-width: 64px; }
+.mc-vca-who i { width: 8px; height: 8px; border-radius: 2px; background: var(--mc-hue, var(--dim)); }
+.mc-addvca { flex: 0 0 auto; align-self: flex-start; padding: 6px 8px; border: 1px dashed var(--line); border-radius: 6px; background: transparent; color: var(--dim); font: 600 11px/1 inherit; cursor: pointer; white-space: nowrap; }
+.mc-addvca:hover:not(:disabled) { color: var(--ink); border-color: var(--amber); }
+.dv-vcac { flex: 1 1 480px; }
+.dv-vname { display: flex; align-items: center; gap: 8px; }
+.dv-vname input { flex: 0 1 260px; }
