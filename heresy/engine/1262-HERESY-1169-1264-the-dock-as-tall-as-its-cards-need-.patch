 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/tools/console/app.css b/tools/console/app.css
index 24b107c..0d30fc5 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -3141,8 +3141,9 @@ body[data-tab="train"] .log-dock.is-tall .log-dock-body { height: calc(100vh - v
 @media (max-width: 1180px) { .log-dock.has-gpus:not(.is-folded) { width: min(600px, calc(100vw - 32px)); }
   .log-dock.has-gpus.is-tall { width: min(860px, calc(100vw - 32px)); }
   .log-dock.has-gpus .log-dock-main { grid-template-columns: minmax(0, 1fr); } .log-dock-gpus { display: none; } }
-.log-dock.has-gpus:not(.is-folded) .log-dock-body { height: auto; min-height: calc(10 * 1.5 * 11px + 16px); }
-.log-dock.has-gpus.is-tall .log-dock-body { height: calc(100vh - var(--bar-h) - var(--playbar-h, 60px) - 74px); }
+.log-dock.has-gpus:not(.is-folded):not(.is-tall) .log-dock-body,
+.log-dock.has-gpus:not(.is-folded):not(.is-tall) .log-dock-gpus { height: var(--gl-h, calc(10 * 1.5 * 11px + 16px)); }
+.log-dock.has-gpus.is-tall .log-dock-body, .log-dock.has-gpus.is-tall .log-dock-gpus { height: calc(100vh - var(--bar-h) - var(--playbar-h, 60px) - 74px); }
 .gl-card { display: flex; flex-direction: column; gap: 3px; padding: 5px 8px 6px; border: 1px solid var(--line-a, var(--line)); border-radius: var(--r-sm, 4px); }
 .gl-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; min-width: 0; }
 .gl-head .gl-name { flex: none; }
diff --git a/tools/console/heresy-gpulive.js b/tools/console/heresy-gpulive.js
index 96181a6..471ee89 100644
--- a/tools/console/heresy-gpulive.js
+++ b/tools/console/heresy-gpulive.js
@@ -103,6 +103,8 @@
       card.querySelector(".gl-nums").innerHTML = nums(ring);
       draw(card.querySelector("canvas"), ring, false);
     });
+    // the dock as tall as its cards need (the log beside them as tall), never more than 60 % of the window: both scroll inside
+    dock.style.setProperty("--gl-h", Math.min(Math.max(host.scrollHeight, 181), Math.round(innerHeight * 0.6)) + "px");
   }
   function paint(on) {
     if (on.indexOf("engine") >= 0) paintEngine();
