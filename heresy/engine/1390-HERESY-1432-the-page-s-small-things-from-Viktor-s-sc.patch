+
+/* HERESY 1432 (Viktor 14.10.2026, «Скрины - looks ugly» and the list after them) ----------------------------------------- */
+/* the Artist's hidden state: never a field on screen, whatever a .field rule says (1428 hid it by the attribute alone) */
+#arPainter, #arModel { display: none !important; }
+/* ▶ Play this song: filled, two of the take's icons wide, in their row */
+#playHere { width: 75px; min-width: 75px; height: 30px; padding: 0; display: inline-flex; align-items: center; justify-content: center; }
+#playHere.is-hidden { display: none; }
+#playHere .ui-ico { width: 17px; height: 17px; fill: currentColor; stroke-width: 1.6; margin-left: 2px; }
+/* Save style and Delete as icons beside the saved styles */
+.lib-row .style-ico { width: 34px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center; flex: none; }
+.lib-row .style-ico .ui-ico { width: 16px; height: 16px; }
+.lib-row .style-ico.danger:not(:disabled):hover { color: var(--bad); border-color: var(--bad-line); }
+/* the takes' ⋯ menu: its words on one line, every item on the same indent as the ticked ones */
+#libMenu { min-width: 0; width: max-content; max-width: min(380px, calc(100vw - 24px)); padding: 6px; }
+#libMenu button { white-space: nowrap; padding: 7px 14px 7px 10px; font-size: 13px; line-height: 1.35; }
+#libMenu button[role="menuitem"]::before { content: ""; display: inline-block; width: 1.2em; }
+#libMenu .menu-cap { padding: 4px 10px 2px; }
+/* the lyrics' «[» list: no sideways scroll; a long hint gives way before the tag does */
+.tc-cols { grid-template-columns: 264px minmax(0, 1fr); }
+.tc-cols > .tc-list { overflow-x: hidden; }
+.tc-item { min-width: 0; }
+.tc-tag { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
+.tc-say { flex: 0 3 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
+/* the MP3 bitrate drawn as the buttons beside it, its number whole */
+.split-btn > .mp3-rate { align-self: stretch; width: auto; min-width: 4.9em; padding: 0 4px 0 7px; background-color: transparent; color: var(--muted);
+  font: inherit; font-size: 11.5px; border: 1px solid var(--line-a); }
+.split-btn > .mp3-rate:hover { color: var(--ink); }
+/* the bar's ☰: its labels (MODEL, VAE) whole in every language */
+.head-more-pop { width: 360px; }
+.head-more-row { grid-template-columns: 84px minmax(0, 1fr); }
+/* a folded takes list opened over the take by the mouse */
+.library.is-folded.is-peek { width: var(--lib-peek-w, 380px); margin-left: calc(40px - var(--lib-peek-w, 380px)); z-index: 35; position: relative;
+  border-left: 1px solid var(--line-a); box-shadow: -18px 0 34px -22px var(--shadow-lg); }
+.library.is-folded.is-peek > .lib-unfold { display: none; }
+/* a menu with no room under it opens upwards (1432) */
+.menu-wrap > .menu-pop.is-up { top: auto; bottom: calc(100% + 6px); }
