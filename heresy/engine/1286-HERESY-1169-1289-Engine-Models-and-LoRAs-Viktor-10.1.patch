 }
+/* HERESY 1289: the Models and LoRAs card: a part of what the install brings a row (its name, size and sum | its Fetch), what is
+   not here listed under it; an extra a row (its name and what it is | its variant | its Fetch); a run's words under them */
+.wt-line.is-good { color: var(--good); }
+.wt-line.is-bad { color: var(--bad); }
+.wt-parts, .wt-extras { display: flex; flex-direction: column; }
+.wt-part, .wt-extra { padding: 7px 0; border-top: 1px solid var(--line-soft); }
+.wt-part:first-child, .wt-extra:first-child { border-top: 0; }
+.wt-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
+.wt-head b, .wt-x-name b { font-weight: 600; }
+.wt-size, .wt-sum { font-size: 12.5px; color: var(--muted); }
+.wt-part.is-whole .wt-sum { color: var(--good); }
+.wt-head .btn { margin-left: auto; }
+.wt-rows { list-style: none; margin: 5px 0 0; padding: 0; display: flex; flex-direction: column; gap: 3px; }
+.wt-row { display: flex; gap: 10px; align-items: baseline; font-size: 12.5px; }
+.wt-row code { font: 12px var(--mono); overflow-wrap: anywhere; -webkit-user-select: text; user-select: text; }
+.wt-st { flex: 0 0 auto; min-width: 58px; font: 600 11.5px var(--mono); color: var(--muted); }
+.wt-st.is-here, .wt-st.is-fetched { color: var(--good); }
+.wt-st.is-missing, .wt-st.is-differs, .wt-st.is-unknown { color: var(--amber); }
+.wt-st.is-failed { color: var(--bad); }
+.wt-extra { display: grid; grid-template-columns: minmax(0, 1fr) minmax(190px, auto) auto; gap: 6px 14px; align-items: center; }
+.wt-x-name { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
+.wt-x-name span { font-size: 12px; color: var(--muted); }
+.wt-extra select { width: auto; }
+.wt-log { margin: 10px 0 0; max-height: 240px; overflow: auto; padding: 8px 10px; border-radius: var(--r-sm); background: var(--sunk);
+  font: 12px/1.45 var(--mono); white-space: pre-wrap; overflow-wrap: anywhere; -webkit-user-select: text; user-select: text; }
+.wt-log .wt-st { min-width: 0; }
+/* HERESY 1289: a button the Engine hides stays hidden: .btn's own display won over the attribute (Updates' «Update» and «What's
+   new» showed with nothing new, getComputedStyle 10.10.2026), as the GPU card's rule of its own already says for its button */
+.engine-grid .btn[hidden] { display: none; }
+@media (max-width: 760px) { .wt-extra { grid-template-columns: minmax(0, 1fr); } .wt-head .btn { margin-left: 0; } }
 /* HERESY 1283: the Folders card, a folder a row: its name and what it holds | where it lives | its size | its buttons */
 .pl-rows { display: flex; flex-direction: column; }
 .pl-row { display: grid; grid-template-columns: minmax(150px, 1.1fr) minmax(0, 3fr) minmax(120px, auto) auto; gap: 6px 16px; align-items: center;
