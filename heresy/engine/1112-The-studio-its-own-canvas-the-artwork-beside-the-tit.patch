diff --git a/tools/console/app.css b/tools/console/app.css
index d282ecd..4eb3df4 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -3163,13 +3163,16 @@ html.i18n-wait body { visibility: hidden; }
 .topbar .engine-chip .lamp { width: 10px; height: 10px; }
 
 /* ---------------------------------------------------------------- HERESY 1120: artwork
-   The player's square shows the take's artwork when it has one; a Librarian card wears it under its play button. */
+   The player's square shows the take's artwork when it has one. HERESY 1154 (Viktor: «не в кнопку плей, а справа от
+   заголовка трека»; in the play button it broke the card): a Librarian card wears it in its top right corner, beside the
+   title, a link to the whole picture; in the list, a small one before the card's buttons. */
 #playbar .pb-cover.has-art svg { display: none; }
-.coll-play.has-art { width: 44px; height: 44px; border-radius: 8px; background-size: cover; background-position: center; color: #fff;
-  box-shadow: 0 2px 8px -3px var(--shadow-lg, rgba(0,0,0,.35)); }
-.coll-play.has-art .ui-ico { filter: drop-shadow(0 1px 2px rgba(0,0,0,.6)); opacity: .9; }
-.coll-play.has-art:hover { transform: scale(1.05); color: #fff; }
-.coll-play.has-art.is-playing { color: #fff; outline: 2px solid var(--amber-a); outline-offset: 1px; }
+.coll-art { position: absolute; top: 10px; right: 10px; width: 46px; height: 46px; border-radius: 8px; background-size: cover;
+  background-position: center; box-shadow: 0 2px 8px -3px var(--shadow-lg, rgba(0,0,0,.35)); cursor: zoom-in; transition: transform .12s; }
+.coll-art:hover { transform: scale(1.06); }
+.coll-card.has-art .coll-body { padding-right: 54px; }
+.coll-grid.list .coll-art { position: static; width: 28px; height: 28px; border-radius: 5px; flex: none; }
+.coll-grid.list .coll-card.has-art .coll-body { padding-right: 0; }
 
 /* HERESY 1124 (Viktor, 02.10): the datasheet's style and lyrics reach down to where the parameters end; the lyrics
    take the room that is left and scroll inside it (its height 0 + grow: the parameters, not the words, set the row) */
