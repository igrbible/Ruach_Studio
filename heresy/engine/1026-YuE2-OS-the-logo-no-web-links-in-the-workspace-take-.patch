diff --git a/tools/console/app.css b/tools/console/app.css
index bb81573..15ad4e4 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -2049,3 +2049,14 @@ body[data-tab="write"] .col-grip.left, body[data-tab="post"] .col-grip.left { di
 .in-bar > em { position: absolute; left: 0; right: 0; bottom: 2px; font-style: normal; font-size: 10px; text-align: center; color: var(--ink); text-shadow: 0 0 3px var(--panel); }
 .in-list { display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 12.5px; }
 .in-item { white-space: nowrap; }
+
+/* HERESY 1026: the YuE2 OS logo. Day: burgundy clef, ink word, OS white on burgundy.
+   Night: coral clef, light word, OS dark on coral: the plate inverts with the theme. */
+.brand-logo { display: inline-flex; align-items: center; gap: 7px; user-select: none; }
+.brand-clef { fill: var(--amber); flex: none; margin-top: 2px; }
+.brand-word { font: 400 22px/1 var(--display); letter-spacing: .01em; color: var(--ink); }
+.brand-word .two { color: var(--amber); }
+.brand-os { font: 700 11px/1 var(--mono); letter-spacing: .14em; padding: 4px 4px 4px 6px; border-radius: 4px;
+  background: var(--amber); color: var(--on-amber); transform: translateY(-1px); }
+.take-id { text-transform: none; letter-spacing: 0; background: none; border: 0; padding: 0; font-size: 11.5px; color: var(--dim); cursor: copy; user-select: all; }
+.take-id:hover, .take-id:focus-visible { color: var(--amber); }
