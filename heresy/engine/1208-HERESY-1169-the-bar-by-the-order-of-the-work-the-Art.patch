diff --git a/tools/console/app.css b/tools/console/app.css
index bd7882b..8e70259 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -4285,3 +4285,31 @@ body[data-frame="compose"] #view-compose, body[data-frame="take"] #view-take {
 /* New song: its double icon twice as wide, and the button with it */
 #newSong .hz-icon { width: 34px; }
 #newSong.btn.icon-only { min-width: 72px; }
+/* HERESY 1169 (Viktor 07.10.2026: «Творец → Писатель → Огранщик → (Художник) → Библиотекарь ЛОГО Trainer»): the Artist's place
+   greyed until the room comes; the Trainer, a room of another kind, a pill of its own: after the rooms where the bar has no
+   logo, right of it where it has. It stands by the TALL bar's logo (98 + 10 px high, its width by its proportions in the page's
+   language, --logo-aspect from fitBar), so it stays put while the logo grows and shrinks with the bar (1167: «абы только не
+   сбивал лево/право») */
+.tabs .tab-soon { opacity: .4; cursor: default; }
+.tabs .tab-soon:hover { color: var(--muted); }
+.topbar .tabs-side { margin-left: 0; }
+@media (min-width: 1660px) {
+  .topbar .tabs-side { position: absolute; top: 50%; transform: translateY(-50%); left: calc(50% + 54px * var(--logo-aspect, 4.1423) + 18px); }
+}
+/* the Refiner's way out: at its head's end, beside the take in hand; in Stems, at the end of the split's row */
+.post-head .post-daw { margin-left: auto; align-self: center; }
+.dv-actions .dv-daw { margin-left: auto; }
+/* HERESY 1169 (Viktor 07.10.2026: «в Музыканте… съехали не кнопки его, а именно <> и X»; «В композиторе по высоте вся полоса
+   идеальна»; «иконки кнопок мелкие во втором фрейме»): over the room, the take's ⇆ and ⤡ stand in its head's row as Compose's
+   do, level with the take's buttons and ending where the frame's content ends (the top right corner stays theirs in the room,
+   where the head wraps: 1168); the take's buttons in Compose's box with Compose's icon size */
+body[data-frame="take"] #view-take > .col-head { padding-right: 22px; }
+@media (max-width: 1500px) { body[data-frame="take"] #view-take > .col-head { padding-right: 16px; } }
+body[data-frame="take"] #view-take > .col-head > .frame-tools { position: static; }
+.head-actions .icon-act { padding: 0 9px; min-width: 34px; height: 30px; display: inline-flex; align-items: center; justify-content: center; }
+.head-actions .icon-act svg { width: 17px; height: 17px; }
+.head-actions .icon-act .ui-ico { stroke-width: 1.8; }
+#favTake[aria-pressed="true"] > .ui-star { fill-opacity: 1; }
+/* HERESY 1169 (Viktor 07.10.2026: «A run is in progress… забирает лишнюю строку с футера… можно поднять в уровень с кнопкой
+   Generate»): the bar's note on the bar's own row, left of Takes; a line of its own only where the row has no room for it */
+.submit-note { order: -1; flex: 1 1 260px; min-width: 0; }
