+                    G.cap  = h ? g.cap_nar : g.cap;
+                    G.mode = g.mode;
+                    p->lora_rt_groups[h].push_back(G);
+                }
             }
         }
     }
@@ -604,8 +606,8 @@ static bool pipeline_generate(Yue2Pipeline *          p,
