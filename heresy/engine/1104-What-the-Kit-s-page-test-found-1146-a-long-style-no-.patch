Date: Sat, 3 Oct 2026 00:20:29 -0600
Subject: [PATCH 1104/1252] What the Kit's page test found (1146): a long style
 no longer hidden after Retake, Reuse, Open and Edit and re-render (every box
 refit when the form lands after a fetch); the score's head wraps in a narrow
 take column; tips for the form's last ten controls, a label's tip counting as
 its control's help

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/console/app.css    |  4 ++++
 tools/console/app.js     |  2 ++
 tools/console/help.js    |  1 +
 tools/console/index.html | 18 +++++++++---------
 4 files changed, 16 insertions(+), 9 deletions(-)

diff --git a/tools/console/app.css b/tools/console/app.css
index 022b416..277cccd 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -3290,3 +3290,7 @@ body[data-tab="post"] .lib-refined { display: inline-flex; }
   #playbar .pb-side { margin-left: auto; gap: 6px; }
   #playbar .time { font-size: 11.5px; white-space: nowrap; }
 }
+
+/* HERESY 1145: the score's head wraps in a narrow take column (the Kit's page test at 1280 px: its last button, Full screen,
+   stood 54 px past the column) */
+.score-head { flex-wrap: wrap; row-gap: 6px; }
diff --git a/tools/console/app.js b/tools/console/app.js
index c313601..d5bf37f 100644
--- a/tools/console/app.js
+++ b/tools/console/app.js
@@ -1309,6 +1309,7 @@
     syncShape();
     paintOutput();
     growLyrics();
+    queueComfort();   // HERESY 1145: every box's height, the style's too: Retake, Reuse and Open land after their click
   }
 
   $("openPrompt").addEventListener("click", function () { $("openFile").click(); });
@@ -3250,6 +3251,7 @@
       if (MODES[take.cot] && take.cot !== "off") setCot(take.cot);
       setCodes(null);
       growLyrics();
+      queueComfort();   // HERESY 1145: the style box's height too (this lands after the click)
       $("scoreDrawer").open = true;
       show("compose");
       $("abc").focus();
diff --git a/tools/console/help.js b/tools/console/help.js
index 7c28a5a..ea45293 100644
--- a/tools/console/help.js
+++ b/tools/console/help.js
@@ -279,6 +279,7 @@
 
   function hasHelp(el) {
     if (el.dataset.tip || el.dataset.tipRef) return true;
+    if (el.closest("label[data-tip]")) return true;           // HERESY 1145: a tip on the control's own label (a file button's)
     var scope = el.closest("label.knob, label.shape-row, label.check, label.versions, .field, fieldset") || el.parentNode;
     if (scope && scope.querySelector(".info")) return true;
     if (el.nextElementSibling && el.nextElementSibling.classList.contains("info")) return true;
