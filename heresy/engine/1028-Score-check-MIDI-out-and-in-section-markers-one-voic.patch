+      ev.push([0, [0xff, 0x03].concat(vlq(t.length), t), seq++]);
+      ev.push([0, [0xc0 | ch, name === "Vocal" ? 52 : 48], seq++]);     // choir aahs · strings: a sketch, not a mix
