diff --git a/tools/console/app.css b/tools/console/app.css
index 6510c6c..091f66b 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -4179,6 +4179,11 @@ select option, select optgroup { background-color: var(--panel); color: var(--in
   font: 400 clamp(12px, .95vw, 16px)/1.45 var(--sans); color: var(--dim); animation: boot-in 1.1s .15s ease both; }
 .boot-osem b { font-weight: 600; color: var(--ink); font-size: 1.12em; letter-spacing: .6em; margin-right: -.6em; }
 .boot-osem .boot-osem-say { font-style: italic; color: var(--muted); }
+/* HERESY 1286 (Viktor 09.10.2026: «OSEM с девизом сделай на 20% крупнее, дай больше пространства между Лого и OSEM, а также сам
+   прогресс бар опусти в подвал, 160 пикселов от пола»): the slogan a fifth larger and 32 px further from the logo; the line at the
+   foot, 160 px above the window's floor */
+.boot-osem { margin-top: 26px; font-size: clamp(14.4px, 1.14vw, 19.2px); }
+html.booting .boot-veil .boot-line { position: absolute; left: 50%; bottom: 160px; transform: translateX(-50%); }
 /* HERESY 1167 (Viktor: «Карточки у библиотекаря до сих пор слишком красные. Возьми начальный #f2edef и в градиенте дневной темы
    доводи его в правый низ… до нулевой альфы»): by day the card's wash from #f2edef in its top left to nothing at its bottom
    right; a little deeper when hovered, held or checked */
