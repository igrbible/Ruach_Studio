+.tr-read { margin-left: auto; color: var(--amber) !important; }
+.tr-plot { position: relative; padding-left: 44px; }
+.tr-ylab { position: absolute; left: 0; top: 0; bottom: 0; width: 40px; font-size: 10px; color: var(--dim); }
+.tr-ylab span { position: absolute; right: 2px; transform: translateY(-50%); }
+.tr-plot svg { display: block; width: 100%; height: 150px; cursor: crosshair; }
+.tr-plot line.g { stroke: var(--line-soft, var(--line)); stroke-width: 1; vector-effect: non-scaling-stroke; }
+.tr-plot line.t { stroke: var(--dim); stroke-width: 1; opacity: .55; vector-effect: non-scaling-stroke; }
+.tr-plot line.t.on { stroke: var(--good); stroke-width: 2; opacity: 1; }
+.tr-plot line.t.sel { stroke: var(--amber); stroke-width: 1.5; opacity: 1; stroke-dasharray: 3 3; }
+.tr-plot line.cur { stroke: var(--amber); stroke-width: 1; vector-effect: non-scaling-stroke; }
+.tr-plot path.raw { fill: none; stroke: var(--muted); stroke-width: 1; opacity: .35; vector-effect: non-scaling-stroke; }
+.tr-plot path.avg { fill: none; stroke: var(--ink); stroke-width: 2; vector-effect: non-scaling-stroke; }
+.tr-chart[data-key="ar_ce"] path.avg { stroke: var(--amber); }
+.tr-say { margin: 0; font-size: 11.5px; line-height: 1.45; color: var(--dim); }
+.tr-epochs { display: flex; flex-direction: column; gap: 8px; }
+.tr-ehead { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
+.tr-echips { display: flex; flex-wrap: wrap; gap: 4px; max-height: 120px; overflow: auto; }
+.tr-echips .coll-chip.is-in { border-color: color-mix(in srgb, var(--good) 55%, transparent); color: var(--good); }
+.tr-echips .coll-chip.is-on { border-color: var(--amber); box-shadow: inset 0 0 0 1px var(--amber); color: var(--ink); }
+.tr-eact { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 8px 10px; border: 1px dashed var(--amber-dim); border-radius: var(--r-md); font-size: 12.5px; }
+.tr-facts summary { cursor: pointer; font-size: 12px; color: var(--muted); }
+.tr-fgrid { display: flex; flex-wrap: wrap; gap: 4px 18px; margin-top: 6px; font-size: 12.5px; }
+.tr-fgrid em { font-style: normal; color: var(--dim); margin-right: 4px; }
+/* the player in this room: it steps down to a strip and comes up under the mouse; what plays plays on */
+body[data-tab="train"] .playbar { transform: translateY(calc(100% - 8px)); transition: transform .22s ease .3s; }
+body[data-tab="train"] .playbar:hover, body[data-tab="train"] .playbar:focus-within { transform: none; transition-delay: 0s; }
+body[data-tab="train"] .playbar::before { content: ""; position: absolute; top: 2px; left: 50%; width: 48px; height: 3px; margin-left: -24px; border-radius: 2px; background: var(--line-strong); }
+body[data-tab="train"] .playbar:has(.play.is-playing)::before { background: var(--amber); width: 120px; margin-left: -60px; }
+body[data-tab="train"] .workspace { height: calc(100vh - 52px - 8px); }
