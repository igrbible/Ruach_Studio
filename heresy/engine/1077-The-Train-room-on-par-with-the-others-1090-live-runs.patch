+.tr-tile b { font: 600 14px var(--mono); }
+.tr-charts { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 12px; }
+.tr-chart { margin: 0; display: flex; flex-direction: column; gap: 6px; padding: 10px 12px; border: 1px solid var(--line-soft, var(--line)); border-radius: var(--r-md); background: var(--ground); }
+.tr-chart figcaption { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; font-size: 12.5px; }
