+/* ===================================================================== HERESY 1090: the Train room, on par
+   (Viktor, 02.10.2026): live runs on top, the steps in a row as in Post, the telemetry, a column of run cards */
+.train-col { padding-bottom: 28px; }
+.tr-layout { display: grid; grid-template-columns: minmax(0, 1fr) clamp(280px, 22vw, 380px); gap: 18px; align-items: start; }
+.tr-layout.is-folded { grid-template-columns: minmax(0, 1fr) 40px; }
+.tr-main { min-width: 0; display: flex; flex-direction: column; gap: 12px; }
+.tr-side { position: sticky; top: 62px; display: flex; flex-direction: column; max-height: calc(100vh - 52px - var(--playbar-h, 60px) - 80px);
+  min-height: 320px; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--panel); overflow: hidden; }
+.tr-side .lib-head { padding: 12px 12px 10px 16px; }
+.tr-filters { display: flex; flex-wrap: wrap; gap: 4px; padding: 8px 12px 0; }
+.tr-side .lib-search { padding: 8px 12px; }
+.tr-side .lib-search input { width: 100%; padding: 6px 9px; font-size: 12.5px; }
+.tr-rlist { flex: 1; overflow-y: auto; padding: 4px 8px 10px; display: flex; flex-direction: column; gap: 4px; }
+.tr-empty { padding: 10px 8px; }
+.tr-unfold { display: none; }
+.tr-layout.is-folded .tr-side > :not(.tr-unfold) { display: none !important; }
+.tr-layout.is-folded .tr-unfold { display: flex; flex-direction: column; align-items: center; gap: 10px; width: 100%; padding: 14px 0; border: 0;
+  background: none; color: var(--muted); cursor: pointer; min-height: 200px; }
+.tr-layout.is-folded .tr-unfold:hover { color: var(--amber); background: var(--hover); }
+/* a run card, as a take in Create's column; a running one lit as a playing take */
+.tr-rcard { position: relative; padding: 10px 12px; border: 1px solid transparent; border-radius: var(--r-md); cursor: pointer; transition: background .13s ease, border-color .13s ease; }
+.tr-rcard:hover { background: var(--hover-soft, var(--raise)); }
+.tr-rcard:focus-visible { outline: 0; border-color: var(--amber); }
+.tr-rcard.is-selected { background: var(--raise); border-color: var(--line); box-shadow: inset 2px 0 0 var(--amber); }
+.tr-rcard.is-running { background: color-mix(in srgb, var(--amber) 12%, transparent); border-color: var(--amber-dim); box-shadow: inset 4px 0 0 var(--amber); }
+.tr-rcard.is-running .tr-rtitle { color: var(--amber); }
+.tr-rcard.is-archived { opacity: .75; }
+.tr-rtitle { font-size: 13.5px; font-weight: 600; padding-right: 26px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.tr-rsub { font-size: 11.5px; color: var(--dim); margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.tr-spark { display: block; width: 100%; height: 18px; margin-top: 6px; }
+.tr-spark path { fill: none; stroke: var(--muted); stroke-width: 1.3; vector-effect: non-scaling-stroke; }
+.tr-rcard.is-running .tr-spark path { stroke: var(--amber); }
+.tr-rbar { height: 3px; margin-top: 6px; border-radius: 2px; background: var(--sunk); overflow: hidden; }
+.tr-rbar i { display: block; height: 100%; background: var(--amber); }
+.tr-rcard .take-foot { margin-top: 6px; }
+.tr-rmenu { position: absolute; top: 6px; right: 6px; width: 24px; height: 22px; border: 1px solid transparent; border-radius: var(--r-sm); background: none;
+  color: var(--dim); cursor: pointer; opacity: .6; }
+.tr-rcard:hover .tr-rmenu, .tr-rmenu:focus-visible { opacity: 1; border-color: var(--line); background: var(--panel); }
+.tr-menu { min-width: 180px; z-index: 140; }
+.tr-menu a { display: block; padding: 7px 12px; color: var(--muted); text-decoration: none; font-size: 13px; }
+.tr-menu a:hover { background: var(--hover); color: var(--ink); }
+.tr-racts { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
+.tr-rcard.is-trash { cursor: default; }
+.tr-rcard.is-trash .tr-racts { margin-top: 8px; }
+.tr-st { text-transform: uppercase; }
+.tag.tr-st.is-running { color: var(--amber); border-color: var(--amber-dim); }
+.tag.tr-st.is-done { color: var(--good); border-color: color-mix(in srgb, var(--good) 45%, transparent); }
+.tag.tr-st.is-failed { color: var(--bad); border-color: color-mix(in srgb, var(--bad) 45%, transparent); }
+/* on top: what trains now */
+.tr-live { display: flex; flex-direction: column; gap: 6px; }
+.tr-live[hidden] { display: none; }
+.tr-liverow { display: grid; grid-template-columns: minmax(200px, 30%) minmax(120px, 1fr) auto; align-items: center; gap: 14px; width: 100%; padding: 9px 14px;
+  border: 1px solid var(--amber-dim); border-radius: var(--r-md); background: color-mix(in srgb, var(--amber) 8%, var(--panel)); color: var(--ink);
+  box-shadow: inset 4px 0 0 var(--amber); font: inherit; text-align: left; cursor: pointer; }
+.tr-liverow:hover, .tr-liverow.is-on { background: color-mix(in srgb, var(--amber) 15%, var(--panel)); }
+.tr-lname { display: flex; align-items: baseline; gap: 8px; min-width: 0; }
+.tr-lname b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.tr-lname em { font-style: normal; font-size: 11.5px; color: var(--dim); white-space: nowrap; }
+.tr-pulse { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--amber); align-self: center; animation: tr-pulse 1.6s ease-in-out infinite; }
+@keyframes tr-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
+.tr-lbar { height: 6px; border-radius: 3px; background: var(--sunk); overflow: hidden; }
+.tr-lbar i { display: block; height: 100%; background: var(--amber); transition: width .6s ease; }
+.tr-lnums { font-size: 11.5px; color: var(--muted); white-space: nowrap; }
+@media (max-width: 1300px) { .tr-liverow { grid-template-columns: 1fr; gap: 6px; } }
+/* the steps in a row, and their panes */
+.tr-pills { margin: 0; }
+.tr-pills .ps-say { max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.tr-pane { display: none; flex-direction: column; gap: 12px; padding: 14px 16px; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--panel); }
+.tr-pane.is-on { display: flex; }
+.tr-phead { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
+.tr-phead b { font-size: 15px; }
+.tr-sets { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 6px; }
+.tr-setpick { display: flex; flex-direction: column; gap: 2px; padding: 8px 12px; border: 1px solid var(--line); border-radius: var(--r-md); cursor: pointer; font-size: 13px; }
+.tr-setpick input { position: absolute; opacity: 0; pointer-events: none; }
+.tr-setpick span { font-size: 11.5px; color: var(--muted); }
+.tr-setpick:hover { border-color: var(--line-strong); }
+.tr-setpick.is-on { border-color: var(--amber); box-shadow: inset 2px 0 0 var(--amber); }
+.tr-knobs { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px 12px; align-items: end; }
+.tr-knobs .field { width: auto; min-width: 0; }
+.tr-knobs input[type="number"] { width: 100%; }
+.tr-knobs .tr-wide { grid-column: span 2; }
+.tr-knobs .check { align-self: center; }
+.tr-listen[hidden] { display: none; }
+.tr-listen summary { cursor: pointer; }
+/* 4 Telemetry */
+.tr-rhead { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
+.tr-rname { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
+.tr-rname b { font-size: 16px; }
+.tr-note { margin: -4px 0 0; }
+.tr-prog { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 12px; }
+.tr-pbar { height: 8px; border-radius: 4px; background: var(--sunk); overflow: hidden; }
