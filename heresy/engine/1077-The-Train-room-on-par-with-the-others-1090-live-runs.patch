+.tr-prog.is-live .tr-pbar i { background: var(--amber); }
+.tr-prog span { font-size: 12px; color: var(--muted); }
+.tr-tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: 6px; }
