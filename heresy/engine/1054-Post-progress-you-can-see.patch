+/* HERESY 1060: progress in Post: a bar under every job in the tree, and a floating card while Forge works */
+.job-bar { height: 4px; margin-top: 6px; border-radius: 2px; background: var(--sunk); overflow: hidden; }
+.job-bar i { display: block; height: 100%; background: linear-gradient(90deg, var(--amber), var(--amber-hi), var(--amber)); background-size: 200% 100%;
+  animation: pc-flow 1.4s linear infinite; transition: width .9s linear; }
+.job-bar.is-queued i { background: var(--line-strong); animation: none; }
+.dv-group.is-running { opacity: 1; }
+.post-jobs { position: fixed; right: 18px; bottom: calc(var(--playbar-h) + 14px); z-index: 40; width: 300px; padding: 10px 12px; border: 1px solid var(--line-strong);
+  border-radius: var(--r-md); background: var(--panel); box-shadow: 0 12px 30px var(--shadow-lg); display: flex; flex-direction: column; gap: 8px; }
+.post-jobs[hidden] { display: none; }
+.pj-cap { font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
+.pj-head { display: flex; justify-content: space-between; gap: 8px; font-size: 12.5px; }
+.pj-head span { color: var(--muted); font-size: 12px; }
