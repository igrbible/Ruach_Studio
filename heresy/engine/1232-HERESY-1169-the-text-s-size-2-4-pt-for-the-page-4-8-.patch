Viktor 07.10.2026: «три кнопочки svg -, +, reset для скейла… глобальный скейл шрифтов с минус 2 и плюс до 4… в спадающее меню в баре». 08.10: «в Комнате Библиотекаря наведи порядок с кнопками и SVG иконками»; «Конечный тег изменил из суновского [END] на [End]»; «всё, что с начальным диамандом 💎, чтобы алфавитно шло вниз древа… суфиксные 💎 ... LoRA гони в самый низ как вечное правило». build.sh writes every font size as calc(N + var(--fs, 0pt)) (both copies).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/console/app.css               | 25 +++++++++++++++
 tools/console/app.js                | 34 ++++++++++++++++++++
 tools/console/heresy-collection.js  | 15 +++++++--
 tools/console/heresy-complete.js    |  3 +-
 tools/console/heresy-icons.js       | 13 ++++++++
 tools/console/heresy-instruments.js |  2 +-
 tools/console/index.html            | 50 ++++++++++++++++++-----------
 7 files changed, 120 insertions(+), 22 deletions(-)

diff --git a/tools/console/app.css b/tools/console/app.css
index 2270972..6b67e90 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -4484,3 +4484,28 @@ body[data-tab="create"] #library .lib-head { padding-top: 11px; }
    bracket to look at amber (over a mark's amber) */
 .lyr-num.is-lint-bad { color: var(--bad); opacity: 1; font-weight: 700; }
 .lyr-num.is-lint-near { color: #d9a441; opacity: 1; }
+/* HERESY 1169 (Viktor 07.10.2026: «три кнопочки svg -, +, reset для скейла… глобальный скейл шрифтов… в спадающее меню в баре»): every
+   font size is calc(N + var(--fs, 0pt)) since the build (build.sh); --fs is the page's (☰) and, in a lifted frame, the page's and the
+   frame's together. The frame's buttons show only while a frame is up */
+:root { --fs-g: 0pt; --fs-f: 0pt; --fs: var(--fs-g); }
+body[data-frame="compose"] #view-compose, body[data-frame="take"] #view-take { --fs: calc(var(--fs-g) + var(--fs-f)); }
+.fs-btns { display: inline-flex; gap: 4px; }
+.frame-fs { display: inline-flex; margin-right: 10px; }
+body:not([data-frame]) .frame-fs { display: none; }
+.hm-fs { display: flex; align-items: center; gap: 6px; padding: 2px 4px 2px 10px; min-height: 34px; }
+.hm-fs-name { flex: 1; font-size: 13px; color: var(--ink); }
+.hm-fs-val { min-width: 5ch; text-align: right; font-size: 12px; color: var(--muted); }
+/* HERESY 1169 (Viktor 08.10.2026: «в Комнате Библиотекаря наведи порядок с кнопками и SVG иконками»): the bar of the checked in
+   one row of groups, each a frame around its icons; the trash at the end */
+.coll-bulk { flex-wrap: nowrap; gap: 10px; }
+.coll-bulk .coll-count { flex: none; min-width: 9ch; }
+.coll-group { display: inline-flex; align-items: center; gap: 4px; padding: 3px; border: 1px solid var(--line-a); border-radius: var(--r-md); flex: none; }
+.coll-group select { max-width: 200px; }
+.coll-bulk .icon-btn .ui-ico { width: 17px; height: 17px; }
+.icon-check { position: relative; display: inline-grid; place-items: center; width: 32px; height: 30px; border: 1px solid transparent; border-radius: 2px; cursor: pointer; color: var(--muted); }
+.icon-check input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
+.icon-check .ui-ico { width: 17px; height: 17px; }
+.icon-check:hover { border-color: var(--amber); color: var(--ink); }
+.icon-check:has(input:checked) { border-color: var(--amber); color: var(--amber); background: color-mix(in srgb, var(--amber) 14%, transparent); }
+.icon-check:has(input:focus-visible) { outline: 2px solid var(--amber); outline-offset: 1px; }
+@media (max-width: 1400px) { .coll-bulk { flex-wrap: wrap; } }
diff --git a/tools/console/app.js b/tools/console/app.js
index 964c948..8899218 100644
--- a/tools/console/app.js
+++ b/tools/console/app.js
@@ -8194,6 +8194,40 @@
   // handlers and state stay its own); from there the other frame. Esc, a click beside it, another room or a run started put
   // it back; what brings the form forward (Retake, Reuse, the score into the form) brings the form's frame: show("compose").
   var FRAMES = { compose: "view-compose", take: "view-take" };
+  // HERESY 1169 (Viktor 07.10.2026: «три кнопочки svg -, +, reset для скейла… В минус шагом 2pt до минус 4, а в плюс… до макс
+  // 8pt… глобальный скейл шрифтов с минус 2 и плюс до 4… Три кнопочки глобального -=R в спадающее меню в баре»; «По скейлингу
+  // шрифтов и их лимитов сам решить, где порог»): every font size of the stylesheets is calc(N + var(--fs)) since the build, so
+  // the text grows and the layout stays. --fs-g is the page's (☰: −2…+4 pt by 1), --fs-f a lifted frame's on top of it (−4…+8
+  // by 2); both are this browser's (yue2.textSize), as the look is: each screen keeps its own
+  var TEXT = { g: { min: -2, max: 4, step: 1 }, f: { min: -4, max: 8, step: 2 } };
+  function textSizes() { try { return JSON.parse(recall("yue2.textSize") || "{}") || {}; } catch (e) { return {}; } }
+  function paintTextSize() {
+    var t = textSizes(), root = document.documentElement;
+    ["g", "f"].forEach(function (w) { if (t[w]) root.style.setProperty("--fs-" + w, t[w] + "pt"); else root.style.removeProperty("--fs-" + w); });
+    all("[data-fs-say]").forEach(function (el) { var v = t[el.dataset.fsSay] || 0; el.textContent = (v > 0 ? "+" : v < 0 ? "\u2212" : "") + Math.abs(v) + " pt"; });
+    all("[data-fs]").forEach(function (b) {
+      var w = b.dataset.fs.charAt(0), d = b.dataset.fs.slice(1), v = t[w] || 0, r = TEXT[w];
+      b.disabled = d === "-" ? v <= r.min : d === "+" ? v >= r.max : !v;
+    });
+  }
+  function setTextSize(w, v) {
+    var t = textSizes(), r = TEXT[w];
+    v = Math.max(r.min, Math.min(r.max, v));
+    if (v) t[w] = v; else delete t[w];
+    store("yue2.textSize", Object.keys(t).length ? JSON.stringify(t) : null);
+    paintTextSize();
+    window.dispatchEvent(new Event("resize"));            // the meter, the lists and the frames measure again
+  }
+  document.addEventListener("click", function (e) {
+    var b = e.target.closest("[data-fs]");
+    if (!b || b.disabled) return;
+    e.preventDefault();
+    e.stopPropagation();
+    var w = b.dataset.fs.charAt(0), d = b.dataset.fs.slice(1), v = textSizes()[w] || 0;
+    setTextSize(w, d === "0" ? 0 : v + (d === "+" ? TEXT[w].step : -TEXT[w].step));
+  }, true);
+  window.ruachTextSize = function (w, v) { if (v !== undefined) setTextSize(w, v); return textSizes()[w] || 0; };   // for the checks
+  paintTextSize();
   // HERESY 1169 (Viktor 08.10.2026: «ещё один оверлей поверх оверлея! В окне Lyrics ещё одну кнопку full screen, и поверх всего
   // где-то 60% ширины экрана, и шрифт автоматом на 10% крупнее»): the lyrics over everything, 60 % of the screen wide, a tenth
   // larger. The box itself moves there with its meter (its numbers, marks, tags, the find bar and the «[» list go with it) and
