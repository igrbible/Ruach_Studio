+                    write_listen_flac(dir, wav, title, lyrics);
+                }
+                if (listen_flac_fresh(dir)) {
+                    res.set_file_content(dir + "/listen.flac", "audio/flac");
+                    return;
+                }
+            }
+            res.set_file_content(path, mp3 ? "audio/mpeg" : "audio/wav");
