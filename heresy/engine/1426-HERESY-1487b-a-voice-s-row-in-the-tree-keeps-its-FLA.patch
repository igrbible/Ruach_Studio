 .dv-root { grid-template-columns: auto 1fr; font-weight: 600; }
 .dv-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
 .dv-meta { font-size: 11.5px; color: var(--dim); margin-left: 8px; }
