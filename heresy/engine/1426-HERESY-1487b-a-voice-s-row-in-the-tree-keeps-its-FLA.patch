diff --git a/tools/console/app.css b/tools/console/app.css
index 8b465d5..257917d 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -2167,7 +2167,7 @@ body[data-tab="write"] .col-grip.left, body[data-tab="post"] .col-grip.left, bod
 .dv-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
 .dv-actions .row-hint { margin: 0; }
