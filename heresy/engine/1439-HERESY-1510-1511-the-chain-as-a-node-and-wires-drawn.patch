diff --git a/tools/console/app.css b/tools/console/app.css
index 36e5102..7cf535b 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -6142,3 +6142,21 @@ body.daw-full #dawPanel .mx-wave.mx-ruler { height: 22px; }
 .hc-row:hover, .hc-row.is-cur { background: color-mix(in srgb, var(--amber) 11%, transparent); }
 .hc-row[aria-selected="true"] { color: var(--amber); font-weight: 600; }
 
+/* HERESY 1510: the chain as a node (its strip lifted in its window, off the page while the canvas shows); wires drawn from a node's output
+   to another's input, the chosen sources drawn their own way */
+#view-post.is-canvas > #postChain { display: none; }
+.nd-body > #postChain { margin: 0; }
+.pcv-port { position: absolute; top: 50%; width: 12px; height: 12px; margin-top: -6px; border-radius: 50%; border: 2px solid var(--panel);
+  background: color-mix(in srgb, var(--ink) 35%, transparent); }
+.pcv-port.is-in { left: -7px; pointer-events: none; }
+.pcv-port.is-out { right: -7px; cursor: crosshair; background: var(--amber); }
+.pcv-port.is-out:hover { transform: scale(1.35); }
+.pcv-wire.is-chosen { stroke: var(--amber); stroke-width: 2; stroke-dasharray: 2 5; stroke-linecap: round; }
+.pcv-wire.is-lit.is-chosen { stroke-dasharray: none; stroke-width: 3; }
+.pcv-temp { stroke: var(--amber); stroke-width: 2; stroke-dasharray: 6 4; }
+
+/* HERESY 1511 (Viktor 16.10.2026: «В DAW волну рисуй полную, а то строки бегают по движению мышки. В DAW не экономь на этом»): every lane's
+   wave whole at one height; nothing grows under the pointer (full screen keeps its share of the screen) */
+.mx-wave { height: 64px; transition: none; }
+.mx-lane.is-open .mx-wave { height: 64px; }
+
