diff --git a/tools/console/app.css b/tools/console/app.css
index 7e51efa..8e5211c 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -509,7 +509,7 @@ button, input, select, textarea { font: inherit; color: inherit; }
    is open, a band names it (and stays in view), the backdrop is dotted and the cards sit tighter;
    the top bar's Engine button stays lit. Keyed off the panel itself, so every way of opening or
    closing it (the button, Back, Escape) looks the same. */
-body:has(#view-engine:not(.is-hidden)) .workspace { display: none; }
+/* HERESY 1450: the room stays under the Engine, dimmed (the rules at the end of this file) */
 body:has(#view-engine:not(.is-hidden)) #engineToggle { background: var(--amber); border-color: var(--amber); color: var(--on-amber); }
 .engine-panel {
   min-height: calc(100vh - var(--bar-h) - var(--playbar-h));
@@ -5684,3 +5684,70 @@ html.fonts-buttons :is(.btn, .lyr-tog, .menu-pop button, .chip, .head-more-row b
 .lora-budget-hint { margin: 0 0 0 8px; }
 .lora-row.is-ordered { cursor: grab; }
 .lora-row.is-ordered:active { cursor: grabbing; }
+
+/* HERESY 1450 (Viktor 14.10.2026: «сделать её нашим красивым оверлеем с максимальными высотой и шириной… Лепестки вкладок
+   расположить слева, чтобы не съедать вертикальное место. Блоки во вкладках отцентрировать по вертикали и горизонтали»): the
+   Engine over the room between the bar and the player, the room dimmed around it (a click there closes it); the head over
+   the tabs at the left and one tab's cards, centred both ways, scrolled inside when they are taller than the window. The
+   bar and the player stay over it, so their menus open over it too */
+#view-engine.engine-panel {
+  position: fixed; z-index: 36; top: var(--bar-h); bottom: var(--playbar-h); left: 0; right: 0;
+  min-height: 0; padding: 12px 1.5vw; display: flex; flex-direction: column;
+  background: color-mix(in srgb, #050403 58%, transparent); background-image: none; backdrop-filter: blur(3px);
+}
+#view-engine.engine-panel.is-hidden { display: none; }
+body:has(#view-engine:not(.is-hidden)) :is(.topbar, #playbar) { z-index: 37; }
+#view-engine .engine-head {
+  position: static; flex: none; margin: 0; padding: 10px 20px;
+  border: 1px solid var(--line-a); border-bottom: 1px solid var(--line-a); border-radius: var(--r-lg, 14px) var(--r-lg, 14px) 0 0;
+}
+#view-engine .engine-body {
+  flex: 1 1 auto; min-height: 0; display: flex;
+  border: 1px solid var(--line-a); border-top: 0; border-radius: 0 0 var(--r-lg, 14px) var(--r-lg, 14px); overflow: hidden;
+  background-color: var(--sunk);
+  background-image: radial-gradient(color-mix(in srgb, var(--line) 70%, transparent) 1px, transparent 1.3px);
+  background-size: 16px 16px;
+  box-shadow: 0 24px 70px rgb(0 0 0 / .45);
+}
+#view-engine .engine-tabs {
+  flex: none; width: 250px; display: flex; flex-direction: column; gap: 4px; padding: 14px 10px; overflow-y: auto;
+  background: var(--panel); border-right: 1px solid var(--line-a);
+}
+#view-engine .engine-tab {
+  display: block; width: 100%; padding: 9px 12px; text-align: left; cursor: pointer;
+  border: 1px solid transparent; border-radius: var(--r-sm); background: none; color: var(--muted);
+  font: 500 calc(13.5px + var(--fs, 0px))/1.3 var(--heading); letter-spacing: .01em;
+}
+#view-engine .engine-tab:hover { color: var(--ink); background: color-mix(in srgb, var(--amber) 8%, transparent); }
+#view-engine .engine-tab[aria-selected="true"] {
+  color: var(--amber); background: color-mix(in srgb, var(--amber) 12%, transparent);
+  border-color: color-mix(in srgb, var(--amber) 40%, transparent); box-shadow: inset 3px 0 0 var(--amber);
+}
+#view-engine .engine-tab:focus-visible { outline: 2px solid var(--amber); outline-offset: 1px; }
+#view-engine .engine-grid {
+  flex: 1 1 auto; min-width: 0; overflow: auto; padding: 18px 22px;
+  display: flex; flex-wrap: wrap; gap: 14px; align-items: stretch; align-content: safe center; justify-content: center;
+}
+#view-engine .engine-grid > .card { grid-area: auto; order: 0; flex: 1 1 340px; max-width: 1480px; }
+#view-engine .engine-grid > .card.wide { flex: 1 1 100%; }
+#view-engine .engine-grid > .card.is-tab-off { display: none; }
+/* the server beside its log, the log as tall as the window lets it */
+#view-engine .engine-grid > .card.eg-server { flex: 1 1 300px; max-width: 420px; }
+#view-engine .engine-grid > .card.eg-log { flex: 3 1 620px; }
+#view-engine[data-etab="server"] .eg-log .log-body { flex: none; height: calc(100vh - var(--bar-h) - var(--playbar-h) - 190px); min-height: 260px; }
+/* the machine: the hardware beside Compute, the GPUs under them */
+#view-engine .engine-grid > .card.eg-hardware { flex: 1 1 320px; max-width: 560px; }
+#view-engine .engine-grid > .card.eg-compute { flex: 1.4 1 420px; }
+/* the models: what the install brings first, then the decoders and the adapters */
+#view-engine .engine-grid > .eg-models { order: -1; }
+#view-engine .engine-grid > .eg-vae .vae-list { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
+/* the rooms' helpers side by side */
+#view-engine .engine-grid > .card.eg-writer { flex: 2 1 520px; }
+#view-engine .engine-grid > .card.eg-art { flex: 1 1 360px; }
+@media (max-width: 760px) {
+  #view-engine.engine-panel { padding: 6px; }
+  #view-engine .engine-body { flex-direction: column; }
+  #view-engine .engine-tabs { width: auto; flex-direction: row; overflow-x: auto; border-right: 0; border-bottom: 1px solid var(--line-a); padding: 8px; }
+  #view-engine .engine-tab { width: auto; white-space: nowrap; }
+  #view-engine .engine-grid { padding: 12px; }
+}
diff --git a/tools/console/app.js b/tools/console/app.js
index 1b753f7..0f41a2b 100644
--- a/tools/console/app.js
+++ b/tools/console/app.js
@@ -249,10 +249,59 @@
     return ask.then(function (ok) { if (ok) v.classList.add("is-hidden"); return ok; });
   }
 
+  // HERESY 1450 (Viktor 14.10.2026: «Единой тематики блоки в единую вкладку. Отсортировать позиции по интуитивному движению с
+  // начала в конец»): the Engine's cards by theme, a tab each theme, in the order one goes through them: the server and its
+  // log, the machine, the models, the rooms' helpers, where the work lives and who may open it, the look, the updates. One
+  // tab's cards are shown, the rest stay in the page (their code runs as before); a card no tab names shows with the last
+  var ENGINE_TABS = { server: ["eg-server", "eg-log"], machine: ["eg-hardware", "eg-compute", "eg-gpus"], models: ["eg-models", "eg-vae", "eg-loras"],
+    rooms: ["eg-writer", "eg-art"], places: ["eg-folders", "eg-access"], look: ["eg-look"], about: ["eg-updates", "eg-about"] };
+  function engineTabOf(card) {
+    for (var k in ENGINE_TABS) if (ENGINE_TABS[k].some(function (c) { return card.classList.contains(c); })) return k;
+    return "about";
+  }
+  function engineTab(name, focus, quiet) {
+    if (!ENGINE_TABS[name]) name = "server";
+    all("#engineTabs [data-etab]").forEach(function (b) {
+      var on = b.dataset.etab === name;
+      b.setAttribute("aria-selected", on ? "true" : "false");
+      b.tabIndex = on ? 0 : -1;
+      if (on && focus) b.focus();
+    });
+    all("#view-engine .engine-grid > .card").forEach(function (c) { c.classList.toggle("is-tab-off", engineTabOf(c) !== name); });
+    $("view-engine").dataset.etab = name;
+    $("view-engine").querySelector(".engine-grid").scrollTop = 0;
+    if (!quiet) store("yue2.engineTab", name);
+    if (name === "server") scrollLogToEnd();
+  }
+  window.ruachEngineTab = function (where) {   // a tab by its name, or the tab of the card an element sits in
+    var card = where && where.closest ? where.closest("#view-engine .engine-grid > .card") : null;
+    engineTab(card ? engineTabOf(card) : where);
+  };
+  (function () {
+    var bar = $("engineTabs");
+    if (!bar) return;
+    bar.addEventListener("click", function (e) { var b = e.target.closest("[data-etab]"); if (b) engineTab(b.dataset.etab); });
+    bar.addEventListener("keydown", function (e) {
+      var tabs = all("#engineTabs [data-etab]"), i = tabs.indexOf(document.activeElement), j = -1;
+      if (i < 0) return;
+      if (e.key === "ArrowDown" || e.key === "ArrowRight") j = (i + 1) % tabs.length;
+      else if (e.key === "ArrowUp" || e.key === "ArrowLeft") j = (i - 1 + tabs.length) % tabs.length;
+      else if (e.key === "Home") j = 0;
+      else if (e.key === "End") j = tabs.length - 1;
+      if (j < 0) return;
+      e.preventDefault();
+      engineTab(tabs[j].dataset.etab, true);
+    });
+    engineTab(recall("yue2.engineTab") || "server", false, true);
+  })();
+  // HERESY 1450: a click on the dimmed room around the Engine closes it, as Esc does
+  $("view-engine").addEventListener("click", function (e) { if (e.target === this) leaveEngine(); });
+
   function show(view) {
     if (view === "engine") {
       if (!$("view-engine").classList.contains("is-hidden")) return void leaveEngine();
       $("view-engine").classList.remove("is-hidden");
+      engineTab($("view-engine").dataset.etab || recall("yue2.engineTab") || "server", false, true);   // HERESY 1450: the tab it was left on
       scrollLogToEnd();
       if (window.HeresyPlaces) window.HeresyPlaces.load();   // HERESY 1283: the Folders card asks the lab when the page is seen
       if (window.HeresyWeights) window.HeresyWeights.load(); // HERESY 1289: and the Models and LoRAs card
@@ -3237,6 +3286,7 @@
     });
     $("logDockEngine").addEventListener("click", function () {
       $("engineToggle").click();
+      if (window.ruachEngineTab) window.ruachEngineTab("server");   // HERESY 1450: the log is in the first tab
       setTimeout(function () { var b = $("logBody"); if (b) b.scrollIntoView({ block: "center" }); }, 120);
     });
     $("logDockFollow").addEventListener("change", function () { if (this.checked) $("logDockBody").scrollTop = $("logDockBody").scrollHeight; });
