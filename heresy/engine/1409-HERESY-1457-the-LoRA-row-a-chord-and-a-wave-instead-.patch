diff --git a/tools/console/app.css b/tools/console/app.css
index afe3544..25c333d 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -5794,3 +5794,17 @@ body:has(#view-engine:not(.is-hidden)) :is(.topbar, #playbar) { z-index: 37; }
   .hg-tabs button { width: auto; white-space: nowrap; }
   .hg-tabs .hg-stops { display: none; }
 }
+
+/* HERESY 1457 (Viktor 15.10.2026: «Выровняй начальную точку ползунков, чтобы они были симметричны по длине… svg иконки… колонку с
+   названием адаптера можно ужать вдвое, обрезать троеточием»): an icon of one width before every strength (a chord for the music
+   half, a wave for the sound half), so the sliders start and end alike in every language; the name's column half as wide as it
+   was, cut with an ellipsis, its trigger word too, the whole name over the row on hover (.coll-fullname, 1105) */
+.lora-half { grid-template-columns: 18px minmax(0, 1fr) 34px; }
+.lora-half:has(input.lora-exact) { grid-template-columns: 18px minmax(0, 1fr) 58px; }
+.lora-half-ico { display: flex; align-items: center; justify-content: center; color: var(--dim); cursor: help; }
+.lora-half-ico .ui-ico { width: 16px; height: 16px; }
+.lora-half:hover .lora-half-ico { color: var(--amber); }
+@media (min-width: 721px) {
+  .lora-row { grid-template-columns: minmax(64px, 0.42fr) minmax(150px, 1.6fr) auto 30px; }
+}
+.lora-who .lora-trigger { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
