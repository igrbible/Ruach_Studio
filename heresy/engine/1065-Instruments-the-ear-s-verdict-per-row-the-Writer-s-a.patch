Date: Fri, 2 Oct 2026 00:22:57 -0600
Subject: [PATCH 1065/1198] Instruments: the ear's verdict per row; the
 Writer's assistant told what is not played

heard (kept in Instrumental Probe), questioned (Viktor's own flag, e.g. accordion: sounds like harmonica),
NOT IDENTIFIED IN YUE2 (both probes disliked, or gone once the final workspace exists), not judged yet;
his notes on the probes shown in the row.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/console/app.css               |  7 ++++
 tools/console/heresy-assist.js      | 10 +++++-
 tools/console/heresy-instruments.js | 55 +++++++++++++++++++++--------
 3 files changed, 56 insertions(+), 16 deletions(-)

diff --git a/tools/console/app.css b/tools/console/app.css
index 10130e8..2acb0ff 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -2559,6 +2559,13 @@ body[data-tab="train"] .library, body[data-tab="train"] .col-grip { display: non
 .hi-noplay { display: inline-block; width: 46px; text-align: center; color: var(--dim); font-size: 11px; }
 .hi-ok { font-size: 11px; color: var(--good); white-space: nowrap; }
 tr.is-heard .hi-tag { color: var(--good); }
+/* 1069b: the ear's verdict under the name */
+.hi-st { margin-top: 2px; font-size: 10.5px; letter-spacing: .04em; color: var(--dim); }
+tr.is-heard .hi-st { color: var(--good); }
+tr.is-flag .hi-st { color: var(--amber); font-weight: 600; }
+tr.is-no .hi-st { color: var(--bad); font-weight: 600; }
+tr.is-no .hi-tag { color: var(--bad); }
+.hi-his { margin-top: 3px; font-size: 12px; font-style: italic; color: var(--ink); }
 @media (max-width: 640px) { .hi-name { width: auto; } .hi-plays { width: auto; } .hi-table td { display: block; border: 0; } .hi-table tr { display: block; border-bottom: 1px solid var(--line-soft); } }
 /* HERESY 1070: a locked workspace */
 .coll-lock { flex: none; font-size: 11px; opacity: .75; }
diff --git a/tools/console/heresy-assist.js b/tools/console/heresy-assist.js
index f0c63f4..49438ff 100644
--- a/tools/console/heresy-assist.js
+++ b/tools/console/heresy-assist.js
@@ -69,9 +69,17 @@
       "Prefer them when you choose the 2-5 defining instruments. Another name may come out as a different\n" +
       "instrument: when you use one that is not on this list, say so in notes." : "";
   }
+  // HERESY 1069b: and the names it did not play when asked alone (the sheet's red rows)
+  function unheard() {
+    var tags = window.HeresyInstruments && window.HeresyInstruments.notHeardTags ? window.HeresyInstruments.notHeardTags() : [];
+    return tags.length ? "\n\nINSTRUMENTS NOT IDENTIFIED ON THIS ENGINE\n" +
+      "Named alone in a style, these did not come out as themselves: " + tags.join("; ") + ".\n" +
+      "Avoid them as defining instruments; if the brief asks for one, keep it and warn in notes that it needs\n" +
+      "an experiment (a richer description of its sound, or a close neighbour that is heard)." : "";
+  }
 
   function system(preferences) {
-    var text = SONGWRITER.replace(/\s+$/, "") + "\n" + HERESY_ADDENDUM + heard();
+    var text = SONGWRITER.replace(/\s+$/, "") + "\n" + HERESY_ADDENDUM + heard() + unheard();
     var own = String(preferences || "").trim();
     return own ? text + "\n\nUSER WRITING PREFERENCES\n" + own : text;
   }
