+.ar-left, .ar-stage { position: sticky; top: 8px; }
+.ar-cols .ar-form { margin: 0; }
+.ar-cols .ar-bar { margin: 0; }
+.ar-cols .ar-runs { margin: 12px 0 28px; }
+.ar-left .ar-knobs { gap: 10px 12px; }
+.ar-left .ar-go { margin-left: 0; flex: 1 1 100%; justify-content: space-between; }
+.ar-left .ar-go #arDraw { min-width: 8em; }
+.ar-resizer { align-self: stretch; min-height: 220px; display: flex; justify-content: center; cursor: col-resize; touch-action: none; outline: none; }
+.ar-resizer::before { content: ""; width: 2px; height: 100%; border-radius: 1px; background: transparent; transition: background .12s; }
+.ar-resizer:hover::before, .ar-resizer.is-drag::before, .ar-resizer:focus-visible::before { background: var(--line-strong-a); }
+.ar-stage { display: flex; flex-direction: column; gap: 10px; }
+.ar-stage-pic { position: relative; display: block; align-self: center; padding: 0; overflow: hidden; border: 1px solid var(--line-a); border-radius: var(--r-md);
+  background: var(--field); cursor: zoom-in; }
+.ar-stage-pic img { display: block; width: 100%; height: 100%; object-fit: contain; }
+.ar-stage-pic.is-loading img { filter: blur(1.5px); }
+.ar-stage-pic.is-live { cursor: default; border-color: var(--amber-dim); }
+.ar-stage-empty { display: grid; place-items: center; min-height: 240px; padding: 20px; border: 1px dashed var(--line-a); border-radius: var(--r-md);
+  color: var(--dim); font-size: 13px; text-align: center; }
+.ar-stage-data { display: flex; flex-direction: column; gap: 6px; font-size: 12.5px; color: var(--muted); }
+.ar-stage-meta { display: flex; flex-wrap: wrap; gap: 4px 12px; font-variant-numeric: tabular-nums; }
+.ar-stage-prompt { color: var(--ink); font-size: 13px; line-height: 1.45; white-space: pre-wrap; max-height: 9.5em; overflow: auto; }
+.ar-stage-acts { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
+.ar-stage-acts .ar-vstar { font-size: 18px; }
+.ar-thumb.is-sel { border-color: var(--amber); box-shadow: 0 0 0 2px color-mix(in srgb, var(--amber) 35%, transparent); }
+@media (max-width: 1280px) { .ar-cols { grid-template-columns: minmax(0, 1fr); } .ar-resizer { display: none; } .ar-left, .ar-stage { position: static; } }
