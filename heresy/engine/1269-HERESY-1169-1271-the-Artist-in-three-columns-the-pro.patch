 #arDraw.is-stop { background: var(--bad); border-color: var(--bad); color: #fff; }
 #arDraw.is-stop:hover { filter: brightness(1.08); }
+/* HERESY 1271: the Artist in three columns, the outer two as wide as their edges are dragged (kept), the stage the rest */
+.ar-cols { display: grid; grid-template-columns: var(--ar-l, 380px) 12px minmax(280px, 1fr) 12px var(--ar-r, 560px); column-gap: 4px; align-items: start; margin-top: 14px; }
