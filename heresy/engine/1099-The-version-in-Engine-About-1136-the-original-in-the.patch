+.cmp-seek { flex: 1; accent-color: var(--amber); }
+.cmp-time, .cmp-total { font-size: 12px; color: var(--muted); min-width: 40px; text-align: center; }
+.cmp-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
+.cmp-row { width: 100%; display: grid; grid-template-columns: 22px minmax(0, 1fr) auto 48px; align-items: center; gap: 10px; padding: 8px 10px;
+  border: 1px solid var(--line-a); border-radius: var(--r-md); background: var(--panel); color: var(--ink); text-align: left; cursor: pointer; }
+.cmp-row:hover { background: color-mix(in oklab, var(--amber) 5%, var(--panel)); }
+.cmp-row.is-on { border-color: var(--amber-a); background: color-mix(in oklab, var(--amber) 10%, var(--panel)); }
+.cmp-row.is-playing .cmp-name::before { content: ""; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--amber); margin-right: 8px;
+  vertical-align: middle; animation: status-pulse 1.2s ease-in-out infinite; }
+.cmp-n { color: var(--dim); font-size: 12px; }
+.cmp-name { font-weight: 500; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.cmp-group { font-size: 12px; color: var(--muted); white-space: nowrap; }
+.cmp-dur { font-size: 12px; color: var(--dim); text-align: right; }
+
+.cmp-box:focus { outline: none; }
