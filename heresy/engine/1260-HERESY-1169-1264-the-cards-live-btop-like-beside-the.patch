diff --git a/tools/console/app.css b/tools/console/app.css
index ab3f736..440fa6e 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -3126,6 +3126,33 @@ body[data-tab="train"] .log-dock.is-tall .log-dock-body { height: calc(100vh - v
 .log-dock.is-folded .log-dock-tall { display: none; }
 .log-dock-tall { min-width: 30px; font-size: 14px; }
 .log-dock.is-folded .log-dock-body, .log-dock.is-folded .log-dock-acts { display: none; }
+/* HERESY 1264 (Viktor 09.10.2026: «btop-like монитор утилизации/VRAM usage в реальном времени»; «к фрейму лога сервера… шире на
+   200-400px, В две колонки… главная карта особо обрамлена. Пометки над блоками графов — какая роль карты»): the cards live. Beside the
+   log the dock grows 300 px for a column of the cards with a role (none without a card: then it keeps its width); in Engine → GPUs a
+   row under each card. The bars: the load above, the memory below, a second each, two minutes wide. */
+.log-dock.has-gpus:not(.is-folded) { width: min(900px, calc(100vw - 32px)); }
+.log-dock.has-gpus.is-tall { width: min(1160px, calc(100vw - 32px)); }
+.log-dock-main { display: grid; grid-template-columns: minmax(0, 1fr); }
+.log-dock.has-gpus .log-dock-main { grid-template-columns: minmax(0, 1fr) 290px; }
+.log-dock.is-folded .log-dock-main, .log-dock-gpus:empty { display: none; }
+.log-dock:not(.has-gpus) .log-dock-gpus { display: none; }
+.log-dock-gpus { display: flex; flex-direction: column; gap: 8px; min-height: 0; overflow: auto; padding: 8px 10px; border-top: 1px solid var(--line-soft, var(--line));
+  border-left: 1px solid var(--line-soft, var(--line)); }
+@media (max-width: 1180px) { .log-dock.has-gpus:not(.is-folded) { width: min(600px, calc(100vw - 32px)); }
+  .log-dock.has-gpus.is-tall { width: min(860px, calc(100vw - 32px)); }
+  .log-dock.has-gpus .log-dock-main { grid-template-columns: minmax(0, 1fr); } .log-dock-gpus { display: none; } }
+.gl-card { display: flex; flex-direction: column; gap: 3px; padding: 6px 8px 7px; border: 1px solid var(--line-a, var(--line)); border-radius: var(--r-sm, 4px); }
+.gl-card.is-main { border: 1.5px solid var(--amber); box-shadow: 0 0 0 2px color-mix(in srgb, var(--amber) 14%, transparent); }
+.gl-role { font: 600 10px/1.3 var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
+.gl-card.is-main .gl-role { color: var(--amber); }
+.gl-name { font-size: 11px; color: var(--ink); }
+.gl-graph { display: block; width: 100%; height: 46px; }
+.gl-graph.gl-wide { height: 54px; }
+.gl-nums { display: flex; flex-wrap: wrap; gap: 2px 10px; font-size: 11px; color: var(--muted); }
+.gl-nums b { color: var(--ink); font-weight: 600; }
+.gl-wait { font-size: 11px; color: var(--muted); }
+.gpu-table .gpu-live-row td { padding-top: 0; padding-bottom: 10px; border-top: 0; }
+.gpu-live { display: flex; flex-direction: column; gap: 3px; }
 @media (max-width: 1150px) { .log-dock { bottom: 10px; } }
 
