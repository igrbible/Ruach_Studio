The second matrix (heresy/MISC/claude-artist/matrix-1333: 24 pictures through the test lab on GPU2, one prompt, seed 1328, 10.10.2026): every new sampler kept the picture whole on Krea 2 Muse, on Qwen-Image 2512 Q4 with Lightning and on an fp8 fine-tune; of the new schedules, KL optimal under Lightning painted two lighthouses on 2512 Q4, as Karras and Exponential did in the first matrix; Beta 57, SGM uniform and Bong tangent kept it whole. The warning under the sampling names all three, and the schedules that keep the subject whole.

Suite: 622/0 in the kitchen.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/console/heresy-artist.js | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tools/console/heresy-artist.js b/tools/console/heresy-artist.js
index e092a82..103e753 100644
--- a/tools/console/heresy-artist.js
+++ b/tools/console/heresy-artist.js
@@ -128,9 +128,9 @@
     if (q) { $("arLightOn").checked = !!s.lightOn; $("arLight").value = (+s.lightning).toFixed(2); $("arLight").disabled = !s.lightOn; $("arCfg").value = String(s.cfg || 4); }
     $("arSampSay").textContent = sampSay(key, s);
     // HERESY 1333: what the sampling matrix showed (10.10.2026, 30 pictures): Lightning under Karras or Exponential paints the subject twice;
-    // without Lightning Euler SDE paints Qwen soft and hazy
+    // without Lightning Euler SDE paints Qwen soft and hazy; 1333c: the second matrix (24 pictures): KL optimal paints it twice too
     var warn = $("arSampWarn"), fast = sampFast(key, s), say = "";
-    if (q && fast && (s.schedule === "karras" || s.schedule === "exponential")) say = tr("With Lightning, Karras and Exponential can paint the subject twice: Simple, Beta or Beta 57 keep it whole.");
+    if (q && fast && /^(karras|exponential|kl_optimal)$/.test(s.schedule)) say = tr("With Lightning, Karras, Exponential and KL optimal can paint the subject twice: Simple, Beta, Beta 57, SGM uniform or Bong tangent keep it whole.");
     else if (/^qwen/.test(key) && !fast && s.sampler === "euler-sde") say = tr("Without Lightning, Euler SDE paints Qwen soft and hazy: Euler, ER-SDE or RES keep the detail.");
     if (warn) { warn.hidden = !say; warn.textContent = say; }
   }
