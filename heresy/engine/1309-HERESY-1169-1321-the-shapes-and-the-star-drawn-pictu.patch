+/* HERESY 1321: the shapes and the star drawn; the picked pictures; the pictures put aside */
+.ar-shape { position: relative; padding: 4px 8px; }
+.ar-shape input { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
+.ar-shape-ico { width: 20px; height: 20px; display: block; fill: none; stroke: currentColor; stroke-width: 1.7; }
+.ar-shape.is-on .ar-shape-ico, .ar-fshape.is-on .ar-shape-ico { fill: color-mix(in srgb, var(--amber) 22%, transparent); }
+.ar-fshape { display: inline-grid; place-items: center; padding: 3px 8px; }
+.ar-star-ico { width: 18px; height: 18px; display: block; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linejoin: round; }
+.ar-star-ico.is-on { fill: #f2c14e; stroke: #f2c14e; }
+.ar-fshape .ar-star-ico.is-on { fill: currentColor; stroke: currentColor; }
+.ar-pic.is-picked { position: relative; }
+.ar-gpic.is-picked, .ar-pic.is-picked { outline: 3px solid var(--amber); outline-offset: -3px; border-radius: var(--r-md); }
+.ar-gpic.is-picked::after, .ar-pic.is-picked::after { content: "\2713"; position: absolute; top: 6px; left: 6px; width: 22px; height: 22px; display: grid; place-items: center;
+  border-radius: 999px; background: var(--amber); color: #111; font: 700 13px/1 var(--sans); pointer-events: none; }
+.ar-picked { display: inline-flex; align-items: center; gap: 6px; margin-left: 8px; padding-left: 10px; border-left: 1px solid var(--line-a); }
+.ar-picked[hidden] { display: none; }
+.ar-picked-n { font-size: 12.5px; color: var(--amber); white-space: nowrap; }
+.ar-aside-box { margin: 0 0 14px; padding: 0 0 12px; border-bottom: 1px solid var(--line-a); }
+.ar-aside-head { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; font-size: 12.5px; color: var(--muted); }
+.ar-aside-head b { color: var(--ink); }
+.ar-aside-head .btn { margin-left: auto; }
+.ar-aside-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 8px; }
+.ar-aside-pic { margin: 0; display: flex; flex-direction: column; gap: 4px; }
+.ar-aside-pic img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 6px; opacity: .85; background: var(--ground); }
