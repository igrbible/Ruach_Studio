diff --git a/tools/console/app.css b/tools/console/app.css
index 02a59fd..fbc5629 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -5858,3 +5858,18 @@ body:has(#view-engine:not(.is-hidden)) :is(.topbar, #playbar) { z-index: 37; }
     linear-gradient(to right, #3f9a4a 0, #3f9a4a var(--z1), #e0b030 var(--z2), #c8372d var(--z2), #c8372d 100%);
 }
 
+/* HERESY 1459 (Viktor 15.10.2026: «реструктурировать эти четыре блока и сделать более восприимчивым для глаза? Где возможно, SVG
+   иконки»): Download, Refiner, Files and Edit each a column of whole-width rows, every row its drawing then its name, so the four
+   read as four short lists of the same rhythm; every block's name has its own drawing in the accent */
+.take-tools .tool-cap { display: flex; align-items: center; gap: 7px; }
+.take-tools .tl-cap-ico { display: inline-flex; color: var(--amber); }
+.take-tools .tl-cap-ico .ui-ico { width: 14px; height: 14px; }
+.take-tools .tool-group:not(.tg-again) > .tool-row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 5px; }
+.take-tools .tool-group:not(.tg-again) > .tool-row > .btn { width: 100%; justify-content: flex-start; }
+.take-tools .tg-dl .split-btn { display: flex; width: 100%; min-width: 0; }
+.take-tools .tg-dl .split-btn > .btn { flex: 1; min-width: 0; justify-content: flex-start; }
+.take-tools .tl-ico { display: inline-flex; flex: none; color: var(--muted); }
+.take-tools .tl-ico .ui-ico { width: 15px; height: 15px; }
+.take-tools .btn:hover .tl-ico, .take-tools .btn:focus-visible .tl-ico { color: var(--amber); }
+.take-tools .tl-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+
