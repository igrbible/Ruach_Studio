diff --git a/tools/console/app.js b/tools/console/app.js
index b131f48..698d2cf 100644
--- a/tools/console/app.js
+++ b/tools/console/app.js
@@ -254,7 +254,7 @@
   // log, the machine, the models, the rooms' helpers, where the work lives and who may open it, the look, the updates. One
   // tab's cards are shown, the rest stay in the page (their code runs as before); a card no tab names shows with the last
   var ENGINE_TABS = { server: ["eg-server", "eg-log"], machine: ["eg-hardware", "eg-compute", "eg-gpus"], models: ["eg-models", "eg-vae", "eg-loras"],
-    rooms: ["eg-writer", "eg-art"], places: ["eg-folders", "eg-access", "eg-c2pa"], look: ["eg-look"], about: ["eg-updates", "eg-about"] };
+    rooms: ["eg-writer", "eg-art"], refiner: ["eg-refiner"], places: ["eg-folders", "eg-access", "eg-c2pa"], look: ["eg-look"], about: ["eg-updates", "eg-about"] };
   function engineTabOf(card) {
     for (var k in ENGINE_TABS) if (ENGINE_TABS[k].some(function (c) { return card.classList.contains(c); })) return k;
     return "about";
diff --git a/tools/console/help.js b/tools/console/help.js
index 0c84d84..bfcbc12 100644
--- a/tools/console/help.js
+++ b/tools/console/help.js
@@ -282,7 +282,8 @@
   function labelName(el) {
     var field = el.closest(".field, label");
     var label = field && field.querySelector(".label, span, .shape-name");
-    return ((label && label.firstChild && label.firstChild.textContent) || el.id).trim() || el.id;
+    // HERESY 1524: a control with no label text by its own name for the ear (aria-label), then its placeholder, its id only last
+    return ((label && label.firstChild && label.firstChild.textContent) || "").trim() || el.getAttribute("aria-label") || el.getAttribute("placeholder") || el.id;
   }
 
   function decorate() {
