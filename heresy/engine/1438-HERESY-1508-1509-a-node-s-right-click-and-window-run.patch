diff --git a/tools/console/app.css b/tools/console/app.css
index add8825..36e5102 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -6102,3 +6102,43 @@ body.daw-full #dawPanel .mx-wave.mx-ruler { height: 22px; }
 .nd-body { flex: 1; min-height: 0; overflow: auto; padding: 14px 18px 18px; }
 .nd-body > .drawer, .nd-body > .dv-tree-box { margin: 0; display: block; }
 
+/* HERESY 1508 (Viktor 16.10.2026: «В модальных окнах нод не забудь снять ту старую рамку, что была на странице вкладки»): the step's panel in its
+   node's window without the tab's frame (its name is the window's title); a node bypassed in the chain dimmed, with its wires */
+.nd-body > .drawer { border: 0; border-radius: 0; background: transparent; box-shadow: none; }
+.nd-body > .drawer > summary { background: none; padding-left: 0; padding-right: 0; border-radius: 0; }
+.nd-body > .drawer > summary .sum-name { display: none; }
+.nd-body > .drawer > .drawer-body { padding-left: 0; padding-right: 0; }
+.pcv-node.is-bypassed { opacity: .58; --pcv-edge: #8a63d2; border-style: dashed; }
+.pcv-by { color: #8a63d2; font-weight: 600; }
+.pcv-wire.is-bypass { opacity: .35; }
+
+/* HERESY 1509 (Viktor 16.10.2026: «…избавляемся от этих голимых html'евских дропдаунов»): a select's choices in sight in the Refiner's node
+   windows: a column of radio rows in a quiet frame (short ones in a row), a long list behind a button that opens it over the page; the select
+   itself, still read and written by everything, hidden there and shown as it was elsewhere */
+.hc-box { display: none; }
+.nd-body .hc-box { display: block; min-width: 0; }
+.nd-body select.hc-src { display: none; }
+.hc-list { display: flex; flex-direction: column; gap: 2px; padding: 4px; border: 1px solid var(--line-soft); border-radius: var(--r-sm); }
+.hc-list.is-row { flex-direction: row; flex-wrap: wrap; }
+.hc-opt { display: flex; align-items: center; gap: 8px; min-width: 0; padding: 5px 10px 5px 8px; border: 1px solid transparent; border-radius: var(--r-sm);
+  background: transparent; color: var(--ink); text-align: left; cursor: pointer; font: inherit; }
+.hc-opt > span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.hc-opt:hover { background: color-mix(in srgb, var(--amber) 7%, transparent); }
+.hc-opt[aria-checked="true"] { border-color: color-mix(in srgb, var(--amber) 55%, transparent); background: color-mix(in srgb, var(--amber) 11%, transparent); }
+.hc-opt:disabled { opacity: .5; cursor: default; }
+.hc-dot { flex: none; width: 11px; height: 11px; border-radius: 50%; border: 1.5px solid var(--dim); }
+.hc-opt[aria-checked="true"] .hc-dot { border-color: var(--amber); background: radial-gradient(var(--amber) 0 3px, transparent 3.5px); }
+.hc-pick { display: inline-flex; align-items: center; gap: 10px; max-width: 100%; min-width: 220px; padding: 6px 10px; border: 1px solid var(--line-a);
+  border-radius: var(--r-sm); background: var(--panel); color: var(--ink); font: inherit; text-align: left; cursor: pointer; }
+.hc-pick:hover { border-color: var(--amber); }
+.hc-pick-now { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.hc-pick-n { flex: none; font-size: 11px; color: var(--dim); padding: 1px 6px; border: 1px solid var(--line-soft); border-radius: var(--r-pill); }
+.hc-pop { position: fixed; z-index: 40; display: flex; flex-direction: column; min-height: 0; background: var(--ground); border: 1px solid var(--line-strong-a, var(--line-a));
+  border-radius: var(--r-md); box-shadow: 0 18px 50px var(--shadow-lg, rgba(0, 0, 0, .3)); }
+.hc-find { margin: 8px 8px 4px; }
+.hc-rows { overflow: auto; padding: 4px; min-height: 0; }
+.hc-row { display: block; width: 100%; padding: 6px 10px; border: 0; border-radius: var(--r-sm); background: transparent; color: var(--ink); font: inherit; text-align: left;
+  cursor: pointer; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.hc-row:hover, .hc-row.is-cur { background: color-mix(in srgb, var(--amber) 11%, transparent); }
+.hc-row[aria-selected="true"] { color: var(--amber); font-weight: 600; }
+
