+        (r.note ? '<div class="peek-cap">Note</div><div class="peek-note">' + esc(r.note) + "</div>" : "");
+      var rc = card.getBoundingClientRect(), w = 380;
+      var left = rc.right + 10 + w < window.innerWidth ? rc.right + 10 : Math.max(8, rc.left - w - 10);
+      box.style.left = left + "px";
+      box.style.top = Math.max(8, Math.min(rc.top, window.innerHeight - 420)) + "px";
+      box.hidden = false;
+    }).catch(function () {});
+  }
+  function hidePeek() { clearTimeout(peekTimer); peekFor = ""; if ($("collPeek")) $("collPeek").hidden = true; }
+
