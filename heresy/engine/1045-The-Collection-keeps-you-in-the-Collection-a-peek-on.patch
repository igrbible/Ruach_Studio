+      if (peekFor !== name) return;
+      var box = $("collPeek"), style = String(req.style || "");
+      box.innerHTML = '<div class="peek-title">' + esc(r.title) + '</div><div class="coll-meta">' + esc(state.hooks.ago(r.created)) +
