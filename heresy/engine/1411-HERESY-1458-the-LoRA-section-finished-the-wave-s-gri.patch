+/* HERESY 1458 (Viktor 15.10.2026: «Не хватает ещё более чёткой сетки в бекграунд редактирования графика»; «full screen по кнопке —
+   как у меня с редактором лирики. На 1800px»; «показ более точных долей применения»): the wave's graph at its own size in pixels
+   (190 px tall in the form, up to 440 over the page), its grid in three weights, the song's end and what lies past it; the
+   picker over the page as the lyrics go (z 40, under the tips, menus and questions); a held strength's road dimmed past
+   what runs, a tick where it stops, its number amber */
+.lora-wave-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
+.lora-wave-head .curve-modes { flex: none; }
+.lora-wave-at { min-width: 96px; font-size: 12px; color: var(--muted); }
+.lora-wave-len { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--dim); cursor: help; }
+.lora-wave-len-in { width: 64px; height: 26px; padding: 2px 6px; font-size: 12px; text-align: center; cursor: text; }
+.lora-wave-edit .lora-wave-len span { white-space: nowrap; }
+.lora-wave-edit .lora-wave-len input.lora-wave-len-in { flex: none; width: 64px; min-width: 0; }   /* not the form's column-wide text field */
+.lora-wave-graph { height: 190px; }
+.lora-wave-graph line { shape-rendering: crispEdges; }
+.lora-wave-graph .wg-minor { stroke: color-mix(in srgb, var(--line) 60%, transparent); stroke-width: 1; }
+.lora-wave-graph .wg-major { stroke: var(--line-strong); stroke-width: 1; opacity: .55; }
+.lora-wave-graph .wg-half { stroke: var(--line-strong); stroke-width: 1; opacity: .8; }
+.lora-wave-graph .wg-frame { fill: none; stroke: var(--line-strong); stroke-width: 1; opacity: .7; }
+.lora-wave-graph .wg-label { fill: var(--dim); font: 10.5px var(--mono); }
+.lora-wave-graph .wg-past { fill: color-mix(in srgb, var(--ink) 8%, transparent); }
+.lora-wave-graph .wg-end { stroke: var(--amber); stroke-width: 1.5; stroke-dasharray: 5 4; }
+.lora-wave-graph .wg-end-label { fill: var(--amber); font: 600 11px var(--sans); }
+.lora-wave-edit .lora-wave-past { color: #c99a1c; }
+.lora-big { margin-left: 6px; vertical-align: -3px; }
+.lora-big .ui-ico { width: 15px; height: 15px; }
+.lora-over { position: fixed; left: 0; right: 0; top: 0; bottom: var(--playbar-h); z-index: 40; display: flex; align-items: center; justify-content: center;
+  background: color-mix(in srgb, var(--ground) 45%, rgba(0, 0, 0, .55)); backdrop-filter: blur(3px); }
+.lora-over-box { width: min(1800px, calc(100vw - 32px)); max-height: calc((100vh - var(--playbar-h)) * .94); display: flex; flex-direction: column;
+  border: 1px solid var(--line-strong-a); border-radius: var(--r-lg); background: var(--panel); box-shadow: 0 24px 80px var(--shadow-lg); }
+.lora-over-head { display: flex; align-items: center; gap: 8px; padding: 10px 16px; border-bottom: 1px solid var(--line); font: 600 15px/1.3 var(--heading); }
+.lora-over-body { flex: 1; min-height: 0; overflow-y: auto; padding: 14px 18px 18px; }
+@media (min-width: 721px) {
+  .lora-over .lora-row { grid-template-columns: minmax(120px, 0.42fr) minmax(300px, 3fr) auto 30px; }
+}
+.lora-over .lora-wave-graph { height: clamp(260px, 40vh, 440px); }
+.lora-half.is-held output { color: #c99a1c; font-weight: 600; text-decoration: underline dotted; text-underline-offset: 3px; cursor: help; }
+.lora-half.is-held input[type="range"].zoned::-webkit-slider-runnable-track, .lora-total.is-held input[type="range"].zoned::-webkit-slider-runnable-track {
+  background:
+    linear-gradient(to right, transparent calc(7px + (100% - 14px) * var(--cutf, 1) - 1px), var(--ink) calc(7px + (100% - 14px) * var(--cutf, 1) - 1px),
+      var(--ink) calc(7px + (100% - 14px) * var(--cutf, 1) + 1px), color-mix(in srgb, var(--panel) 72%, transparent) calc(7px + (100% - 14px) * var(--cutf, 1) + 1px)),
+    linear-gradient(to right, #3f9a4a 0, #3f9a4a var(--z1), #e0b030 var(--z2), #c8372d var(--z2), #c8372d 100%);
+}
+.lora-half.is-held input[type="range"].zoned::-moz-range-track, .lora-total.is-held input[type="range"].zoned::-moz-range-track {
+  background:
+    linear-gradient(to right, transparent calc(6px + (100% - 12px) * var(--cutf, 1) - 1px), var(--ink) calc(6px + (100% - 12px) * var(--cutf, 1) - 1px),
+      var(--ink) calc(6px + (100% - 12px) * var(--cutf, 1) + 1px), color-mix(in srgb, var(--panel) 72%, transparent) calc(6px + (100% - 12px) * var(--cutf, 1) + 1px)),
+    linear-gradient(to right, #3f9a4a 0, #3f9a4a var(--z1), #e0b030 var(--z2), #c8372d var(--z2), #c8372d 100%);
+}
