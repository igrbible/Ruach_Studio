 .ws-current select { width: auto; max-width: 220px; }
 .ws-current.is-set select { border-color: var(--amber); color: var(--amber); }
+
+/* HERESY 1042: likes in the player */
+.playbar-id { display: flex; align-items: center; gap: 8px; min-width: 0; }
+.pb-rate { display: inline-flex; gap: 2px; flex: none; }
+.pb-btn { border: 0; background: none; padding: 2px 4px; font-size: 15px; line-height: 1; cursor: pointer; opacity: .45; filter: grayscale(1); border-radius: var(--r-sm); }
+.pb-btn:hover { opacity: .8; }
+.pb-btn[aria-pressed="true"] { opacity: 1; filter: none; }
+#pbFav { color: var(--amber); filter: none; font-size: 16px; }
