+// HERESY 1069: the instruments, a cheat-sheet (Viktor, 02.10.2026). Every instrument the probes asked
+// YuE2 for: its family, its home, how it sounds, and the words that name it in a style. The ♪ beside
+// the Style prompt opens it; a tag clicked goes into the style; ▶ A and ▶ B play the 60 s probes
+// (probe60-SLUG-a/b, two seeds) when the Collection holds them. What Viktor's ear kept (the takes in
+// the workspace "Instrumental Probe") is marked heard, and the Writer's assistant is told those names.
+(function () {
+  "use strict";
+
+  var KEPT = "Instrumental Probe";             // Viktor's final workspace: the probes his ear approved
+  var DATA = {"families":{"strings-plucked":"plucked strings","strings-bowed":"bowed strings","keys":"keys","winds-wood":"woodwinds","winds-brass":"brass and horns","winds-reed":"reeds and bagpipes","perc-drum":"drums","perc-tuned":"tuned percussion","perc-small":"small percussion","synth":"synths and electronics","voice":"voice-like","ensemble":"ensembles","other":"other"},"instruments":[{"slug":"duduk","family":"winds-reed","family_name":"reeds and bagpipes","home":"Armenia","tag":"duduk","en":"Apricot-wood double reed: a warm, nasal, mournful voice, often over a drone.","ru":"Абрикосовая дудка с двойной тростью: тёплый, носовой, скорбный голос, часто над бурдоном."},{"slug":"low-wooden-flute","family":"winds-wood","family_name":"woodwinds","home":"everywhere","tag":"low wooden flute","en":"A breathy, dark, low flute of wood: air as much as tone.","ru":"Низкая деревянная флейта: тёмная, с густым дыханием, воздуха в ней не меньше, чем тона."},{"slug":"shofar","family":"winds-brass","family_name":"brass and horns","home":"Israel","tag":"shofar (ram's horn)","en":"A ram's horn blown with the lips: two raw notes, blasts and broken calls, no melody.","ru":"Бараний рог, дуют губами: две сырые ноты, протяжные и прерывистые сигналы, мелодии нет."},{"slug":"kinnor-lyre","family":"strings-plucked","family_name":"plucked strings","home":"ancient Israel","tag":"kinnor lyre","en":"David's lyre: few gut strings, bright, dry, sparse plucked chords.","ru":"Лира Давида: несколько жильных струн, светлый сухой звук, редкие щипковые аккорды."},{"slug":"harp","family":"strings-plucked","family_name":"plucked strings","home":"everywhere","tag":"harp","en":"Concert harp: rippling glissandi and bell-like notes with a long ring.","ru":"Концертная арфа: переливы глиссандо и колокольные ноты с долгим звоном."},{"slug":"psaltery","family":"strings-plucked","family_name":"plucked strings","home":"Near East, medieval Europe","tag":"psaltery","en":"A box of many plucked strings: shimmering, harp-like, close and metallic.","ru":"Ящик с множеством щипковых струн: мерцающий, близкий к арфе, но металличнее."},{"slug":"frame-drum","family":"perc-drum","family_name":"drums","home":"Near East","tag":"frame drum","en":"A wide hand drum on a wooden frame: deep boom and dry finger slaps.","ru":"Широкий ручной бубен на деревянном обруче: глубокий удар и сухие шлепки пальцами."},{"slug":"tambourine","family":"perc-small","family_name":"small percussion","home":"everywhere","tag":"tambourine","en":"Small frame drum with jingles: shakes, rolls and bright metal clatter.","ru":"Бубен с тарелочками: тряска, тремоло и светлый металлический звон."},{"slug":"finger-cymbals","family":"perc-small","family_name":"small percussion","home":"Near East","tag":"finger cymbals","en":"Tiny cymbals struck between fingers: high, pure, ringing chimes.","ru":"Крошечные тарелочки на пальцах: высокий чистый звон."},{"slug":"oud","family":"strings-plucked","family_name":"plucked strings","home":"Middle East","tag":"oud","en":"Fretless short-necked lute: woody, round, sliding Arabic maqam lines.","ru":"Безладовая лютня: древесный круглый звук, скользящие мелодии арабских макамов."},{"slug":"qanun","family":"strings-plucked","family_name":"plucked strings","home":"Middle East","tag":"qanun","en":"A flat zither plucked with picks: fast, glittering runs and tremolos.","ru":"Плоская цитра, играют медиаторами на пальцах: быстрые искристые пассажи и тремоло."},{"slug":"ney-flute","family":"winds-wood","family_name":"woodwinds","home":"Persia, Turkey","tag":"ney flute","en":"End-blown reed flute: breathy, hollow, spiritual, the Sufi sound.","ru":"Тростниковая продольная флейта: полая, с дыханием, суфийский звук."},{"slug":"kaval","family":"winds-wood","family_name":"woodwinds","home":"Balkans","tag":"kaval","en":"Long open shepherd's flute: soft, airy low register with growled overtones.","ru":"Длинная пастушья флейта: мягкий воздушный низ с рычащими обертонами."},{"slug":"zurna","family":"winds-reed","family_name":"reeds and bagpipes","home":"Turkey, Balkans","tag":"zurna","en":"Loud conical double reed: piercing, festive, outdoor and wild.","ru":"Громкий конический гобой: пронзительный, праздничный, уличный и дикий."},{"slug":"darbuka","family":"perc-drum","family_name":"drums","home":"Middle East","tag":"darbuka","en":"Goblet drum: deep doum, sharp tek and fast rolls.","ru":"Кубковый барабан: глубокий «дум», резкий «тек» и быстрые дроби."},{"slug":"santur","family":"strings-plucked","family_name":"plucked strings","home":"Persia","tag":"santur","en":"Hammered dulcimer of Persia: shimmering, bell-like repeated notes.","ru":"Персидские цимбалы: мерцающие колокольные повторы нот."},{"slug":"bandura","family":"strings-plucked","family_name":"plucked strings","home":"Ukraine","tag":"bandura","en":"Ukraine's many-stringed lute-harp: bright, chiming, harp-like chords.","ru":"Украинская многострунная лютня-арфа: звонкая, светлая, аккорды как у арфы."},{"slug":"trembita","family":"winds-brass","family_name":"brass and horns","home":"Carpathians","tag":"trembita (alpine horn)","en":"A wooden horn of the Hutsuls, metres long: low, raw calls with natural overtones.","ru":"Гуцульская деревянная труба в несколько метров: низкие сырые сигналы на натуральных обертонах."},{"slug":"hammered-dulcimer","family":"strings-plucked","family_name":"plucked strings","home":"Ukraine, Eastern Europe","tag":"hammered dulcimer (tsymbaly)","en":"Strings struck with hammers: bright, ringing, fast tremolos.","ru":"Цимбалы, струны бьют молоточками: яркий звон и быстрые тремоло."},{"slug":"sopilka","family":"winds-wood","family_name":"woodwinds","home":"Ukraine","tag":"sopilka (low)","en":"Ukrainian fipple flute: clear, folk, slightly breathy.","ru":"Украинская сопилка: ясный народный звук с лёгким дыханием."},{"slug":"sitar","family":"strings-plucked","family_name":"plucked strings","home":"India","tag":"sitar","en":"Long-necked lute with sympathetic strings: buzzing, bending, droning.","ru":"Длинногрифая лютня с резонансными струнами: жужжит, тянет ноты, гудит бурдоном."},{"slug":"tanpura-drone","family":"strings-plucked","family_name":"plucked strings","home":"India","tag":"tanpura drone","en":"Four strings never stopped: a continuous, buzzing, shimmering drone.","ru":"Четыре струны без мелодии: сплошной жужжащий мерцающий бурдон."},{"slug":"erhu","family":"strings-bowed","family_name":"bowed strings","home":"China","tag":"erhu","en":"Two-string fiddle: a singing, crying, voice-like slide.","ru":"Двуструнная скрипка: поющее, плачущее, почти голосовое скольжение."},{"slug":"guzheng","family":"strings-plucked","family_name":"plucked strings","home":"China","tag":"guzheng","en":"Long zither with movable bridges: cascading plucks and bent notes.","ru":"Длинная цитра с подвижными подставками: каскады щипков и изогнутые ноты."},{"slug":"bansuri","family":"winds-wood","family_name":"woodwinds","home":"India","tag":"bansuri","en":"Bamboo side-blown flute: soft, breathy, ornamented, pastoral.","ru":"Бамбуковая поперечная флейта: мягкая, с дыханием и украшениями, пастушья."},{"slug":"didgeridoo","family":"winds-brass","family_name":"brass and horns","home":"Australia","tag":"didgeridoo","en":"A hollow log blown with buzzing lips: one low drone, rhythmic growls, circular breath.","ru":"Полое бревно, губы вибрируют: один низкий бурдон, ритмичное рычание, круговое дыхание."},{"slug":"throat-singing-drone","family":"voice","family_name":"voice-like","home":"Tuva, Mongolia","tag":"throat singing drone","en":"One voice making two: a low drone with a whistling overtone above.","ru":"Один голос, два звука: низкий бурдон и свистящий обертон над ним."},{"slug":"cello","family":"strings-bowed","family_name":"bowed strings","home":"Europe","tag":"cello","en":"Warm, deep bowed strings, close to the human voice.","ru":"Тёплые глубокие смычковые, ближе всех к человеческому голосу."},{"slug":"viola","family":"strings-bowed","family_name":"bowed strings","home":"Europe","tag":"viola","en":"Between violin and cello: darker, veiled, melancholy.","ru":"Между скрипкой и виолончелью: темнее, приглушённее, меланхоличнее."},{"slug":"violin","family":"strings-bowed","family_name":"bowed strings","home":"Europe","tag":"violin","en":"The high bowed voice: bright, singing, agile.","ru":"Высокий смычковый голос: яркий, поющий, подвижный."},{"slug":"double-bass","family":"strings-bowed","family_name":"bowed strings","home":"Europe","tag":"double bass","en":"The lowest bowed string: a deep foundation, plucked or bowed.","ru":"Самая низкая смычковая струна: глубокий фундамент, щипком или смычком."},{"slug":"string-quartet","family":"ensemble","family_name":"ensembles","home":"Europe","tag":"string quartet","en":"Two violins, viola and cello: intimate chamber harmony.","ru":"Две скрипки, альт и виолончель: камерная гармония вблизи."},{"slug":"flute","family":"winds-wood","family_name":"woodwinds","home":"Europe","tag":"flute","en":"Concert flute: pure, silvery, airy.","ru":"Концертная флейта: чистая, серебристая, воздушная."},{"slug":"oboe","family":"winds-reed","family_name":"reeds and bagpipes","home":"Europe","tag":"oboe","en":"Double reed: plaintive, nasal, penetrating.","ru":"Двойная трость: жалобный, носовой, проникающий звук."},{"slug":"clarinet","family":"winds-reed","family_name":"reeds and bagpipes","home":"Europe","tag":"clarinet","en":"Single reed: round, woody, from a dark low to a sweet high.","ru":"Одинарная трость: круглый древесный звук, от тёмного низа до сладкого верха."},{"slug":"bassoon","family":"winds-reed","family_name":"reeds and bagpipes","home":"Europe","tag":"bassoon","en":"Low double reed: dry, reedy, often wry.","ru":"Низкая двойная трость: сухой, тростниковый, часто с усмешкой."},{"slug":"french-horn","family":"winds-brass","family_name":"brass and horns","home":"Europe","tag":"french horn","en":"Coiled horn: noble, warm, heroic and distant.","ru":"Валторна: благородная, тёплая, героическая и далёкая."},{"slug":"trumpet"