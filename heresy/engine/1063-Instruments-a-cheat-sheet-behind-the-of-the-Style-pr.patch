 /* HERESY 1067: the Train rooms history, a card a run backups/ fonts/ HERETICAL_FIRE_SONGS/ IGRB_SMITHERY/ internal-workplan/ leisure/ LEXICON_MATRIX/ LEXICON_TEX/ pdf/ sty/ subprojects/ svg-inkscape/ tex-back/ tex-book-GCF/ tex-front/ tex-igrbible/ tex-igrbible-exported/ tex-lexicon-gr/ tex-misc/ tmpfs.gen/ tmpfs.out/ tmpfs.tmp/ utils/ WEBSITES/
+/* HERESY 1069: the instruments cheat-sheet */
+.hi-open { margin-left: 8px; padding: 0 7px; border: 1px solid var(--line); border-radius: var(--r-pill); background: none; color: var(--amber); font: inherit; font-size: 13px; letter-spacing: 0; cursor: pointer; vertical-align: 1px; }
+.hi-open:hover { border-color: var(--amber); }
+.hi-back { position: fixed; inset: 0; z-index: 70; display: flex; align-items: center; justify-content: center; padding: 16px; background: var(--shadow-lg, rgba(0,0,0,.5)); }
+.hi-back[hidden] { display: none; }
+.hi-box { width: min(1100px, 100%); max-height: calc(100vh - 32px); display: flex; flex-direction: column; gap: 8px; padding: 14px 16px; border: 1px solid var(--line-strong); border-radius: var(--r-lg); background: var(--panel); color: var(--ink); box-shadow: 0 20px 60px var(--shadow-lg); }
+.hi-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
+.hi-head b { font-size: 16px; }
+.hi-tools { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
+.hi-tools input[type="search"] { flex: 1; min-width: 200px; width: auto; }
+.hi-tools select { width: auto; font-size: 12px; padding-top: 5px; padding-bottom: 5px; }
+.hi-scroll { overflow: auto; min-height: 0; flex: 1; }
+.hi-table { width: 100%; border-collapse: collapse; font-size: 13px; }
+.hi-table td { padding: 6px 8px; border-bottom: 1px solid var(--line-soft); vertical-align: top; }
+.hi-fam th { position: sticky; top: 0; z-index: 1; text-align: left; padding: 8px 8px 4px; background: var(--panel); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--line); }
+.hi-fam em { font-style: normal; color: var(--dim); }
+.hi-name { width: 24%; }
+.hi-tag { padding: 0; border: 0; background: none; color: var(--ink); font: inherit; font-weight: 600; text-align: left; cursor: copy; }
+.hi-tag:hover { color: var(--amber); }
+.hi-home { font-size: 11.5px; color: var(--dim); }
+.hi-ru { color: var(--muted); font-size: 12px; margin-top: 2px; }
+.hi-plays { width: 150px; white-space: nowrap; text-align: right; }
+.hi-plays .btn { padding: 2px 8px; }
+.hi-noplay { display: inline-block; width: 46px; text-align: center; color: var(--dim); font-size: 11px; }
+.hi-ok { font-size: 11px; color: var(--good); white-space: nowrap; }
+tr.is-heard .hi-tag { color: var(--good); }
+@media (max-width: 640px) { .hi-name { width: auto; } .hi-plays { width: auto; } .hi-table td { display: block; border: 0; } .hi-table tr { display: block; border-bottom: 1px solid var(--line-soft); } }
