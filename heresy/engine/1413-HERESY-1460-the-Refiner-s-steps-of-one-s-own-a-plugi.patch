+/* HERESY 1460: a plugin's step in the Refiner's row, marked apart by a dotted edge; its panel like the studio's own */
+.post-steps .ps-step.is-plugin { border-style: dashed; }
+.pl-panel .pl-check { flex-direction: row; align-items: center; gap: 6px; }
+.pl-panel .pl-state.is-bad { color: var(--bad, #e06c5a); }
