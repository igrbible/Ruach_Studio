Date: Fri, 2 Oct 2026 18:23:53 -0600
Subject: [PATCH 1089/1252] The icon on a full square (Viktor: no disc); the
 waveform's waiting part much lighter by day (1119)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/console/app.css      |   6 +++---
 tools/console/app.js       |   5 ++++-
 tools/console/index.html   |  10 ++++------
 tools/public/index.html.gz | Bin 465322 -> 466255 bytes
 4 files changed, 11 insertions(+), 10 deletions(-)

diff --git a/tools/console/app.css b/tools/console/app.css
index e200474..40c1d8e 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -3105,12 +3105,12 @@ input[type="search"]::-webkit-search-cancel-button { cursor: pointer; }
 /* ---------------------------------------------------------------- HERESY 1119: the logo in the dead centre of the bar
    Out of the flow, so the bar's own things keep their places; it takes no clicks. She descends below the bar's edge:
    in a browser tab nothing may rise above the window (an installed app with Window Controls Overlay could). The
-   workspace picker moves beside the buttons, clear of her. Too narrow for the words: the woman alone, in her disc;
-   narrower still: the disc back at the start of the bar. */
+   workspace picker moves beside the buttons, clear of her. Too narrow for the words: the woman alone, on her square;
+   narrower still: the square back at the start of the bar. */
 .topbar .brand { position: absolute; left: 50%; top: 0; transform: translateX(-50%); height: 52px; z-index: 2; pointer-events: none; display: block; }
 .topbar .brand .brand-logo { display: block; height: 100%; }
 .brand-full { display: block; height: 62px; width: auto; overflow: visible; }
-.brand-icon { display: none; width: 44px; height: 44px; margin-top: 4px; }
+.brand-icon { display: none; width: 44px; height: 44px; margin-top: 4px; border-radius: 9px; }   /* the square, its corners softened in the bar only */
 .topbar .ws-current + .spacer { display: none; }
 @media (max-width: 1659px) { .brand-full { display: none; } .brand-icon { display: block; } }
 @media (max-width: 1359px) { .topbar .brand { position: static; transform: none; height: auto; order: -1; } .brand-icon { margin-top: 0; } }
diff --git a/tools/console/app.js b/tools/console/app.js
index 85033b6..e5c5640 100644
--- a/tools/console/app.js
+++ b/tools/console/app.js
@@ -4105,7 +4105,10 @@
           g.addColorStop(0, themeRGBA("amber-hi", 1)); g.addColorStop(0.5, themeRGBA("amber", 1)); g.addColorStop(1, themeRGBA("amber-hi", 1));
           return g;
         }),
-        rest: cloudSprite(env, w, h, dpr, function () { return themeRGBA("ink", 0.38); }) };
+        rest: cloudSprite(env, w, h, dpr, function () {             // the waiting part: a light grey by day (Viktor: "much lighter,
+          var g = themeRGB("ground");                                 // it looks dirty"), as it was by night
+          return themeRGBA("ink", (0.2126 * g[0] + 0.7152 * g[1] + 0.0722 * g[2]) / 255 > 0.5 ? 0.21 : 0.36);
+        }) };
     }
     return cloud;
   }
