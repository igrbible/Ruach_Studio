diff --git a/tools/console/app.css b/tools/console/app.css
index 381ded8..210bde1 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -5550,3 +5550,15 @@ body:has(.ar-view) .hm-tip { z-index: 131; }
 .ar-ico.is-on { color: var(--amber); background: color-mix(in srgb, var(--amber) 14%, transparent); }
 .ar-ico[disabled] { opacity: .38; cursor: default; background: none; }
 .ar-stage-acts > .ar-up-row { flex-basis: 100%; }
+
+/* HERESY 1427: the line numbers and the spelling by the Lyrics' title; the meter's counts in blocks, their numbers bold */
+.k-lyrics [data-fold="lyrics"] > .label { display: flex; align-items: center; min-width: 0; }
+.lyr-head-togs { gap: 2px; order: 9; }   /* last in the row whatever help.js adds after it (the (i), the fold peek) */
+.lyr-head-tog[aria-pressed="true"] { color: var(--amber); }
+.lyr-head-tog[aria-pressed="false"] { color: var(--dim); opacity: .75; }
+.lyr-meter { gap: 6px 8px; }
+.lyr-blk { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 2px 12px; padding: 3px 10px; border-radius: var(--r-md);
+  background: color-mix(in srgb, var(--ink) 4%, transparent); }
+.lyr-blk b { font-family: var(--mono); font-weight: 600; color: var(--ink); }
+.lyr-blk-look, .lyr-blk-tools { background: none; padding: 0; gap: 6px; }
+.lyr-blk-tools { margin-left: auto; }
