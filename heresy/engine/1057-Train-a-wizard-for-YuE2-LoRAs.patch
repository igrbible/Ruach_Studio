diff --git a/tools/console/heresy-train.js b/tools/console/heresy-train.js
new file mode 100644
index 0000000..287d907
--- /dev/null
+++ b/tools/console/heresy-train.js
@@ -0,0 +1,175 @@
+// HERESY 1063: the Train tab, a wizard for YuE2 LoRAs (Viktor, 01.10.2026). The lab does the work
+// (lab/training.py: AI-Toolkit underneath for now); this page walks the four steps:
+//   1 Raw      a folder of datasets/raw/, its tracks: which go in, their lyrics, a style of their own
+//   2 Set      the shared style line (and trigger word); made into datasets/prepared/NAME/
+//   3 Train    a kind of adapter (its defaults), the knobs, the run, its progress and the AR loss
+//   4 Result   the LoRA in loras/RUN/, ready in Create
+(function () {
+  "use strict";
+
+  var KINDS = {
+    style:    { label: "Style", say: "genre, production, a band's sound", o: { rank: 32, steps: 1500, ar_loss_weight: 0.5, ar_kl_weight: 0.2, ar_lr_multiplier: 0.5 } },
+    voice:    { label: "Voice", say: "one singer's timbre", o: { rank: 16, steps: 1500, ar_loss_weight: 0.3, ar_kl_weight: 0.3, ar_lr_multiplier: 0.5 } },
+    language: { label: "Language", say: "diction of a language; exact lyrics, many voices", o: { rank: 32, steps: 3000, ar_loss_weight: 1.0, ar_kl_weight: 0.1, ar_lr_multiplier: 1.0 } },
+    artist:   { label: "Artist", say: "all of it; a large, varied catalogue", o: { rank: 32, steps: 3000, ar_loss_weight: 0.7, ar_kl_weight: 0.2, ar_lr_multiplier: 0.7 } }
+  };
+  var state = { hooks: null, data: null, raw: null, scan: null, rows: [], run: "", timer: 0, kind: "style" };
+  function $(id) { return document.getElementById(id); }
+  function esc(s) { return String(s == null ? "" : s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); }
+  function toast(t, bad) { state.hooks && state.hooks.toast(t, bad ? "bad" : ""); }
+  function api(path, body) {
+    var opt = body === undefined ? {} : { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) };
+    return fetch("/lab" + path, opt).then(function (r) { return r.json().then(function (b) { if (!r.ok && r.status !== 202) throw new Error(b.error || r.status); return b; }); });
+  }
+  function clock(s) { s = Math.round(s || 0); return Math.floor(s / 60) + ":" + ("0" + (s % 60)).slice(-2); }
+  function gb(b) { return (b / 1e9).toFixed(1) + " GB"; }
+  function slug(s) { return String(s || "").normalize("NFKD").replace(/[^\w.-]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 60) || "set"; }
+
+  function load() {
+    return api("/train/datasets").then(function (d) { state.data = d; paint(); }).catch(function (e) {
+      $("trBody").innerHTML = '<p class="row-hint">The lab does not answer: ' + esc(e.message) + "</p>";
+    });
+  }
+
+  function paint() {
+    var d = state.data;
+    if (!d) return;
+    $("trWarn").innerHTML = (!d.aitk_ready ? '<p class="tr-warn">AI-Toolkit is not found at <code>' + esc(d.aitk) + "</code>: clone ostris/ai-toolkit there (or set AITK_ROOT for the lab).</p>" : "") +
+      (!d.head ? '<p class="tr-warn">The realaudio tokenizer is missing from <code>checkpoints/yue2-mothersuperior-realaudio-tokenizer-v4/</code>.</p>' : "");
+    $("trRaw").innerHTML = d.raw.length ? d.raw.map(function (r) {
+      return '<button type="button" class="tr-pick' + (state.raw === r.name ? " is-on" : "") + '" data-raw="' + esc(r.name) + '"><b>' + esc(r.name) + "</b><span>" +
+        r.tracks + " tracks · " + gb(r.bytes) + (r.captions ? " · " + r.captions + " captions" : "") + "</span></button>";
+    }).join("") : '<p class="row-hint">Put a folder of songs into <code>datasets/raw/</code>, then press Reload.</p>';
+    $("trSets").innerHTML = d.prepared.length ? d.prepared.map(function (p) {
+      return '<label class="tr-set"><input type="radio" name="trSet" value="' + esc(p.name) + '"' + ($("trRunName").dataset.set === p.name ? " checked" : "") + " /> <b>" + esc(p.name) + "</b> <span>" +
+        p.tracks + " tracks · " + clock(p.seconds) + " · from " + esc(p.from) + " · " + esc(p.made) + "</span></label>";
+    }).join("") : '<p class="row-hint">No set made yet: step 2.</p>';
+    $("trRuns").innerHTML = d.runs.length ? d.runs.map(function (r) {
+      return '<div class="tr-run"><b>' + esc(r.name) + "</b> <span class=\"tr-st is-" + esc(r.status) + '">' + esc(r.status) + "</span> <span>" + esc(r.dataset) + " · " +
+        (r.step || 0) + " / " + (r.steps || "?") + (r.ar_ce != null ? " · ar_ce " + Number(r.ar_ce).toFixed(3) : "") + "</span>" +
+        (r.lora ? ' <code>loras/' + esc(r.lora) + "</code>" : "") + (r.error ? ' <span class="tr-err">' + esc(r.error) + "</span>" : "") +
+        ' <button type="button" class="btn ghost small" data-watch="' + esc(r.name) + '">Watch</button></div>';
+    }).join("") : '<p class="row-hint">No runs yet.</p>';
+  }
+
+  // ---- step 1: the raw tracks
+  function pickRaw(name) {
+    state.raw = name; paint();
+    $("trTracks").innerHTML = '<p class="row-hint">Reading the folder…</p>';
+    api("/train/scan?name=" + encodeURIComponent(name)).then(function (d) {
+      state.rows = d.tracks.map(function (t) {
+        return { file: t.file, seconds: t.seconds, include: (t.seconds || 0) >= 30, style: "", lyrics: t.lyrics || "", from: t.lyrics_from || "", hints: t.hints || [] };
+      });
+      $("trSetName").value = slug(name);
+      paintTracks();
+    }).catch(function (e) { $("trTracks").innerHTML = '<p class="tr-warn">' + esc(e.message) + "</p>"; });
+  }
+  function paintTracks() {
+    var n = state.rows.filter(function (r) { return r.include; }).length, secs = state.rows.reduce(function (s, r) { return s + (r.include ? r.seconds || 0 : 0); }, 0);
+    var groups = {};                    // versions of one song: the same name once the version marks are taken off
+    state.rows.forEach(function (r) { var k = r.file.replace(/\.[^.]+$/, "").replace(/\bv?\d+([._]\d+)*\b|\(\d+\)|extra|remaster(ed)?|[^a-zа-яё]+/gi, " ").trim().toLowerCase(); (groups[k] = groups[k] || []).push(r); });
+    var dups = Object.keys(groups).filter(function (k) { return groups[k].filter(function (r) { return r.include; }).length > 2; }).length;
+    $("trTracksNote").textContent = n + " of " + state.rows.length + " in · " + clock(secs) + " · " +
+      state.rows.filter(function (r) { return r.include && r.lyrics; }).length + " with lyrics";
+    $("trTracks").innerHTML = state.rows.map(function (r, i) {
+      var long = (r.seconds || 0) > 360, short = (r.seconds || 0) < 30;
+      return '<div class="tr-track' + (r.include ? "" : " is-out") + '"><label class="tr-in"><input type="checkbox" data-in="' + i + '"' + (r.include ? " checked" : "") + " /></label>" +
+        '<div class="tr-tbody"><div class="tr-thead"><span class="tr-file">' + esc(r.file) + '</span><span class="tr-sec' + (long || short ? " is-bad" : "") + '">' + clock(r.seconds) +
+        (long ? " · long: the AR trains on the whole song" : short ? " · under 0:30" : "") + (r.lyrics ? "" : " · no lyrics") + '</span><button type="button" class="btn ghost small" data-open="' + i + '">' + (r.lyrics ? "Lyrics ✓" : "Lyrics") + "</button></div>" +
+        '<div class="tr-edit" data-edit="' + i + '" hidden>' + (r.from ? '<span class="row-hint">lyrics from ' + esc(r.from) + (r.hints.length ? " · hints (not in the caption): " + esc(r.hints.join(" · ")) : "") + "</span>" : "") +
+        '<input type="text" data-style="' + i + '" value="' + esc(r.style) + '" placeholder="a style of its own (empty: the shared one)" />' +
+        '<textarea rows="8" data-lyrics="' + i + '" placeholder="[Verse]\nthe lyrics exactly as sung (empty for an instrumental)">' + esc(r.lyrics) + "</textarea></div></div></div>";
+    }).join("");
+  }
+
+  // ---- step 2: make the set
+  function makeSet() {
+    if (!state.raw) return toast("Pick a raw folder first", true);
+    var style = $("trStyle").value.trim(), trigger = $("trTrigger").value.trim();
+    if (!style) return toast("Write the shared style line: what is heard, in the words you will generate with", true);
+    var name = slug($("trSetName").value);
+    var tracks = state.rows.map(function (r) { return { file: r.file, include: r.include, style: r.style ? (trigger ? trigger + ", " : "") + r.style : "", lyrics: r.lyrics }; });
+    $("trMake").disabled = true;
+    api("/train/prepare", { from: state.raw, name: name, style: (trigger ? trigger + ", " : "") + style, tracks: tracks }).then(function () {
+      (function poll() {
+        api("/train/prepare?name=" + encodeURIComponent(name)).then(function (j) {
+          $("trMakeState").textContent = j.status === "running" ? "making… " + j.done + " / " + j.total : j.status === "done" ? "made: datasets/prepared/" + name : "failed: " + (j.error || "");
+          if (j.status === "running") return setTimeout(poll, 1500);
+          $("trMake").disabled = false;
+          if (j.status === "done") { $("trRunName").dataset.set = name; load(); toast("The set " + name + " is made"); }
+        });
+      })();
+    }).catch(function (e) { $("trMake").disabled = false; toast(e.message, true); });
+  }
+
+  // ---- step 3: the run
+  function setKind(k) {
+    state.kind = k;
+    Array.prototype.forEach.call(document.querySelectorAll("[data-kind]"), function (b) { b.classList.toggle("is-on", b.dataset.kind === k); });
+    var o = KINDS[k].o;
+    Object.keys(o).forEach(function (key) { var el = $("tr_" + key); if (el) el.value = o[key]; });
+    $("trKindSay").textContent = KINDS[k].say;
+  }
+  function startRun() {
+    var set = (document.querySelector('input[name="trSet"]:checked') || {}).value;
+    if (!set) return toast("Pick a set (step 2)", true);
+    var spec = { dataset: set, name: slug($("trRunName").value || set + "-" + state.kind) };
+    ["steps", "rank", "lr", "ar_loss_weight", "ar_kl_weight", "ar_lr_multiplier"].forEach(function (k) { spec[k] = parseFloat($("tr_" + k).value); });
+    spec.cot = $("tr_cot").value; spec.quant = $("tr_quant").value; spec.do_separation = $("tr_sep").checked;
+    window.HeresyDialog.confirm("Train " + spec.name + "?\n\n" + spec.steps + " steps on " + set + ", rank " + spec.rank + ", AR weight " + spec.ar_loss_weight +
+      ". It takes a GPU of its own for hours; the first run also fetches Comfy-Org's YuE2 weights.", { ok: "Train" }).then(function (ok) {
+      if (!ok) return;
+      return api("/train/run", spec).then(function () { toast("Training " + spec.name); watch(spec.name); load(); });
+    }).catch(function (e) { toast(e.message, true); });
+  }
+  function watch(name) {
+    state.run = name; clearTimeout(state.timer);
+    (function poll() {
+      api("/train/run?name=" + encodeURIComponent(name)).then(function (r) {
+        var pct = r.steps ? Math.round(100 * (r.step || 0) / r.steps) : 0;
+        $("trWatch").hidden = false;
+        $("trWatchHead").innerHTML = "<b>" + esc(name) + '</b> <span class="tr-st is-' + esc(r.status) + '">' + esc(r.status) + "</span> " + (r.step || 0) + " / " + (r.steps || "?") +
+          (r.loss != null ? " · loss " + Number(r.loss).toFixed(4) : "") + (r.ar_ce != null ? " · ar_ce " + Number(r.ar_ce).toFixed(3) + (r.ar_ce < 0.3 ? " ⚠ near 0: memorizing" : "") : "") +
+          (r.lora ? " · <code>loras/" + esc(r.lora) + "</code>" : "") + (r.error ? ' <span class="tr-err">' + esc(r.error) + "</span>" : "");
+        $("trBar").style.width = pct + "%";
+        $("trBar").parentNode.classList.toggle("is-running", r.status === "running");
+        $("trTail").textContent = (r.tail || []).join("\n");
+        $("trStop").hidden = r.status !== "running";
+        if (r.status === "running" && state.run === name) state.timer = setTimeout(poll, 3000); else load();
+      }).catch(function (e) { $("trWatchHead").textContent = e.message; });
+    })();
+  }
+
+  function init(hooks) {
+    if (!$("view-train")) return;
+    state.hooks = hooks;
+    $("trReload").addEventListener("click", load);
+    $("trRaw").addEventListener("click", function (e) { var b = e.target.closest("[data-raw]"); if (b) pickRaw(b.dataset.raw); });
+    $("trTracks").addEventListener("change", function (e) {
+      var i = e.target.dataset.in;
+      if (i !== undefined) { state.rows[+i].include = e.target.checked; paintTracks(); }
+    });
+    $("trTracks").addEventListener("input", function (e) {
+      if (e.target.dataset.style !== undefined) state.rows[+e.target.dataset.style].style = e.target.value;
+      if (e.target.dataset.lyrics !== undefined) state.rows[+e.target.dataset.lyrics].lyrics = e.target.value;
+    });
+    $("trTracks").addEventListener("click", function (e) {
+      var b = e.target.closest("[data-open]");
+      if (b) { var ed = document.querySelector('[data-edit="' + b.dataset.open + '"]'); ed.hidden = !ed.hidden; }
+    });
+    $("trAllIn").addEventListener("click", function () { state.rows.forEach(function (r) { r.include = true; }); paintTracks(); });
+    $("trNoneIn").addEventListener("click", function () { state.rows.forEach(function (r) { r.include = false; }); paintTracks(); });
+    $("trMake").addEventListener("click", makeSet);
+    $("trKinds").innerHTML = Object.keys(KINDS).map(function (k) { return '<button type="button" class="coll-chip" data-kind="' + k + '">' + KINDS[k].label + "</button>"; }).join("");
+    $("trKinds").addEventListener("click", function (e) { var b = e.target.closest("[data-kind]"); if (b) setKind(b.dataset.kind); });
+    $("trRun").addEventListener("click", startRun);
+    $("trStop").addEventListener("click", function () {
+      window.HeresyDialog.confirm("Stop " + state.run + "?\n\nAI-Toolkit saves what it has on the way out; the last checkpoint goes to loras/.", { ok: "Stop", danger: true })
+        .then(function (ok) { if (ok) return api("/train/stop", { name: state.run }).then(function () { toast("Stopping " + state.run); }); }).catch(function (e) { toast(e.message, true); });
+    });
+    $("trRuns").addEventListener("click", function (e) { var b = e.target.closest("[data-watch]"); if (b) watch(b.dataset.watch); });
+    setKind("style");
+  }
+
+  window.HeresyTrain = { init: init, reload: load };
+})();
