+  <!-- HERESY 1063: Train — LoRA adapters for YuE2, a wizard (heresy-train.js, lab/training.py) -->
+  <section class="col train-col is-hidden" id="view-train">
+    <div class="col-head"><h2>Train</h2><span class="col-note">a LoRA for YuE2 from your own songs · the guide: LORA-TRAINING.md</span>
+      <span class="spacer"></span><button type="button" class="btn ghost small" id="trReload">Reload</button></div>
