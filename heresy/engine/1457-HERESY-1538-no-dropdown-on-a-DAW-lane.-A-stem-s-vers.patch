diff --git a/tools/console/app.css b/tools/console/app.css
index 21f1021..7522e26 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -6399,3 +6399,10 @@ html[data-glow] body.daw-full #dawPanel { box-shadow: none; }
 /* HERESY 1537: the compressor's key */
 .dv-key { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
 .dv-key .mc-chips { flex: 1 1 auto; }
+/* HERESY 1538: a lane's version as a button (the select hidden under it), the master's goniometer */
+.mx-lane select.mx-ver { display: none; }
+.mx-verb { flex: 0 0 150px; width: 150px; min-width: 0; height: 26px; display: flex; align-items: center; gap: 6px; padding: 2px 8px; border: 1px solid var(--line); border-radius: 4px; background: transparent; color: var(--ink); font: 12px/1.2 inherit; text-align: left; cursor: pointer; }
+.mx-verb > span { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.mx-verb > i { flex: none; font-style: normal; font-size: 10px; color: var(--dim); }
+.mx-verb:disabled { cursor: default; color: var(--muted); }
+.dv-gonio { width: 220px; height: 220px; border-radius: 4px; }
diff --git a/tools/console/heresy-console.js b/tools/console/heresy-console.js
index a61ab34..072e3aa 100644
--- a/tools/console/heresy-console.js
+++ b/tools/console/heresy-console.js
@@ -237,7 +237,8 @@
       var t = x === "*" ? tr("Master") : x === "~room" ? tr("Room") : x === "~delay" ? tr("Delay") : M.title(x);
       return '<button type="button" class="mc-chip' + (x === n ? " is-on" : "") + '" data-act="pick" data-v="' + esc(x) + '" aria-pressed="' + (x === n) + '" translate="no" style="--mc-hue:' + (x.charAt(0) === "~" || x === "*" ? "var(--dim)" : M.hue(x)) + '">' + esc(t) + "</button>"; }).join("") + "</div>";
     if (n === "*") return chooser + '<div class="dv-row">' + card("dv-master", tr("Master"), true, '<div class="dv-loud">' + masterHtml().replace(/^<div class="mc-strip mc-master" data-n="\*">/, "").replace(/<\/div>$/, "") + "</div>" +
-      '<canvas class="dv-spec" data-spec="*" width="640" height="220"></canvas>') + "</div>";
+      '<canvas class="dv-spec" data-spec="*" width="640" height="220"></canvas>' +
+      '<canvas class="dv-gonio" width="220" height="220" data-tip="' + esc(tr("The two sides as a picture: mid up, side across; a line up is mono, a wide cloud wide, a line across out of phase")) + '"></canvas>') + "</div>";   // HERESY 1538
     if (n === "~room" || n === "~delay") {
       var bus = n === "~room" ? "reverb" : "delay", b = M.S.buses[bus];
       var body = bus === "reverb"
@@ -454,8 +455,25 @@
     if (C.tab === "devices" && M.S.playing) {
       if (dock.querySelector("canvas.dv-eq")) drawEq();
       if (dock.querySelector('canvas.dv-spec[data-spec="*"]')) drawSpec();
+      if (dock.querySelector("canvas.dv-gonio")) drawGonio();   // HERESY 1538
     }
   }
+  // HERESY 1538: the goniometer: each pair of samples a dot, mid (L+R) up and side (L−R) across, scaled to the loudest of the block
+  var GL = null, GR2 = null;
+  function drawGonio() {
+    var c = document.querySelector("#mxDock canvas.dv-gonio"), M = K(), aL = M && M.analyser("*L"), aR = M && M.analyser("*R");
+    if (!c || !aL || !aR) return;
+    if (!GL || GL.length !== aL.fftSize) { GL = new Float32Array(aL.fftSize); GR2 = new Float32Array(aR.fftSize); }
+    aL.getFloatTimeDomainData(GL); aR.getFloatTimeDomainData(GR2);
+    var w = c.width, h = c.height, g = c.getContext("2d"), pk = 1e-4;
+    for (var i = 0; i < GL.length; i++) { var a = Math.abs(GL[i]) + Math.abs(GR2[i]); if (a > pk) pk = a; }
+    var k = (w / 2 - 8) / Math.max(pk, 0.05);
+    g.fillStyle = css(c, "--sunk", "#000"); g.globalAlpha = 0.35; g.fillRect(0, 0, w, h); g.globalAlpha = 1;
+    g.strokeStyle = css(c, "--dim", "#888"); g.globalAlpha = 0.3; g.beginPath(); g.moveTo(w / 2, 4); g.lineTo(w / 2, h - 4); g.moveTo(4, h / 2); g.lineTo(w - 4, h / 2); g.stroke(); g.globalAlpha = 1;
+    g.fillStyle = css(c, "--amber", "#d99d10"); g.globalAlpha = 0.5;
+    for (var j = 0; j < GL.length; j += 2) { var mid = (GL[j] + GR2[j]) * 0.5, side = (GL[j] - GR2[j]) * 0.5; g.fillRect(w / 2 + side * k, h / 2 - mid * k, 1.5, 1.5); }
+    g.globalAlpha = 1;
+  }
   function drawSpec() {
     var c = document.querySelector('#mxDock canvas.dv-spec[data-spec="*"]'), M = K(), an = M && M.analyser("*");
     if (!c || !an) return;
