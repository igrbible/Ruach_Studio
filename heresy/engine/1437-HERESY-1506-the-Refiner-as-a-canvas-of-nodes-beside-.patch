diff --git a/tools/console/app.css b/tools/console/app.css
index a43481e..add8825 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -6054,3 +6054,51 @@ body.daw-full #dawPanel .mx-wave, body.daw-full #dawPanel .mx-lane.is-open .mx-w
 .mx-wave.mx-ruler { height: 22px; cursor: text; }
 .mx-wave.mx-ruler canvas { display: block; --mx-wave: var(--dim); }
 body.daw-full #dawPanel .mx-wave.mx-ruler { height: 22px; }
+
+/* HERESY 1506: the Refiner as a canvas of nodes (ComfyUI's way), beside its list; a node's panel lifted over the room as the Creator's frames */
+.post-head .post-view { margin-left: auto; align-self: center; }
+.post-head .post-view ~ .post-daw { margin-left: 8px; }
+#view-post.is-canvas > #postSteps, #view-post.is-canvas > .drawer.is-step, #view-post.is-canvas > .dv-tree-box, #view-post.is-canvas > #importPanel { display: none; }
+#view-post > #postCanvas { grid-column: 1 / -1; grid-row: 4; }
+.post-canvas { position: relative; margin-top: 4px; min-height: 420px; overflow: hidden; border: 1px solid var(--line-a); border-radius: var(--r-md);
+  background-color: var(--panel); background-image: radial-gradient(color-mix(in srgb, var(--ink) 16%, transparent) 1px, transparent 1.2px); background-size: 22px 22px; }
+.pcv-wires { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
+.pcv-wire { fill: none; stroke: color-mix(in srgb, var(--ink) 22%, transparent); stroke-width: 1.5; }
+.pcv-wire.is-any { stroke-dasharray: 4 5; }
+.pcv-wire.is-lit { stroke: var(--amber); stroke-width: 2.5; stroke-dasharray: none; }
+.pcv-node { position: absolute; width: 196px; min-height: 84px; display: flex; flex-direction: column; gap: 3px; padding: 8px 10px 8px 11px; text-align: left;
+  border: 1px solid var(--line-strong-a, var(--line-a)); border-top: 3px solid var(--pcv-edge, var(--line-a)); border-radius: var(--r-md); background: var(--ground);
+  color: var(--ink); box-shadow: 0 6px 18px var(--shadow-sm, rgba(0, 0, 0, .12)); cursor: pointer; touch-action: none; user-select: none; }
+.pcv-node:hover { border-color: var(--amber); }
+.pcv-node:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }
+.pcv-node.is-dragged { cursor: grabbing; box-shadow: 0 14px 34px var(--shadow-lg, rgba(0, 0, 0, .25)); z-index: 2; }
+.pcv-node.is-active { box-shadow: inset 0 0 0 1px var(--amber), 0 6px 18px var(--shadow-sm, rgba(0, 0, 0, .12)); }
+.pcv-node.is-plugin { border-style: dashed; border-top-style: solid; }
+.pcv-take { --pcv-edge: var(--amber); }
+.pcv-import { --pcv-edge: var(--dim); }
+.pcv-look { --pcv-edge: #4f8fd6; }
+.pcv-mend { --pcv-edge: #c9a227; }
+.pcv-finish { --pcv-edge: #5aa864; }
+.pcv-top { display: flex; align-items: center; gap: 7px; min-width: 0; }
+.pcv-n { flex: none; display: inline-grid; place-items: center; width: 20px; height: 20px; border: 1px solid var(--line-strong-a, var(--line-a)); border-radius: 50%;
+  font-size: 11px; color: var(--dim); }
+.pcv-node.is-done .pcv-n { background: var(--good); border-color: var(--good); color: var(--panel); }
+.pcv-name { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.pcv-say { font-size: 12px; color: var(--dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.pcv-meta { display: flex; gap: 8px; font-size: 11.5px; color: var(--dim); min-height: 14px; }
+.pcv-done { color: var(--good); font-weight: 700; }
+.pcv-live { display: none; width: 8px; height: 8px; margin-left: auto; border-radius: 50%; background: var(--amber); animation: pcvPulse 1.1s ease-in-out infinite; }
+.pcv-node.is-running .pcv-live { display: inline-block; }
+@keyframes pcvPulse { 50% { opacity: .25; transform: scale(.7); } }
+.pcv-tools { position: absolute; right: 10px; bottom: 8px; display: flex; align-items: center; gap: 10px; }
+.nd-veil { position: fixed; left: 0; right: 0; top: 0; bottom: var(--playbar-h); z-index: 26; background: color-mix(in srgb, var(--ground) 45%, rgba(0, 0, 0, .55));
+  backdrop-filter: blur(3px); }
+.nd-box { position: fixed; z-index: 27; left: 1.5vw; width: 97vw; top: calc((100vh - var(--playbar-h)) * .015); height: calc((100vh - var(--playbar-h)) * .97);
+  display: flex; flex-direction: column; background: var(--ground); border: 1px solid var(--line-strong-a, var(--line-a)); border-radius: var(--r-lg);
+  box-shadow: 0 24px 80px var(--shadow-lg, rgba(0, 0, 0, .35)); }
+.nd-box[hidden], .nd-veil[hidden] { display: none; }
+.nd-head { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-bottom: 1px solid var(--line-a); }
+.nd-title { font-size: 16px; }
+.nd-body { flex: 1; min-height: 0; overflow: auto; padding: 14px 18px 18px; }
+.nd-body > .drawer, .nd-body > .dv-tree-box { margin: 0; display: block; }
+
