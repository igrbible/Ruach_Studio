From 8fc652655e8ed3484e8e20204718f98d95980cb5 Mon Sep 17 00:00:00 2001
From: Pascal <admin@serveurperso.com>
Date: Wed, 7 Oct 2026 16:47:17 +0200
Subject: [PATCH 1192/1198] build: declare a cmake policy range like llama.cpp

A bare 3.14 minimum keeps CMP0092 OLD, so CMake injects /W3 into the
MSVC flags. Under Ninja it collides with the per target /W4 (D9025 on
every TU) and pushes ggml to /W3, surfacing C4267 that llama.cpp never
shows.

(cherry picked from commit 8d437e867c9ca7d16aa14d5217d92c61d9f0eff0)
---
 CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index ececb28..ad4947e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,4 +1,4 @@
-cmake_minimum_required(VERSION 3.14)
+cmake_minimum_required(VERSION 3.14...3.28)
 project(yue2-ggml LANGUAGES C CXX)
 
 set(CMAKE_CXX_STANDARD 17)
