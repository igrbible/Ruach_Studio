diff --git a/tools/console/app.css b/tools/console/app.css
index 4face4d..1b63b16 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -3206,10 +3206,10 @@ body[data-tab="train"] .log-dock.is-tall .log-dock-body { height: calc(100vh - v
 .log-dock.has-gpus:not(.is-folded):not(.is-tall) .log-dock-gpus { height: var(--gl-h, calc(10 * 1.5 * 11px + 16px)); }
 .log-dock.has-gpus.is-tall .log-dock-body, .log-dock.has-gpus.is-tall .log-dock-gpus { height: calc(100vh - var(--bar-h) - var(--playbar-h, 60px) - 74px); }
 .gl-card { display: flex; flex-direction: column; gap: 3px; padding: 5px 8px 6px; border: 1px solid var(--line-a, var(--line)); border-radius: var(--r-sm, 4px); }
-.gl-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; min-width: 0; }
+.gl-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0 8px; min-width: 0; }
 .gl-head .gl-name { flex: none; }
 .gl-card.is-main { border: 1.5px solid var(--amber); box-shadow: 0 0 0 2px color-mix(in srgb, var(--amber) 14%, transparent); }
-.gl-role { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 600 10px/1.3 var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
+.gl-role { min-width: 0; overflow-wrap: anywhere; font: 600 10px/1.3 var(--sans);   /* HERESY 1293: all its roles, on a second line when they need it */ letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
 .gl-card.is-main .gl-role { color: var(--amber); }
 .gl-name { font-size: 11px; color: var(--ink); }
 .gl-graph { display: block; width: 100%; height: 40px; }
diff --git a/tools/console/heresy-gpulive.js b/tools/console/heresy-gpulive.js
index 471ee89..1aeebe9 100644
--- a/tools/console/heresy-gpulive.js
+++ b/tools/console/heresy-gpulive.js
@@ -103,8 +103,15 @@
       card.querySelector(".gl-nums").innerHTML = nums(ring);
       draw(card.querySelector("canvas"), ring, false);
     });
-    // the dock as tall as its cards need (the log beside them as tall), never more than 60 % of the window: both scroll inside
-    dock.style.setProperty("--gl-h", Math.min(Math.max(host.scrollHeight, 181), Math.round(innerHeight * 0.6)) + "px");
+    // the dock as tall as its cards need (the log beside them as tall), never more than 60 % of the window: both scroll inside.
+    // HERESY 1293: what the cards need is the last one's bottom, not the column's scrollHeight: the column is --gl-h itself, so that
+    // kept a full height's size after folding back, and lost the column's border, a pixel a tick
+    var last = host.lastElementChild, cs = getComputedStyle(host);
+    if (!last) return;
+    var need = Math.ceil(last.getBoundingClientRect().bottom - host.getBoundingClientRect().top + host.scrollTop +
+                         (parseFloat(cs.paddingBottom) || 0) + (parseFloat(cs.borderBottomWidth) || 0));
+    var h = Math.min(Math.max(need, 181), Math.round(innerHeight * 0.6)) + "px";
+    if (dock.style.getPropertyValue("--gl-h") !== h) dock.style.setProperty("--gl-h", h);
   }
   function paint(on) {
     if (on.indexOf("engine") >= 0) paintEngine();
