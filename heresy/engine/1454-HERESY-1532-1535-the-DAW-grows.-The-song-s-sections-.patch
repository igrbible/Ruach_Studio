diff --git a/tools/console/app.css b/tools/console/app.css
index 531df61..d51e196 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -6375,3 +6375,20 @@ body.daw-full #dawPanel .mx-wave.mx-ruler { height: 22px; }
 .dv-master .dv-loud .mc-loud { min-width: 170px; }
 .dv-out-say { margin: 0; }
 body.daw-full #dawPanel.has-dock .mx-wave:not(.mx-ruler) { height: clamp(26px, calc((100vh - 170px - var(--mx-dock-h, 440px)) / var(--mx-lanes, 6) - 10px), 220px); }
+/* HERESY 1532: the song's sections under the ruler's time */
+.mx-ruler-row.has-secs .mx-wave.mx-ruler, body.daw-full #dawPanel .mx-ruler-row.has-secs .mx-wave.mx-ruler { height: 36px; }
+/* HERESY 1533: the mixes of a set, kept on Forge */
+.mm { display: flex; flex-direction: column; gap: 8px; max-width: 760px; }
+.mm-save { display: flex; gap: 6px; align-items: center; }
+.mm-name { flex: 1 1 auto; min-width: 0; }
+.mm-kept.is-bad { color: var(--bad, #e06c5a); }
+.mm-list { display: flex; flex-direction: column; gap: 4px; }
+.mm-row { display: flex; align-items: center; gap: 8px; }
+.mm-row .mc-chip { font-size: 12px; }
+/* HERESY 1534 (Viktor 17.10.2026, his picture of Audio I/O: «вот та красноватая рамочка - это ненужная обводка… УБери её отовсюду в таких
+   паттернах»): the glow's ring off inside a node's window, where the window is the frame, and off the DAW over the whole window */
+html[data-glow] .nd-body :is(.card, .drawer, .panel, .meta-card), html .nd-body :is(.card, .drawer, .panel, .meta-card) { box-shadow: none; }
+html[data-glow] body.daw-full #dawPanel { box-shadow: none; }
+/* HERESY 1535: a lane's volume drawn over time: «A» lit while its line is in hand, ringed when it has one */
+.mx-lane, .mx-ruler-row { grid-template-columns: minmax(530px, 550px) minmax(0, 1fr); }
+.mx-ms.mx-auto.has-auto:not(.is-on) { border-color: var(--amber); color: var(--amber); }
