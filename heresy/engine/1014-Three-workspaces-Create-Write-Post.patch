+/* ------------------------------------------------ HERESY 1014: three workspaces */
+.tabs { display: flex; gap: 2px; padding: 2px; margin-left: 18px; background: var(--sunk); border-radius: var(--r-md); }
+.tabs button { padding: 5px 16px; border: 0; border-radius: calc(var(--r-md) - 2px); background: none; color: var(--muted);
+  font: 500 13px/1.3 var(--sans); cursor: pointer; }
+.tabs button:hover { color: var(--ink); }
+.tabs button.is-active { background: var(--raise); color: var(--ink); box-shadow: 0 1px 2px var(--shadow-lg, rgba(0,0,0,.15)); }
+/* Write and Post take the place of the form and the take; the takes list stays */
+.write-col, .post-col { grid-column: 1 / span 2; }
+body[data-tab="write"] .col-grip.left, body[data-tab="post"] .col-grip.left { display: none; }
+.write-grid { display: grid; grid-template-columns: minmax(300px, 0.9fr) minmax(420px, 1.1fr); gap: 18px; align-items: start; }
+@media (max-width: 1300px) { .write-grid { grid-template-columns: minmax(0, 1fr); } }
+.write-current { position: sticky; top: 0; display: flex; flex-direction: column; gap: 10px; }
+.write-cur { display: flex; flex-direction: column; gap: 4px; }
+.write-cur p, .write-cur pre { margin: 0; font-size: 12.5px; color: var(--ink); }
+.write-cur pre { white-space: pre-wrap; max-height: 36vh; overflow: auto; font: 12.5px/1.55 var(--mono); }
+#curStyle { max-height: 22vh; }
+.post-tools { display: flex; gap: 8px; flex-wrap: wrap; }
