From: =?UTF-8?q?=D0=92=D0=B8=D0=BA=D1=82=D0=BE=D1=80=20=D0=96=D1=83=D1=80?=
 =?UTF-8?q?=D0=BE=D0=BC=D1=81=D0=BA=D0=B8=D0=B9?= <git@igrnt.info>
Date: Wed, 14 Oct 2026 19:50:53 -0600
Subject: [PATCH 1392/1399] HERESY 1435: the veil ten seconds, its logo never
 English first
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Viktor 14.10.2026: «Заставка загрузчика сначала грузит английское лого, а затем лого выбранного языка… удлинить 7 с на 10 с… проявку лого с сабтайтлом на 2-3 секунде… лоадбар пусть с нуля… при подхвате языка Студии проявить "ЗАГРУЗКА..."». The head's script lifted i18n-wait after 2.5 s whatever happened and the veil showed its English logo then. Now the line runs from nothing from the first moment, ten seconds long; «Loading…» and the versions show when the page's language is in; the logo and OSEM come in from 2.2 s, in that language (6 s whatever happens); the veil stays ten seconds, twenty at most.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/console/app.css    |  8 ++++++++
 tools/console/index.html | 15 ++++++++++++---
 2 files changed, 20 insertions(+), 3 deletions(-)

diff --git a/tools/console/app.css b/tools/console/app.css
index 98a1a2e..836d7fc 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -5641,3 +5641,11 @@ body:has(.ar-view) .hm-tip { z-index: 131; }
 /* HERESY 1434: a 💎 set or a frozen workspace in hand is there to look at: new takes do not land in it */
 #wsCurrent.is-closed { border-color: var(--amber-dim); }
 #wsCurrent.is-closed .ws-btn-name::after { content: " \00b7 \1F512"; color: var(--amber); }
+/* HERESY 1435 (Viktor 14.10.2026): the veil's line runs from the first moment, ten seconds long; «Loading…» and the versions when the
+   page's language is in (html.veil-lang); the logo and its OSEM line from 2.2 s, in that language (html.veil-logo) */
+html.booting .boot-veil > :is(.boot-logo, .boot-osem, .boot-words, .boot-ver) { opacity: 0; animation: none; }
+html.booting.veil-lang .boot-veil > :is(.boot-words, .boot-ver) { opacity: 1; animation: boot-in .9s ease both; }
+html.booting.veil-logo .boot-veil > .boot-logo { opacity: 1; animation: boot-in 1.2s ease both; }
+html.booting.veil-logo .boot-veil > .boot-osem { opacity: 1; animation: boot-in 1.2s .2s ease both; }
+html.i18n-wait .boot-veil > .boot-line { visibility: visible; }
+.boot-line i { animation-duration: 10s; }
diff --git a/tools/console/index.html b/tools/console/index.html
index 78ac290..1cdcbe7 100644
--- a/tools/console/index.html
+++ b/tools/console/index.html
@@ -39,7 +39,9 @@
 <!-- HERESY 1167 (Viktor 05.10.2026: «прятать весь сырой рендер DOM, оверлеем `Loading the Sound Heresy`, логотип Студии крупно...
      и даже на скором локальном соединении таймаут оверлея в 5 секунд»): the page builds under this veil. It lifts once the page
      stands ready and seven seconds have passed since the navigation (Viktor: «Давай 7. Это стоит того»); a click or a key lifts it sooner, once the page is ready;
-     seventeen seconds lift it whatever happens. The logo is the bar's own (copied in under the top bar, its words in the page's
+     seventeen seconds lift it whatever happens. HERESY 1435 (Viktor 14.10.2026: «удлинить 7 с на 10 с… проявку лого с сабтайтлом на
+     2-3 секунде… лоадбар пусть с нуля… при подхвате языка Студии проявить "ЗАГРУЗКА..."»): ten seconds, twenty at most; the line from
+     the first moment; the words when the language is in; the logo and OSEM from 2.2 s, in the page's language, never English first. The logo is the bar's own (copied in under the top bar, its words in the page's
      language once the translation runs). Not for a test browser (navigator.webdriver), ?scope=claude or ?noveil. -->
 <!-- HERESY 1167 (Viktor: «давай LOADING только в ночной моей всегда»): the veil wears the night theme whatever the page's -->
 <div class="boot-veil" id="bootVeil" role="status" data-theme="igr-night">
@@ -172,7 +174,9 @@ Blend · an add-on: two thirds Standard, one third Legacy"></select></label>
   try { window.RuachVeilVersions(); } catch (e) { /* the veil without its versions */ }
   // ready: the page parsed and its scripts run (not the load event: the web fonts may come late on a slow road), its room
   // set, the translation in
-  var MIN = 7000, MAX = 17000, gone = false;
+  var MIN = 10000, MAX = 20000, LOGO_AT = 2200, LANG_LATEST = 6000, gone = false;   // HERESY 1435
+  // the page's language in (heresy-i18n.js says it, the logo's words painted already): «Loading…» and the versions show
+  window.addEventListener("ruach-lang", function () { html.classList.add("veil-lang"); });
   function ready() { return document.readyState !== "loading" && !!document.body.dataset.tab && !html.classList.contains("i18n-wait"); }
   function lift() {
     if (gone) return;
@@ -182,7 +186,12 @@ Blend · an add-on: two thirds Standard, one third Legacy"></select></label>
     html.classList.add("veil-lift");
     setTimeout(function () { html.classList.remove("booting", "veil-lift"); var v = document.getElementById("bootVeil"); if (v) v.remove(); }, 520);
   }
-  (function tick() { var age = performance.now(); if (age >= MAX || (age >= MIN && ready())) lift(); else setTimeout(tick, 100); })();
+  (function tick() {
+    var age = performance.now();
+    if (age >= LANG_LATEST) html.classList.add("veil-lang");   // a translation that never came: the words as they are
+    if (age >= LOGO_AT && html.classList.contains("veil-lang")) html.classList.add("veil-logo");
+    if (age >= MAX || (age >= MIN && ready())) lift(); else setTimeout(tick, 100);
+  })();
   function sooner(event) {
     if (gone || !ready()) return;
     event.preventDefault(); event.stopPropagation();
-- 
