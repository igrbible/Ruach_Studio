diff --git a/tools/console/app.css b/tools/console/app.css
index d0b1e9e..443e6e4 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -3862,3 +3862,24 @@ body { transition: --bar-h .22s ease; }
   body[data-tab="create"] .k-vsplit.is-dragging::after { background: var(--amber); }
   body[data-tab="create"] .workspace.k-wide .compose { grid-template-columns: minmax(0, 1fr); }
 }
+
+/* HERESY 1167 (Viktor: «прятать весь сырой рендер DOM, оверлеем `Loading the Sound Heresy`, логотип Студии крупно»): the veil
+   over the page while it boots (index.html: on before the first paint, lifted by the script under the top bar). While the
+   translation holds the page (html.i18n-wait) only its ground shows, so no English flashes before the page's language. */
+.boot-veil { display: none; }
+html.booting { overflow: hidden; }
+html.booting .boot-veil {
+  position: fixed; inset: 0; z-index: 10000; visibility: visible;
+  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 30px; padding: 0 16px;
+  background: var(--ground); color: var(--ink); transition: opacity .5s ease;
+}
+html.booting.veil-lift .boot-veil { opacity: 0; pointer-events: none; }
+html.i18n-wait .boot-veil > * { visibility: hidden; }
+.boot-logo { width: min(86vw, 1100px); animation: boot-in 1.1s ease both; }
+.boot-mark { display: block; width: 100%; height: auto; overflow: visible; }
+.boot-words { margin: 18px 0 0; font: 500 clamp(13px, 1.15vw, 19px)/1.4 var(--heading); letter-spacing: .34em; text-transform: uppercase;
+  color: var(--muted); text-align: center; animation: boot-in 1.1s .25s ease both; }
+.boot-line { width: min(60vw, 420px); height: 2px; border-radius: 1px; background: var(--line-a); overflow: hidden; }
+.boot-line i { display: block; width: 0; height: 100%; background: var(--amber); animation: boot-fill 5s linear forwards; }
+@keyframes boot-in { from { opacity: 0; transform: translateY(8px); } }
+@keyframes boot-fill { to { width: 100%; } }
