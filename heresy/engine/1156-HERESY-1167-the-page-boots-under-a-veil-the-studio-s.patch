+<script>/* HERESY 1167: the bar's logo into the veil at once (its ids renamed, as the About card's copy), and the veil's lifting */
+(function () {
+  var html = document.documentElement;
+  if (!html.classList.contains("booting")) return;
+  try {
+    var svg = document.querySelector(".brand .brand-full"), spot = document.getElementById("bootLogo");
+    if (svg && spot && !spot.firstChild) {
+      var c = svg.cloneNode(true);
+      c.classList.remove("brand-full"); c.classList.add("boot-mark");
+      Array.prototype.forEach.call(c.querySelectorAll("[id]"), function (el) { el.id = el.id + "-boot"; });
+      Array.prototype.forEach.call(c.querySelectorAll("*"), function (el) {
+        Array.prototype.forEach.call(el.attributes, function (a) {
+          if (a.value.indexOf("#rl") >= 0) el.setAttribute(a.name, a.value.replace(/#(rl[A-Za-z]+)/g, "#$1-boot"));
+        });
+      });
+      spot.appendChild(c);
+    }
+  } catch (e) { /* the veil without its logo */ }
+  // ready: the page parsed and its scripts run (not the load event: the web fonts may come late on a slow road), its room
+  // set, the translation in
+  var MIN = 5000, MAX = 15000, gone = false;
+  function ready() { return document.readyState !== "loading" && !!document.body.dataset.tab && !html.classList.contains("i18n-wait"); }
+  function lift() {
+    if (gone) return;
+    gone = true;
+    window.removeEventListener("pointerdown", sooner, true);
+    window.removeEventListener("keydown", sooner, true);
+    html.classList.add("veil-lift");
+    setTimeout(function () { html.classList.remove("booting", "veil-lift"); var v = document.getElementById("bootVeil"); if (v) v.remove(); }, 520);
+  }
+  (function tick() { var age = performance.now(); if (age >= MAX || (age >= MIN && ready())) lift(); else setTimeout(tick, 100); })();
+  function sooner(event) {
+    if (gone || !ready()) return;
+    event.preventDefault(); event.stopPropagation();
+    lift();
+  }
+  window.addEventListener("pointerdown", sooner, true);
+  window.addEventListener("keydown", sooner, true);
+})();
+</script>
 
