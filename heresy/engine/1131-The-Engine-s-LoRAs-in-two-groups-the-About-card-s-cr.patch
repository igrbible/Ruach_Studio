    our Hugging Face repositories under Ruach Studio, a line's space below its credits */
-.about-head .about-logo { flex-direction: column; align-items: flex-start; gap: 2px; }
+.about-head .about-logo { flex-direction: column; align-items: flex-start; gap: 2px; flex-basis: 100%; }   /* Viktor: «После лого новая строка» */
