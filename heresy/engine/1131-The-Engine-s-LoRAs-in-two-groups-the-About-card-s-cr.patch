 .about-name { display: flex; flex-direction: column; font: 400 24px/1.1 var(--display); color: var(--ink); }
 .about-name b { color: var(--amber); font-weight: 400; }
 .about-name small { font: 400 12px/1.4 var(--sans); color: var(--muted); margin-top: 2px; }
