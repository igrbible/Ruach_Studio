     var d = state.data;
     $("trRaw").innerHTML = d.raw.length ? d.raw.map(function (r) {
       return '<button type="button" class="tr-pick' + (state.raw === r.name ? " is-on" : "") + '" data-raw="' + esc(r.name) + '"><b translate="no">' + esc(r.name) + "</b><span>" +   // HERESY 1166
