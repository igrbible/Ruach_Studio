 body[data-frame] :is(#view-compose, #view-take) { scrollbar-gutter: stable; }
+/* HERESY 1169 (Viktor 05.10.2026: «что определяет тип голоса? Мужской или женский, регистр? Нам не нужны Имена человеков, а
+   нужны именно их тональности»): the picked folder's voice, measured (lab/voice_kind.py), and a name for the set made of it */
+.tr-voice { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; padding: 8px 12px; border: 1px solid var(--line-a);
+  border-radius: var(--r-md); font-size: 13px; }
+.tr-voice[hidden] { display: none; }
+.tr-voice-cap { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
+.tr-voice-opts { display: inline-flex; gap: 4px; }
+.tr-voice .tr-chip { padding: 2px 9px; }
+.tr-voice .tr-chip.is-on { border-color: var(--amber); color: var(--amber); }
