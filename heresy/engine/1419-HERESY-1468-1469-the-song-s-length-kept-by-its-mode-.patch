diff --git a/tools/console/app.css b/tools/console/app.css
index 5d52f34..b8a679a 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -5821,6 +5821,16 @@ body:has(#view-engine:not(.is-hidden)) :is(.topbar, #playbar) { z-index: 37; }
 .lora-wave-len-in { width: 64px; height: 26px; padding: 2px 6px; font-size: 12px; text-align: center; cursor: text; }
 .lora-wave-edit .lora-wave-len span { white-space: nowrap; }
 .lora-wave-edit .lora-wave-len input.lora-wave-len-in { flex: none; width: 64px; min-width: 0; }   /* not the form's column-wide text field */
+/* HERESY 1468: Output's length beside «Song ≈», locked as the knobs are */
+.lora-wave-out { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--dim); }
+.lora-wave-edit .lora-wave-out span { white-space: nowrap; }
