+.lora-wave-out.is-locked input.lora-wave-out-in { color: var(--dim); cursor: default; }
+.lora-wave-lock { display: inline-flex; width: 16px; height: 16px; cursor: pointer; color: var(--dim); }
+.lora-wave-lock svg { width: 14px; height: 14px; }
+.lora-wave-out.is-locked .lora-wave-lock .shackle { transform: translateY(0); }
+.lora-wave-out:not(.is-locked) .lora-wave-lock { color: var(--amber); }
+.lora-wave-out:not(.is-locked) .lora-wave-lock .shackle { transform: translate(3px, -1px); }
