+.ar-left .ar-knobs > .field { flex: 1 1 auto; }
+.ar-left .ar-samp-row > .field { flex: 1 1 auto; }
+.ar-left .ar-samp-row select { width: 100%; min-width: max-content; }
+.ar-progress { flex: 1 1 100%; display: flex; flex-direction: column; gap: 4px; }
+.ar-progress[hidden] { display: none; }
+.ar-progress-bar { display: block; height: 6px; border-radius: 3px; background: var(--line-a); overflow: hidden; }
+.ar-progress-bar i { display: block; height: 100%; width: 0; background: var(--amber); transition: width .4s ease; }
+.ar-progress.is-waiting .ar-progress-bar i { background: repeating-linear-gradient(-45deg, var(--amber) 0 8px, transparent 8px 16px); background-size: 22px 22px; animation: ar-wait 1s linear infinite; opacity: .55; }
+@keyframes ar-wait { from { background-position: 0 0; } to { background-position: 22px 0; } }
+@media (prefers-reduced-motion: reduce) { .ar-progress.is-waiting .ar-progress-bar i { animation: none; } }
+.ar-progress em { font-style: normal; font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
