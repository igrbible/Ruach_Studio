+.hd-group { padding: 10px 10px 4px; font-size: 11px; letter-spacing: .09em; text-transform: uppercase; color: var(--muted); }
+.hd-check { cursor: pointer; }
+.hd-check input { margin: 0; width: 16px; height: 16px; flex: none; accent-color: var(--amber); }
+.hd-item-ico { display: inline-grid; place-items: center; width: 18px; flex: none; color: var(--muted); }
+.hd-item-ico svg { width: 16px; height: 16px; display: block; }
+.hd-check.is-on { background: color-mix(in srgb, var(--amber) 8%, transparent); }
+.hd-check.is-on .hd-item-ico { color: var(--amber); }
