       '" aria-label="Its picture">' + (guess ? "<i>\u2248</i>" : "") + "</button></td>";
   }
 
+  // HERESY 1166 (Viktor 04.10.2026: «гайд по инструментам полностью пересмотри и сверь с тем, что я одобрил + наши два набора
+  // LoRA — Дудук и Шофар»): an instrument our own adapter plays carries its A/B by epoch from the approved LoRA probes
+  // (ab-INSTRUMENT-base|eNNN-a|b in a 💎 workspace): the engine alone first, then each epoch
+  function loraHtml(i) {
+    var ad = (DATA.adapters || []).filter(function (a) { return a.instrument === i.slug; })[0];
+    if (!ad) return "";
+    var by = {};
+    state.rows.forEach(function (r) {
+      var m = /^ab-([a-z]+)-(base|e\d+)-([ab])$/.exec(String(r.name || "").replace(/^\d{8}-\d{6}-/, ""));
+      if (!m || m[1] !== i.slug || !r.workspaces.some(function (w) { return /^\s*\uD83D\uDC8E/.test(w); })) return;
+      var e = by[m[2]] || (by[m[2]] = {});
+      if (!e[m[3]] || r.name > e[m[3]].name) e[m[3]] = r;
+    });
+    var keys = Object.keys(by).sort(function (a, b) { return a === "base" ? -1 : b === "base" ? 1 : +a.slice(1) - +b.slice(1); });
+    if (!keys.length) return "";
+    return '<div class="hi-lora"><div class="hi-lora-head"><span>With the studio\'s LoRA</span> <span translate="no">' + esc(ad.lora.split(",")[0]) + "</span></div>" +
+      keys.map(function (k) {
+        return '<div class="hi-lora-epoch"><span class="hi-lora-k">' + (k === "base" ? "<span>no adapter</span>" : '<span translate="no">' + esc(k) + "</span>") + "</span>" +
+          playsHtml(by[k]) + "</div>";
+      }).join("") + "</div>";
+  }
   function rowHtml(i) {
     var p = probes(i.slug), st = status(i), his = hisNote(p);
     // HERESY 1162 (Viktor: «если не находишь им пару — помечай сразу как не идентифицированные, но оставляй обычным текстом
@@ -144,7 +165,8 @@
       '<td class="hi-say"><div translate="no">' + esc(i.en) + '</div><div class="hi-ru">' + esc(i.ru) + "</div>" +
       (his ? '<div class="hi-his">\u201c' + esc(his) + "\u201d</div>" : "") +
       // HERESY 1148 (Viktor): the shofar's probes are kept and listed with the prompt they were made with
-      (i.prompt ? '<button type="button" class="hi-prompt" data-hi-tag="' + esc(i.prompt) + '" data-tip="The prompt both probes were made with: into the Style prompt">' + esc(i.prompt) + "</button>" : "") + "</td>" +
+      (i.prompt ? '<button type="button" class="hi-prompt" data-hi-tag="' + esc(i.prompt) + '" data-tip="The prompt both probes were made with: into the Style prompt">' + esc(i.prompt) + "</button>" : "") +
+      loraHtml(i) + "</td>" +                       // HERESY 1166: its adapter's A/B by epoch
       '<td class="hi-plays">' + play + "</td></tr>";
   }
 
