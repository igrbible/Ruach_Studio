diff --git a/tools/console/app.css b/tools/console/app.css
index 2989238..e643b2b 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -2562,6 +2562,12 @@ body.coll-dragging .coll-peek { display: none; }
 .coll-card.is-frozen { filter: grayscale(.85); opacity: .62; }
 .coll-card.is-frozen .coll-check, .coll-card.is-frozen .coll-ren, .coll-card.is-frozen .coll-acts { pointer-events: none; }
 .coll-card.is-frozen:hover { opacity: .8; }
+/* HERESY 1166: an instrument's own LoRA, its A/B by epoch under what the sheet says of it */
+.hi-lora { margin-top: 10px; padding-top: 8px; border-top: 1px dashed var(--line-soft); display: flex; flex-direction: column; gap: 6px; }
+.hi-lora-head { font: 600 10.5px/1.3 var(--sans); letter-spacing: .06em; text-transform: uppercase; color: var(--dim); }
+.hi-lora-epoch { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
+.hi-lora-k { min-width: 74px; font: 12px var(--mono); color: var(--muted); }
+.hi-lora-epoch .hi-ab { display: inline-flex; align-items: center; gap: 6px; }
 .hub-box { width: min(640px, 100%); }
 .hub-list { display: flex; flex-direction: column; gap: 8px; max-height: min(60vh, 520px); overflow: auto; }
 .hub-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 3px 14px; padding: 10px 12px;
