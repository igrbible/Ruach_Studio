Date: Thu, 15 Oct 2026 12:23:15 -0600
Subject: [PATCH 1408/1463] HERESY 1455: the guide as the Engine: 1800 px at
 most, its parts in a column at the left, the open part's stops under its tab
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Viktor 15.10.2026: «Engine красиво получился. То же самое можно сделать и с F1 гайдом, макс 1800px по ширине». The box min(1800 px, the window) by 94 vh (no 1080 px ceiling); the parts as the Engine's tabs in a column at the left (.hg-side), the open part's stops right under its own tab, the text beside them; narrow, the parts a row on top as before. Kitchen suite 813/0.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/console/app.css         | 25 +++++++++++++++++++++++++
 tools/console/heresy-guide.js | 12 +++++++++---
 2 files changed, 34 insertions(+), 3 deletions(-)

diff --git a/tools/console/app.css b/tools/console/app.css
index 5d9c428..afe3544 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -5769,3 +5769,28 @@ body:has(#view-engine:not(.is-hidden)) :is(.topbar, #playbar) { z-index: 37; }
 .lora-row.is-ordered, .lora-row.is-ordered:active { cursor: auto; }
 .lora-row.is-ordered > .lora-who { cursor: grab; }
 .lora-row.is-ordered > .lora-who:active { cursor: grabbing; }
+
+/* HERESY 1455 (Viktor 15.10.2026: «Engine красиво получился. То же самое можно сделать и с F1 гайдом, макс 1800px по ширине»): the
+   guide as the Engine: 1800 px wide at most and 94 % of the window's height (no 1080 px ceiling now), its parts as tabs in a column
+   at the left (the Engine's look), the open part's stops under its own tab, the text beside them in the rest of the width */
+.hg-box { width: min(1800px, 100%); height: 94vh; grid-template-rows: auto minmax(0, 1fr); }
+.hg-main { grid-template-columns: 270px minmax(0, 1fr); border-top: 1px solid var(--line-a); }
+.hg-side { min-height: 0; overflow-y: auto; padding: 14px 10px; background: var(--panel); border-right: 1px solid var(--line-a); }
+.hg-tabs { flex-direction: column; flex-wrap: nowrap; gap: 3px; padding: 0; border-bottom: 0; }
+.hg-tabs button { display: block; width: 100%; padding: 8px 12px; text-align: left; border: 1px solid transparent; border-radius: var(--r-sm); background: none;
+  color: var(--muted); font: 500 calc(13.5px + var(--fs, 0px))/1.3 var(--heading); }
+.hg-tabs button:hover { color: var(--ink); border-color: transparent; background: color-mix(in srgb, var(--amber) 8%, transparent); }
+.hg-tabs button.is-on { color: var(--amber); background: color-mix(in srgb, var(--amber) 12%, transparent);
+  border-color: color-mix(in srgb, var(--amber) 40%, transparent); box-shadow: inset 3px 0 0 var(--amber); }
+.hg-tabs .hg-stops { display: flex; flex-direction: column; gap: 1px; margin: 4px 0 8px 14px; padding: 2px 0 2px 8px; overflow: visible;
+  border-right: 0; border-left: 1px solid var(--line-soft, var(--line)); }
+.hg-tabs .hg-stops button { padding: 4px 8px; border: 0; box-shadow: none; color: var(--muted); font: calc(12.5px + var(--fs, 0px))/1.35 var(--sans); }
+.hg-tabs .hg-stops button:hover { background: var(--hover); color: var(--ink); }
+.hg-body { padding: 14px 34px 48px; }
+@media (max-width: 900px) {
+  .hg-main { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr); }
+  .hg-side { padding: 8px; overflow-x: auto; overflow-y: hidden; border-right: 0; border-bottom: 1px solid var(--line-a); }
+  .hg-tabs { flex-direction: row; }
+  .hg-tabs button { width: auto; white-space: nowrap; }
+  .hg-tabs .hg-stops { display: none; }
+}
diff --git a/tools/console/heresy-guide.js b/tools/console/heresy-guide.js
index 2ba0e59..8288527 100644
--- a/tools/console/heresy-guide.js
+++ b/tools/console/heresy-guide.js
@@ -124,7 +124,10 @@
       '<button type="button" class="btn ghost small icon-btn" data-hg-z="0" aria-label="The text as it starts" data-tip="The text as it starts">' + ico("text-reset") + "</button></span>" +
       '<button type="button" class="btn ghost small icon-btn hg-full"></button>' +
       '<button type="button" class="btn ghost small icon-btn hg-close" aria-label="Close the guide" data-tip="Close the guide (Esc, F1)">' + ico("x") + "</button></span></header>" +
-      '<nav class="hg-tabs" role="tablist"></nav><div class="hg-main"><nav class="hg-stops" aria-label="In this part"></nav><article class="hg-body" translate="no"></article></div></div>' +
+      // HERESY 1455 (Viktor 15.10.2026: «То же самое можно сделать и с F1 гайдом»): the parts in a column at the left, as the Engine's tabs,
+      // the open part's stops under its own tab; the text beside them
+      '<div class="hg-main"><nav class="hg-side" aria-label="The Guide"><div class="hg-tabs" role="tablist" aria-orientation="vertical"></div></nav>' +
+      '<article class="hg-body" translate="no"></article></div></div>' +
       '<div class="hg-zoom" hidden><img alt="" /></div>';
     document.body.appendChild(el);
     el.addEventListener("click", function (e) {
@@ -156,9 +159,12 @@
     el.querySelector(".hg-title").textContent = state.title;
     el.querySelector(".hg-lead").textContent = state.lead.replace(/[*_`]/g, "").split("\n")[0];
     el.querySelector(".hg-tabs").innerHTML = state.tabs.map(function (t) {
-      return '<button type="button" role="tab" translate="no" data-hg-tab="' + esc(t.id) + '" class="' + (t === tab ? "is-on" : "") + '" aria-selected="' + (t === tab) + '">' + inline(t.name) + "</button>";
+      return '<button type="button" role="tab" translate="no" data-hg-tab="' + esc(t.id) + '" class="' + (t === tab ? "is-on" : "") + '" aria-selected="' + (t === tab) + '">' + inline(t.name) + "</button>" +
+        (t === tab && t.stops.length ? '<div class="hg-stops" role="group" aria-label="In this part">' +   // HERESY 1455: under its own tab
+          t.stops.map(function (s) { return '<button type="button" translate="no" data-hg-stop="' + esc(s.id) + '">' + inline(s.text) + "</button>"; }).join("") + "</div>" : "");
     }).join("");
-    el.querySelector(".hg-stops").innerHTML = tab.stops.map(function (s) { return '<button type="button" translate="no" data-hg-stop="' + esc(s.id) + '">' + inline(s.text) + "</button>"; }).join("");
+    var onTab = el.querySelector(".hg-tabs .is-on");
+    if (onTab && onTab.scrollIntoView) onTab.scrollIntoView({ block: "nearest" });
     var body = el.querySelector(".hg-body");
     body.innerHTML = '<div class="hg-doc">' + tab.html + "</div>";   // HERESY 1169 · 1250: the text's own zoom, the scroll box stays
     body.scrollTop = 0;
