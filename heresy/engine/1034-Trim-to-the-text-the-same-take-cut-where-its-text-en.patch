Date: Thu, 1 Oct 2026 01:09:41 -0600
Subject: [PATCH 1034/1259] Trim to the text: the same take, cut where its text
 ends

A button in the take card (Make again). The lab hears the take with Whisper (the freest GPU,
or the CPU) and finds where its text ends: each line, or sentence of a long line, looked for in
order after the one before, its FIRST confident hearing counting, so a model that runs past the
text and reads its last lines again does not move the end. The take is then rendered again from
its own music codes cut there + 1.5 s: the same performance without the returns and babble after
the last line; only the sound stage runs. Measured on a four-language reading: 4:09 -> 2:30.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/console/app.js       |  30 ++++++++++++++++++++++++++++++
 tools/console/index.html   |   1 +
 tools/public/index.html.gz | Bin 299076 -> 299699 bytes
 3 files changed, 31 insertions(+)

diff --git a/tools/console/app.js b/tools/console/app.js
index 94e352c..755c86b 100644
--- a/tools/console/app.js
+++ b/tools/console/app.js
@@ -3106,6 +3106,36 @@
   });
 
 
+  // HERESY 1034: the same take, cut where its text ends (lab/textend_job.py finds the place)
+  $("trimToText").addEventListener("click", function () {
+    var take = STATE.take, button = this;
+    if (!take) return;
+    button.disabled = true;
+    var started = Date.now(), ask = function () {
+      return fetch("/lab/textend?name=" + encodeURIComponent(take.name)).then(function (r) {
+        return r.json().then(function (b) {
+          if (r.status === 202) {
+            button.textContent = "Listening\u2026 " + Math.round((Date.now() - started) / 1000) + " s";
+            return new Promise(function (res) { setTimeout(res, 2500); }).then(ask);
+          }
+          if (!r.ok) throw new Error(b.error || r.status);
+          return b;
+        });
+      });
+    };
+    ask().then(function (r) {
+      if (!r.text_end) throw new Error("No line of the text was heard in this take");
+      if (r.keep_frames >= r.frames_total - 25) return toast("The text runs to the end (" + clock(r.text_end) + " of " + clock(r.seconds) + "): nothing to trim");
+      if (!confirm("The text ends at " + clock(r.text_end) + " of " + clock(r.seconds) + " (" + r.heard + " of " + r.units +
+                   " lines heard in order).\n\nRender this take again, cut at " + clock(r.keep_seconds) + "? The same performance; only the sound stage runs.")) return;
+      return getRequest(take).then(function (req) {
+        var toks = String(req.semantic_tokens || "").split(",").filter(function (t) { return t.trim(); });
+        return replayTake(take, { semantic_tokens: toks.slice(0, r.keep_frames).join(","), duration: r.keep_frames / FRAME_RATE }, "Trimmed to the text");
+      }).then(function () { toast("Rendering " + displayTitle(take) + " cut at " + clock(r.keep_seconds) + "\u2026"); });
+    }).catch(function (error) { toast(error.message, "bad"); })
+      .then(function () { button.disabled = false; button.textContent = "Trim to the text"; });
+  });
+
   $("takeActions").addEventListener("click", function (event) {
     var take = STATE.take;
     if (!take) return;
