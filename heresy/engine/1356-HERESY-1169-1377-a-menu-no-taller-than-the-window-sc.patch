Viktor 11.10.2026: «У нас уже миллион пространств в Студии. В контекстном меню нужна прокрутка». Suite: suite-1377.part.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/console/app.css        | 3 +++
 tools/console/heresy-menu.js | 8 ++++++++
 2 files changed, 11 insertions(+)

diff --git a/tools/console/app.css b/tools/console/app.css
index a08771e..2f5b09a 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -5379,3 +5379,6 @@ body:has(.ar-view) .hm-tip { z-index: 131; }
   color: #e8d5a0; font: 12px "IBM Plex Mono", monospace; pointer-events: none; }
 .ws-say:empty { display: none; }
 .ws-say.is-bad { color: #ff8a78; }
+/* HERESY 1169 · 1377 (Viktor 11.10.2026: «миллион пространств… В контекстном меню нужна прокрутка»): a menu no taller than the window,
+   scrolled inside itself (heresy-menu.js places it within the window and closes its submenu as it scrolls) */
+.hm-menu { max-height: calc(100vh - 12px); overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
diff --git a/tools/console/heresy-menu.js b/tools/console/heresy-menu.js
index 4bc8151..a17f4d2 100644
--- a/tools/console/heresy-menu.js
+++ b/tools/console/heresy-menu.js
@@ -89,6 +89,9 @@
     trim(parent.level);
     var sub = build(it.items, parent.level + 1), r = button.getBoundingClientRect();
     stack.push(sub);
+    // HERESY 1377: a long list (the workspaces) opens with its ticked row in sight
+    var tick = sub.el.querySelector('.hm-item[aria-checked="true"]');
+    if (tick && sub.el.scrollHeight > sub.el.clientHeight) sub.el.scrollTop = Math.max(0, tick.offsetTop - sub.el.clientHeight / 2);
     place(sub.el, r.right - 2, r.top - 5, r.left + 2);
     button.setAttribute("aria-expanded", "true");
     return sub;
@@ -134,6 +137,11 @@
   // tips do; the server log following its new lines scrolls itself every moment and took the menu away
   document.addEventListener("scroll", function (e) {
     var box = e.target;
+    if (root && box.classList && box.classList.contains("hm-menu")) {      // HERESY 1377: a menu scrolled: its open submenu goes
+      var at = stack.map(function (m) { return m.el; }).indexOf(box);
+      if (at >= 0) trim(at);
+      return;
+    }
     if (!root || (box.closest && box.closest(".hm-menu"))) return;
     if (box === document || box === document.documentElement || box === document.body || !anchor || (box.contains && box.contains(anchor))) close();
   }, true);
