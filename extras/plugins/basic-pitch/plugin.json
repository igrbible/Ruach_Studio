{
  "id": "basic-pitch",
  "name": "Basic Pitch",
  "python": ".venv/bin/python",
  "steps": [
    {
      "id": "transcribe",
      "label": "To MIDI",
      "say": "notes from each stem",
      "tip": "Transcribes every stem of the take to MIDI with Spotify's Basic Pitch. Run a stem split first; the result is one .mid per stem plus a report.",
      "script": "transcribe.py",
      "input": "stems",
      "group": "look",
      "params": [
        {"key": "onset", "label": "Onset threshold", "type": "number", "min": 0.1, "max": 0.9, "step": 0.05, "default": 0.5,
         "tip": "Higher means fewer, surer notes"},
        {"key": "frame", "label": "Frame threshold", "type": "number", "min": 0.1, "max": 0.9, "step": 0.05, "default": 0.3,
         "tip": "Higher means shorter, tidier notes"},
        {"key": "min_note_ms", "label": "Shortest note, ms", "type": "number", "min": 20, "max": 500, "step": 10, "default": 127,
         "tip": "Notes shorter than this are dropped"},
        {"key": "bends", "label": "Pitch bends", "type": "check", "default": true,
         "tip": "Keep pitch-bend messages in the MIDI"}
      ]
    }
  ]
}
