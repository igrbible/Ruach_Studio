 "tag_re": "\\[[^\\[\\]\\n]{1,160}\\]",
 "tags": {
  "open": "[", "close": "]", "form": "bare",
  "groups": [
   {"id": "emotion", "cat": "emotion", "place": "sentence", "items": ["calm", "tender", "sad", "angry", "scared", "surprised", "contemplative", "in awe", "determined", "amused", "bitter", "longing", "proud", "relieved", "enthusiastic"]},
   {"id": "prosody", "cat": "prosody", "place": "sentence", "items": ["slowly", "fast", "very expressive", "low voice"]},
   {"id": "pause", "cat": "prosody", "place": "inline", "items": ["pause", "long pause"]},
   {"id": "style", "cat": "style", "place": "sentence", "items": ["whispering", "shouting"]},
   {"id": "sfx", "cat": "sfx", "place": "inline", "items": ["sighs", "laughs", "crying", "humming"]}
  ]
 },
 "style": {"kind": "bracket", "max": 160, "ph": "calm, warm, unhurried narration"},
