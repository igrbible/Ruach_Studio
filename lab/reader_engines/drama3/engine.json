{
 "id": "drama3",
 "label": "Fish Audio Drama 3",
 "module": "engine.py",
 "python": {"cuda": ".venv/bin/python", "xpu": ".venv/bin/python", "cpu": ".venv/bin/python"},
 "need_mb": 7400,
 "sample_rate": 44100,
 "max_chars": 300,
