{
  "id": "/",
  "name": "Ruach Studio",
  "short_name": "Ruach Studio",
  "description": "A music studio on YuE2, on your own machine.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#14110e",
  "theme_color": "#14110e",
  "launch_handler": { "client_mode": "focus-existing" },
