# Ruach Studio · what never goes public (Viktor, 01.10.2026)
# The folders stay in the tree, empty, each with a .gitkeep, so the layout reads the same after a clone.
# The scripts fill them: download-models.sh, lab/install-venv.sh, heresy/fetch-heresy.sh, kit/install.sh.

# ---- the user's work: songs, readings, notes, the trash
/outputs/*
!/outputs/.gitkeep
/trash/*
!/trash/.gitkeep
/artist/*
!/artist/.gitkeep
/writer/*
!/writer/.gitkeep
/writer-*/

# ---- weights, downloaded or converted on the machine (tens of GB)
/models/*
!/models/.gitkeep
# HERESY 1290 (Viktor: «checkpoints/, по сути, это артефакт YuE2-Kit репо… Если checkpoints останется пустым, тогда его в
# gitignore»): no install fetches checkpoints any more; what lands there is fetched later on purpose (the listener, the
# trainer's base) or brought by hand
/checkpoints/
# the downloader's own notes beside files it puts in place (heresy/fetch-heresy.sh: models/, sliders/)
/.cache/
/whisper/*
!/whisper/.gitkeep
/separation/*
!/separation/.gitkeep
/hf_cache/*
!/hf_cache/.gitkeep
/sliders/*.gguf
/loras/*
!/loras/.gitkeep
!/loras/sources.json

# ---- trees with histories of their own: made again by the install (upstream and the Kit as
# released, build/ = upstream + the Kit's patches + heresy/engine), or clones fetched by
# heresy/fetch-heresy.sh (vendor/)
/upstream/
/kit/
/build/build/
/build/tools/public/index.html
/vendor/*
!/vendor/.gitkeep

# ---- this machine only
/tmp/*
!/tmp/.gitkeep
/install-record/
/settings.json
/start.sh.orig
/.venv/
/.venv-art/
/lab/.venv/
/lab/cache/
/lab/*.part
**/__pycache__/
*.pyc
*.log
*.part
*.bak
.DS_Store
# HERESY 1285: what Pinokio writes beside its scripts (its logs, its environment, the notes it leaves for agents)
/pinokio/logs/
/pinokio/ENVIRONMENT
/pinokio/*.md
/pinokio/.clinerules
/pinokio/.cursorrules
/pinokio/.geminiignore
/pinokio/.windsurfrules

# ---- the user's settings (single-user studio: they live here, not in ~/.config)
/user/*
!/user/.gitkeep

# ---- training sets (HERESY 1100): the user's songs and the big downloads stay home; only the two starter
# samples travel with the code (GTSinger, CC BY-NC-SA 4.0; the full sets: the trainer's Starter sets button)
/datasets/src/*
!/datasets/src/.gitkeep
/datasets/prepared/*
!/datasets/prepared/.gitkeep
/datasets/raw/*
!/datasets/raw/.gitkeep
!/datasets/raw/GTSinger-RU-sample/
!/datasets/raw/GTSinger-EN-sample/

# ---- what the studio makes on the machine beside the shipped folders
/artwork/*
!/artwork/.gitkeep
/datasets/*
!/datasets/.gitkeep
/training/*
!/training/.gitkeep
/artist/*
!/artist/.gitkeep
/VERSION.local
# HERESY 1285: the links the extras' conversion makes in build/ (the Kit's layout)
/build/checkpoints
/build/models
